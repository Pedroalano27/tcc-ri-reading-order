def automatico(p):
    return {"page_id": p["page_id"], "dimensions": dict(p["dimensions"]),
            "bounding_boxes": [{k: u[k] for k in ("id", "bbox", "ks", "text", "tipo")}
                               for u in p["bounding_boxes"]]}


def medir(obj, p, ordem):
    """Regua importada integralmente; nenhuma escrita em caches da bancada."""
    ids = b.auditar_unidades(p, obj)
    exigir(isinstance(ordem, list) and len(ordem) == len(ids) and set(ordem) == set(ids), "Ordem invalida")
    exp = b.expansoes(obj, p)
    seq = [k for uid in ordem for k in exp[uid]]
    q = b.referencia(obj, p)
    med = e.medir(q, seq, [], {}, "P0")
    res = {k: med[k] for k in METRICAS if k != "piso_interno"}
    res["piso_interno"] = sum(len(e.eventos(ks, q["gt_w"])) for ks in exp.values())
    exigir(res["piso_interno"] <= res["quebras"], "Piso excede quebras")
    return res, seq, q, exp


def ancoras():
    """Reexecuta regra/P2 congelado; P1m e controle historico explicitamente."""
    if ESTADO.get("ancoras", {}).get("aprovada"):
        return
    historico = ler(e.JSON)
    antigos = {r["page_id"]: {m: {k: r["metodos"][m][k] for k in ("tau", "quebras", "seq")}
                             for m in ("P2", "P1m")}
               for r in historico["paginas"] if r["coorte"] == "v4"}
    del historico
    rows = []
    for obj, p in paginas("golden_v4"):
        vigiar()
        pid = p["page_id"]
        cp = DIR_EXEC / "ancoras" / (e.ac.chave(pid) + ".json")
        if cp.exists():
            row = ler(cp)
        else:
            auto = automatico(p)
            ordem, _ = b.prever(auto, obj["palavras"], "regra_colunas")
            med, seq, q, _ = medir(obj, p, ordem)
            q["ls3"] = ler(UNIDADES / "cache/detector" / (e.ac.chave(pid) + ".json"))["regioes"]
            q["d"] = {"detector": {"regioes": []}}
            seq_p2, its, diag = e.ls.prever(q, e.FIXA, "ls3")
            mp2 = e.medir(q, seq_p2, its, diag, "P0")
            exigir(pid in antigos, "Pagina da ancora sem historico")
            exigir(seq == seq_p2 == antigos[pid]["P2"]["seq"], f"Sequencia da ancora diverge: {pid}")
            row = {"page_id": pid, "uf": obj["uf"],
                   "regra": {k: med[k] for k in ("tau", "quebras")},
                   "P2": {k: mp2[k] for k in ("tau", "quebras")},
                   "P1m_historico": {k: antigos[pid]["P1m"][k] for k in ("tau", "quebras")}}
            gravar(cp, row)
        rows.append(row)
        ESTADO["ancoras"] = {"aprovada": False, "paginas": rows, "concluidas": len(rows)}
        salvar()
        print(f"Ancoras: {len(rows)}/44", flush=True)
    exigir(len(rows) == 44 and {r["page_id"] for r in rows} == set(antigos), "Coorte da ancora mudou")
    medias = {m: {k: statistics.mean(r[m][k] for r in rows) for k in ("tau", "quebras")}
              for m in ("regra", "P2", "P1m_historico")}
    ESTADO["ancoras"].update(medias=medias)
    for nome, tau, qb in (("regra", .985948, 6.045455), ("P2", .985948, 6.045455),
                          ("P1m_historico", .952424, 8.931818)):
        exigir(abs(medias[nome]["tau"] - tau) <= .006 and
               abs(medias[nome]["quebras"] - qb) <= .0051, f"Ancora {nome} nao reproduzida: {medias[nome]}")
    ESTADO["ancoras"]["aprovada"] = True
    salvar()


def cx(u):
    return (u["bbox"][0] + u["bbox"][2]) / 2


def cy(u):
    return (u["bbox"][1] + u["bbox"][3]) / 2


def tipo_unidade(u):
    t = u["tipo"]
    return "tabela" if t in ("table", "tabela") else "imagem" if t in ("picture", "imagem", "figura") else "texto"


def contexto(p, ws):
    """Somente campos automaticos; jamais recebe ranks ou ordens de referencia."""
    auto = automatico(p)
    cs = auto["bounding_boxes"]
    ordem, diag = b.prever(auto, ws, "regra_colunas")
    exp = {u["id"]: e.o.fluxo([u], ws) for u in cs}
    alturas = [w[4] - w[2] for w in ws if w[4] > w[2]]
    exigir(alturas, "Pagina sem alturas de palavra positivas")
    h = statistics.median(alturas)
    ini, corpo, marcas, fim = e.j.particao(cs, ws, auto["dimensions"]["height"], "geo")
    cortes = e.o.vales_locais(cs, corpo, h, e.FIXA.vale) if corpo else []
    if not cortes and corpo:
        cortes = e.o.vales(cs, corpo, h, e.FIXA.vale)
    largura = max(u["bbox"][2] for u in cs) - min(u["bbox"][0] for u in cs)
    margem = {cs[i]["id"]: t for ids, t in ((ini, "topo"), (fim, "rodape"), (marcas, "marca")) for i in ids}
    cols = {u["id"]: bisect.bisect_right(cortes, cx(u)) for u in cs}
    pontes = {u["id"] for u in cs if any(u["bbox"][0] < c < u["bbox"][2] and
              min(c-u["bbox"][0], u["bbox"][2]-c) >= .10*largura for c in cortes)}
    mapa = {u["id"]: u for u in cs}
    grupos = {col: sorted((u["id"] for u in cs if cols[u["id"]] == col and
                          u["id"] not in pontes and u["id"] not in margem),
                         key=lambda uid: (mapa[uid]["bbox"][1], mapa[uid]["bbox"][0]))
              for col in range(len(cortes)+1)}
    pos = {uid: i / max(1, len(g)-1) for g in grupos.values() for i, uid in enumerate(g)}
    return {"auto": auto, "cs": cs, "mapa": {u["id"]: u for u in cs}, "ws": ws, "h": h,
            "ordem": ordem, "regra": dict(zip(ordem, ordem[1:] + [None])), "diag": diag,
            "exp": exp, "col": cols, "cortes": cortes, "pontes": pontes, "margem": margem,
            "grupos": grupos, "pos": pos, "rank_regra": {uid: i for i, uid in enumerate(ordem)},
            "entrada": [cs[i]["id"] for i in ordem_entrada(auto)],
            "objetos": [u for u in cs if tipo_unidade(u) != "texto" or u["id"] in pontes]}


def sobreposicao(a, z):
    ba, bz = a["bbox"], z["bbox"]
    med, seq, q, exp = medir(obj, p, ctx["ordem"])
    dono = {k: uid for uid, ks in exp.items() for k in ks}
    ranks = {k: i for i, k in enumerate(seq)}
    ls = {L["id"]: L for L in q["gold_lines"]}
    intactas = {lid: all(ranks[z] == ranks[a]+1 for a, z in zip(L["ks"], L["ks"][1:])) for lid, L in ls.items()}
    trs = []
    for la, lz in zip(q["gt_l"], q["gt_l"][1:]):
        ka, kz = ls[la]["ks"][-1], ls[lz]["ks"][0]
        ua, uz = dono[ka], dono[kz]
        interno = ua == uz
        alcancavel = (ranks[kz] == ranks[ka]+1) if interno else exp[ua][-1] == ka and exp[uz][0] == kz
        bbox_a = e.o.envelope([obj["palavras"][k][1:5] for k in ls[la]["ks"]])
        bbox_z = e.o.envelope([obj["palavras"][k][1:5] for k in ls[lz]["ks"]])
        trs.append({"linha_a": la, "linha_z": lz, "palavra_a": ka, "palavra_z": kz,
                    "a": ua, "z": uz, "interno": interno, "alcancavel": alcancavel,
                    "tipo": categoria(ctx, ua, uz, bbox_a=bbox_a, bbox_z=bbox_z),
                    "acerto": intactas[la] and intactas[lz] and ranks[kz] == ranks[ka]+1})
    # A anotacao de cada transicao apenas decompoe a metrica oficial importada.
    if trs:
        exigir(abs(sum(t["acerto"] for t in trs)/len(trs) - med["sucessor_linhas"]) < 1e-12,
               "Diagnostico de linhas diverge da regua oficial")
    ev = e.eventos(seq, q["gt_w"])
    cont = {t: {"ouro": 0, "acertos": 0, "erros": 0, "quebras_palavra": 0,
                "internas": 0, "transicoes_internas": 0, "inalcancaveis": 0} for t in TIPOS}
    for t in trs:
        r = cont[t["tipo"]]
        r["ouro"] += 1
        r["acertos"] += int(t["acerto"])
        r["erros"] += int(not t["acerto"])
        r["transicoes_internas"] += int(t["interno"])
        r["inalcancaveis"] += int(not t["alcancavel"])
    for evn in ev:
        z = dono.get(evn["esperado"])
        cat = categoria(ctx, dono[evn["a"]], z)
        cont[cat]["quebras_palavra"] += 1
        cont[cat]["internas"] += int(dono[evn["a"]] == dono[evn["b"]])
    exigir(sum(r["quebras_palavra"] for r in cont.values()) == med["quebras"], "Quebras nao particionadas")
    exemplos = [{**t, "texto_a": " ".join(obj["palavras"][k][0] for k in ls[t["linha_a"]]["ks"][-6:]),
                 "texto_z": " ".join(obj["palavras"][k][0] for k in ls[t["linha_z"]]["ks"][:6])}
                for t in trs if not t["acerto"]][:12]
    return med, cont, trs, exemplos


def metadados(p):
    """Somente teto consulta ordens/ranks. Os demais recebem campos automaticos."""
    cs = [{k: u[k] for k in ("id", "bbox", "ks", "text", "tipo")} for u in p["bounding_boxes"]]
    auto = {"page_id": p["page_id"], "dimensions": p["dimensions"], "bounding_boxes": cs}
    ent = ordem_entrada(auto)
    ids = [u["id"] for u in cs]
    diag = {"unidades": len(cs), "entrada": [ids[i] for i in ent]}
    t = time.perf_counter()
    if metodo == "teto":
        ordem = list(p["ordens"]["stream"])
    elif metodo == "ingenuo":
        ordem = [ids[i] for i in sorted(ent, key=lambda i: (cs[i]["bbox"][1], cs[i]["bbox"][0]))]
    elif metodo == "xycut":
        ordem = [ids[i] for i in xycut(ent, caixas(auto))]
    elif metodo == "xycut_margens":
        ordem = xycut_margens(auto)
    elif metodo == "regra_colunas":
        h = statistics.median(w[4] - w[2] for w in ws)
        ini, corpo, marcas, fim = e.j.particao(cs, ws, p["dimensions"]["height"], "geo")
        corpo_set = set(corpo)
        diag.update(max_colunas=1, pontes=0, topo=len(ini), rodape=len(fim), marcas=len(marcas))
        oc = e.o.ordenar_projecao(cs, [i for i in ent if i in corpo_set], h, e.FIXA.vale, diag, local=True)
        chave = lambda i: (cs[i]["bbox"][1], cs[i]["bbox"][0], i)
        ordem = [ids[i] for i in sorted(ini, key=chave) + oc + sorted(marcas, key=chave) + sorted(fim, key=chave)]
    elif metodo == "layoutreader_pronto":
        exigir(lr is not None, "LayoutReader nao carregado")
        # direto() do adaptador embaralha a lista canonica com entrada-page_id.
        # Evita duas permutacoes: esta chamada deve receber indices canonicos.
        ordem_i = lr.ordenar(cs, list(range(len(cs))), p["dimensions"]["width"],
                            p["dimensions"]["height"], statistics.median(w[4]-w[2] for w in ws),
                            e.FIXA.vale, p["page_id"], diag)
        ordem = [ids[i] for i in ordem_i]
    else:
        raise ValueError(f"Ordenador desconhecido: {metodo}")
    exigir(len(ordem) == len(ids) and set(ordem) == set(ids), "Predicao nao e permutacao completa")
    diag["tempo_ms"] = 1000*(time.perf_counter()-t)
    return ordem, diag


@lru_cache(maxsize=1)
def assinatura_metricas():
    return digest([sha(p) for p in DEP_PATHS])


def expansoes(obj, p, canonica=True):
    """A ordem dentro da unidade independe do ordenador; nao altera a fonte."""
    return {u["id"]: e.o.fluxo([u], obj["palavras"]) if canonica else list(u["ks"])
            for u in p["bounding_boxes"]}


def diagnosticar_internas(obj, p):
    """Localiza divergencias de ks, incluindo linhas lado a lado nas faixas."""
    ws, gt = obj["palavras"], obj["gt_w"]
    h = statistics.median(w[4]-w[2] for w in ws)
    detalhes = []
    for u in p["bounding_boxes"]:
        can = e.o.fluxo([u], ws)
        if can == u["ks"]:
            continue
        ls = e.o.linhas(ws, u["ks"])
        lado = sum(any(ws[b][1]-ws[a][3] > max(4., e.FIXA.gap*h)
                       for a, b in zip(L["ks"], L["ks"][1:])) for L in ls)
        detalhes.append({"id": u["id"], "tipo": u["tipo"], "bbox": u["bbox"],
                         "palavras": len(can), "linhas": len(ls), "linhas_lado_a_lado": lado,
                         "piso_ks_cru": len(e.eventos(u["ks"], gt)),
                         "piso_canonico": len(e.eventos(can, gt)),
                         "primeiros_ks_crus": u["ks"][:16], "primeiros_ks_canonicos": can[:16]})
    return detalhes


def metricas(obj, p, ordem, *, canonica=True):
    ids = auditar_unidades(p, obj)
    exigir(isinstance(ordem, list) and len(ordem) == len(ids) and set(ordem) == set(ids),
           f"IDs da predicao nao pertencem a esta representacao: {p['page_id']}")
    mapa = {u["id"]: u for u in p["bounding_boxes"]}
    exp = expansoes(obj, p, canonica)
    seq = [k for uid in ordem for k in exp[uid]]
    q = referencia(obj, p)
    # Cache da regua independe do ordenador/representacao: mesma sequencia e
    # referencia implicam mesmas metricas. O piso depende das unidades.
    fp = digest([VERSAO, assinatura_metricas(), q, seq])
    cache = OUT / "cache/metricas" / (fp + ".json")
    if cache.exists():
        res = ler(cache)
    else:
        med = e.medir(q, seq, [], {}, "P0")
        res = {k: med[k] for k in METRICAS[:-1]}
        gravar(cache, res)
    # Mede transicoes dentro de CADA unidade com a mesma eventos(). Inclui
    # palavra livre interposta: tambem nao pode ser reparada reordenando IDs.
    res["piso_interno"] = sum(len(e.eventos(ks, q["gt_w"])) for ks in exp.values())
    exigir(res["piso_interno"] <= res["quebras"], "Piso excedeu quebras: expansao inconsistente")
    return res


def resumo(rows, R, rep, bancada, parcial=False):
    scores = {}
    for u, vs in cand.items():
        scores[u] = {}
        for v in vs:
            prob = probabilidades[(u, v)]
            if v is not None:
                if prob < cfg["limiar"]:
                    continue
                if (cfg["restricao_coluna"] and ctx["col"][v] < ctx["col"][u] and
                        u not in ctx["margem"] and v not in ctx["margem"]):
                    continue
            scores[u][v] = prob
        exigir(None in scores[u], "FIM explicito ausente")
    return DECODERS[cfg["decoder"]](ctx["ordem"], scores)


def inferir(co, obj, p, modelo, info, cfgs, diagnostico):
    path = EXEC / "inferencia" / co / (e.ac.chave(p["page_id"])+".json")
    row = carregar(path) or {"page_id": p["page_id"], "uf": obj["uf"],
           "resultados": dict(diagnostico["resultados"]), "tempos": {}}
    pendentes = [cfg for cfg in cfgs if nome_cfg(cfg) not in row["resultados"]]
    if not pendentes:
        return row
    inicio = time.perf_counter()
    ctx, trs, q = preparar_pagina(obj, p)
    _, cand, extras = candidatos(ctx)
    X, edges = matriz_features(ctx, cand[32], extras)
    cal = info["calibracao"]
    z = modelo.predict(X, raw_score=True, num_threads=4)
    probs = dict(zip(edges, expit(cal["a"]*z+cal["b"]).tolist()))
    comum = time.perf_counter()-inicio
    por_ordem = {tuple(r["ordem"]): r for r in row["resultados"].values()}
    for cfg in pendentes:
        vigiar()
        nome = nome_cfg(cfg)
        t0 = time.perf_counter()
        ordem = decodificar(ctx, cand[cfg["K"]], probs, cfg)
        ms = time.perf_counter()-t0
        if tuple(ordem) not in por_ordem:
            por_ordem[tuple(ordem)] = o.avaliar_ordem(obj, p, ctx, ordem, trs, q)
        row["resultados"][nome] = por_ordem[tuple(ordem)]
        row["tempos"][nome] = {"comum_segundos": comum, "decoder_segundos": ms}
        gravar(path, row)
    return row


def selecionar(dados):
    resumo = {}
    for nome in nomes:
        rs = [r for r in rows if nome in r["resultados"]]
        if not rs:
            resumo[nome] = {"n": 0, "completo": False}
            continue
        W = b.PESOS_CLUSTER(rs)
        grupo = {"n": len(rs), "completo": len(rs) == len(rows), "metricas": {}, "contrastes": {}, "classes": {}}
        for k in METRICAS:
            grupo["metricas"][k] = e.media_ic([r["resultados"][nome]["metricas"][k] for r in rs], W)
        for base in ("regra", "hibrido67"):
            rr = [r for r in rs if base in r["resultados"]]
            testes = {}
            for k in METRICAS:
                ds = [(r["resultados"][nome]["metricas"][k]-r["resultados"][base]["metricas"][k])
                       if r["resultados"][nome]["metricas"][k] is not None and
                          r["resultados"][base]["metricas"][k] is not None else None for r in rr]
                if not rr:
                    continue
                ufs = sorted({r["uf"] for r in rr})
                por = {uf: o.media([d for r, d in zip(rr, ds) if r["uf"] == uf]) for uf in ufs}
                sinal = -1 if k in ("quebras", "quebras_mil") else 1
                testes[k] = {**e.media_ic(ds, b.PESOS_CLUSTER(rr)), "por_veiculo": por,
                     "wilcoxon_veiculo": e.pratt([d for d in por.values() if d is not None]),
                     "melhor": sum(d is not None and sinal*d > 1e-12 for d in ds),
                     "igual": sum(d is not None and abs(d) <= 1e-12 for d in ds),
                     "pior": sum(d is not None and sinal*d < -1e-12 for d in ds)}
            grupo["contrastes"][base] = {"n_pareado": len(rr), "completo": len(rr) == len(rows), "metricas": testes}
        for tipo in c.TIPOS:
            soma = collections.Counter()
            for r in rs:
                soma.update(r["resultados"][nome]["classes"][tipo])
            ds = [r["resultados"][nome]["classes"][tipo]["quebras"]-
                  r["resultados"]["regra"]["classes"][tipo]["quebras"] for r in rs]
            por = [statistics.mean(d for r, d in zip(rs, ds) if r["uf"] == uf)
                   for uf in sorted({r["uf"] for r in rs})]
            grupo["classes"][tipo] = {**soma, "quebras_pagina": soma["quebras"]/len(rs),
                    "delta": e.media_ic(ds, W), "wilcoxon_veiculo": e.pratt(por)}
        grupo["cobertura"] = min(r["resultados"][nome]["cobertura_palavras"] for r in rs)
        resumo[nome] = grupo
    return resumo


