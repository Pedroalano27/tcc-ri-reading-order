    paths += [ac.CACHE / "palavras" / (ac.chave(q["p"]["page_id"]) + ".json")
              for q in qs if q["coorte"] == "v3_novo"]
    for n in ("erros_ponta_a_ponta_previa.md", "erros_ponta_a_ponta_previa.json"):
