+
+
+def vigiar():
+    exigir(o.ler_lock()[0] == LOCK_SHA, "Lacre cego mudou")
+    if PRAZO is not None and time.monotonic() >= PRAZO:
+        raise TimeoutError("Prazo atingido; repetir retoma paginas prontas")
+    mem = b.memoria()
