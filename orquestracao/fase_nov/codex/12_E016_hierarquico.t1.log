def hashes(qs):
    paths = list(o.ENTRADAS) + list(o.FONTES) + [Path(__file__), Path(j.__file__), Path(ls.__file__),
        Path(ac.__file__), Path(ri.__file__), RAIZ / "src/eval/politica_margens.py",
