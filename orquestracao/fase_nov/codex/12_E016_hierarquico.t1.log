+    args = ap.parse_args()
+    LOCK_SHA, o.PROTEGIDOS = o.ler_lock()
+    o.PROTEGIDOS.update(x.rsplit("#p", 1)[0] for x in list(o.PROTEGIDOS) if "#p" in x)
+    PRAZO = time.monotonic()+60*args.max_minutos
+    if "torch" in sys.modules:
