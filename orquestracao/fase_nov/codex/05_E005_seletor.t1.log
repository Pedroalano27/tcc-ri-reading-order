+    l += ["", "## Sensibilidade às sementes", "",
+          "Média ± desvio padrão amostral das métricas agregadas entre sementes; não é IC e não escolhe o vencedor.", "",
+          "| Modo | Método | Quebras/pág média ± dp | τ média ± dp |", "|---|---|---:|---:|"]
+    sensibilidade = {}
