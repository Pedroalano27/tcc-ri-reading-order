        # sao divididas em trechos contiguos desse fluxo; nunca o reordenam.
        ls = e.o.linhas_partidas(ws, list(range(len(ws))), e.FIXA.gap, h)
        dono = {k: i for i, L in enumerate(ls) for k in L["ks"]}
