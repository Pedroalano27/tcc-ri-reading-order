+    auto = {"page_id": "sintetico/a.pdf#p0", "dimensions": {"width": 100., "height": 100.},
+            "bounding_boxes": [{"id": f"u{i}", "bbox": w[1:], "ks": [i], "text": w[0], "tipo": "texto"} for i, w in enumerate(ws)]}
+    ordens = {"regra": ["u0", "u1"], "lr": ["u1", "u0"]}
