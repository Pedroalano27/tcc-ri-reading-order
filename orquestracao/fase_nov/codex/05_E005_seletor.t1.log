+        "fontes": FONTES,
+        "produtos": {str(p.relative_to(OUT)): c.sha(p) for p in
+                     [OUT / "cache/estado.json", OUT / "RELATORIO.md", OUT / "resumo_registro.json"]}})
+    print(veredito, flush=True)
+
+
+def autoteste():
