+        except ValueError:
+            pass
+        else:
+            raise ValueError("Lock cego nao bloqueou pagina sintetica")
+    finally:
+        o.PROTEGIDOS = antigo
+    print("Autoteste: empate, features sem ouro, concordância, entrada e lock OK", flush=True)
