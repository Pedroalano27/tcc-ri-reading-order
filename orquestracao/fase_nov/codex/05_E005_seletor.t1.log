+    elegiveis = [r for r in rows if r["completo"]]
+    pids = collections.Counter(r["page_id"] for r in elegiveis)
+    l = [f"1. Âncora reproduzida: τ {o.f(an['tau'], 6)}; {o.f(an['quebras'], 6)} quebras/página.",
