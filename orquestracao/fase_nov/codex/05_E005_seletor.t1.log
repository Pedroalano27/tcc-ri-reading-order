+        linhas.append(f"| {nome} | {s['n']} | "+" | ".join(o.f(m[k], 6) for k in METRICAS)+" |")
+    linhas += ["", "| Método | Base | n pareado | Δ quebras [IC95 veículo] | p veículo | Melhor/igual/pior | Reparos/regressões |",
