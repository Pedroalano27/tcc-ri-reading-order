+    l = [f"1. Âncora reproduzida: τ {o.f(an['tau'], 6)}; {o.f(an['quebras'], 6)} quebras/página.",
+         f"2. CV conjunta: {len(elegiveis)} observações, {len(pids)} páginas distintas, {len({r['uf'] for r in elegiveis})} veículos; leave-one-vehicle-out.",
