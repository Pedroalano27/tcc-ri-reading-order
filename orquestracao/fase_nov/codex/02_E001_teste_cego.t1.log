+    cachepath = OUT / "cache/fontes_inventario.json"
+    cache = ler(cachepath) if cachepath.exists() else {}
+    tocados, usados, desconhecidos = collections.defaultdict(set), {}, set()
+    for i, p in enumerate(sorted(fontes)):
