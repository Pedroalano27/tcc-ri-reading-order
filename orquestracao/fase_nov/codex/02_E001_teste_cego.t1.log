+        l += [f"Tempo da invocação que concluiu a montagem: {fmt(manifesto['tempo_s_ultima_invocacao'], 1)} s; execuções anteriores podem ter produzido caches. Não é benchmark controlado.", ""]
+    l += ["## Sorteio e limites", "",
