+            relatorio(anc, inv, plano, selecao, manifesto,
+                      "Montagem concluída; páginas lacradas para avaliação confirmatória única.")
+            lacrar(selecao, montador, manifesto)
+            conferir_lacre()
+        except (Exception, KeyboardInterrupt) as exc:
+            if not LOCK.exists():
