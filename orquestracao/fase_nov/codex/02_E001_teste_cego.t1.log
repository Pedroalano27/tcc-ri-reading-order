+    if plano:
+        l += ["## Disponibilidade antes da triagem", "", "| Lote | Veículo | PDFs no acervo | Já tocados | Disponíveis por caminho | Meta de páginas |", "|---|---|---:|---:|---:|---:|"]
+        for g, ufs in plano["grupos"].items():
