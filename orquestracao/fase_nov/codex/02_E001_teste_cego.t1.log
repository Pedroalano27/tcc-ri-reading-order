+    if selecao:
+        l += ["", "## Contagens por veículo e estrato", "", "| Lote | Veículo | PDFs | Páginas | Colunas | Tabela detectada |", "|---|---|---:|---:|---|---|"]
+        for g, ps in selecao["grupos"].items():
