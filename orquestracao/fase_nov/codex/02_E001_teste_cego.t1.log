+    exigir(args.max_minutos >= 0, "Tempo deve ser positivo ou zero")
+    inicio = time.monotonic()
+    with trava():
+        if LOCK.exists():
+            conferir_lacre()
+            return
+        anc = {"paginas": 0, "tau": 0., "quebras": 0., "aprovada": False}
+        inv = plano = selecao = None
+        try:
+            e, b, u, m = importar()
+            anc = ancora(e, b)
+            raw = catalogo_raw()
