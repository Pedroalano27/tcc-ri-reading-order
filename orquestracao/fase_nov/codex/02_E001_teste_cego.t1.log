+                usados_hash.update(self.hash_pdf(self.raw[q["pdf"]]) for q in paginas)
+        for grupo in selecao["grupos"]:
+            random.Random(SEMENTES[grupo]).shuffle(selecao["grupos"][grupo])
+        gravar(p, selecao)
+        return selecao
