+        obj = {"pdf": k, "fingerprint": fp, "paginas": selecionadas, "tentativas": tentativas,
+               "exaustivo": exaustivo, "paginas_internas_pdf": len(numeros)}
+        gravar(p, obj)
+        self.fechar_pdf()
+        return obj
