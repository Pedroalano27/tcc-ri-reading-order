+        anc = {"paginas": 0, "tau": 0., "quebras": 0., "aprovada": False}
+        inv = plano = selecao = montador = None
+        try:
+            e, b, u, m = importar()
+            anc = ancora(e, b)
+            raw = catalogo_raw()
+            inv = inventario(raw)
+            montador = Montador(e, u, m, raw, inv,
+                                inicio + args.max_minutos*60 if args.max_minutos else None)
