  configurarEventosInteracaoTimer();
  iniciarCronometroGlobal();

  const restaurado = carregarDoLocalStorage();
  if (!restaurado) {
    // Abrir modal de boas-vindas na primeira inicialização
    abrirModalSessao();
  }
});

function classesAtuais() {
  return app.modo.startsWith("A") ? CLASSES_MODO_A : CLASSES_MODO_B;
}

function renderizarPaletaClasses() {
  const lista = classesAtuais();
  const container = document.getElementById("grade-classes");
  container.innerHTML = "";

  document.getElementById("rotulo-modo-paleta").textContent = app.modo.startsWith("A") ? "Modo A Densa" : "Modo B Simplificada";
  document.getElementById("atalho-paleta-info").textContent = `Teclas 1 a ${lista.length % 10}`;

  // Se classe ativa não pertencer à lista atual, ajusta
  if (!lista.some(c => c.id === app.classeAtiva)) {
    app.classeAtiva = lista[0].id;
  }

  lista.forEach(c => {
    const btn = document.createElement("div");
    btn.className = `btn-classe ${c.id === app.classeAtiva ? "selecionada" : ""}`;
    btn.id = `btn-classe-${c.id}`;
    btn.innerHTML = `
      <div class="classe-info">
        <span class="ponto-cor" style="background: ${c.cor};"></span>
        <span>${c.nome}</span>
      </div>
      <kbd>${c.tecla}</kbd>
    `;
    btn.onclick = () => selecionarClasseAtiva(c.id);
    container.appendChild(btn);
  });
}

function selecionarClasseAtiva(classeId) {
  app.classeAtiva = classeId;
  document.querySelectorAll(".btn-classe").forEach(el => el.classList.remove("selecionada"));
  const btn = document.getElementById(`btn-classe-${classeId}`);
  if (btn) btn.classList.add("selecionada");

  // Se houver unidades selecionadas, atualiza imediatamente
  if (app.selecionadas.size > 0) {
    salvarHistorico();
    const pag = paginaAtual();
    const alteradas = [];
    pag.caixas.forEach(cx => {
      if (app.selecionadas.has(cx.id) && cx.classe !== classeId) {
        alteradas.push({ id: cx.id, de: cx.classe, para: classeId });
        cx.classe = classeId;
      }
    });
    if (alteradas.length > 0) {
      registrarAcao("reclassificar", { alteradas });
    }
    atualizarDetalhesCaixa();
    renderizarDocumento();
    salvarAutosave();
  }
}

// -----------------------------------------------------------------------------
// CONTROLE DO CRONÔMETRO E DETECÇÃO DE INATIVIDADE (60 s)
// -----------------------------------------------------------------------------
function iniciarCronometroGlobal() {
  if (app.intervaloTimer) clearInterval(app.intervaloTimer);
  let ultimaMarcacao = Date.now();

  app.intervaloTimer = setInterval(() => {
    const agora = Date.now();
    const delta = agora - ultimaMarcacao;
    ultimaMarcacao = agora;

    const pag = paginaAtual();
    if (!pag) return;

    // Checar inatividade após 60 segundos sem interação
    const tempoSemInteracao = agora - app.ultimoMomentoInteracao;
    if (!app.pausadoManual && tempoSemInteracao >= 60000) {
      if (!app.pausadoInatividade) {
        app.pausadoInatividade = true;
        pag.tempos.pausas_contagem = (pag.tempos.pausas_contagem || 0) + 1;
        registrarAcao("pausa_inatividade", { t_inatividade_ms: tempoSemInteracao });
        atualizarDisplayCronometro();
      }
    }

    const estaPausado = app.pausadoManual || app.pausadoInatividade;
    if (!estaPausado) {
      pag.tempos.tempo_ativo_ms = (pag.tempos.tempo_ativo_ms || 0) + delta;
      pag.tempos.tempo_ativo_s = Math.round(pag.tempos.tempo_ativo_ms / 100) / 10;
    }
    pag.tempos.tempo_total_ms = (pag.tempos.tempo_total_ms || 0) + delta;
    pag.tempos.tempo_total_s = Math.round(pag.tempos.tempo_total_ms / 100) / 10;

    atualizarDisplayCronometro();
  }, 100);
}

function configurarEventosInteracaoTimer() {
  const registrarInteracao = () => {
    app.ultimoMomentoInteracao = Date.now();
    if (app.pausadoInatividade) {
      app.pausadoInatividade = false;
      registrarAcao("retomada_interacao", {});
      atualizarDisplayCronometro();
    }
  };

  window.addEventListener("mousemove", registrarInteracao, { passive: true });
  window.addEventListener("mousedown", registrarInteracao, { passive: true });
  window.addEventListener("keydown", registrarInteracao, { passive: true });
  window.addEventListener("scroll", registrarInteracao, { passive: true });
}

function alternarPausaManual() {
  app.pausadoManual = !app.pausadoManual;
  const pag = paginaAtual();
  if (app.pausadoManual) {
    if (pag) pag.tempos.pausas_contagem = (pag.tempos.pausas_contagem || 0) + 1;
    registrarAcao("pausa_manual", {});
    document.getElementById("overlay-pausa").style.display = "flex";
  } else {
    app.ultimoMomentoInteracao = Date.now();
    registrarAcao("retomada_manual", {});
    document.getElementById("overlay-pausa").style.display = "none";
  }
  atualizarDisplayCronometro();
}

function atualizarDisplayCronometro() {
  const pag = paginaAtual();
  if (!pag || !pag.tempos) return;

  const ativoS = Math.floor((pag.tempos.tempo_ativo_ms || 0) / 1000);
  const min = Math.floor(ativoS / 60).toString().padStart(2, "0");
  const seg = Math.floor(ativoS % 60).toString().padStart(2, "0");

  document.getElementById("cronometro-display").textContent = `${min}:${seg}`;

  const tag = document.getElementById("cronometro-status-tag");
  const btnPausar = document.getElementById("btn-pausar-cronometro");

  if (app.pausadoManual) {
    tag.className = "cronometro-tag pausado-manual";
    tag.textContent = "Pausado";
    btnPausar.textContent = "▶️ Retomar";
    btnPausar.className = "sucesso";
  } else if (app.pausadoInatividade) {
    tag.className = "cronometro-tag pausado-inativo";
    tag.textContent = "Inativo (60s)";
    btnPausar.textContent = "▶️ Retomar";
    btnPausar.className = "alerta";
  } else {
    tag.className = "cronometro-tag ativo";
    tag.textContent = "Ativo";
    btnPausar.textContent = "⏸️ Pausar";
    btnPausar.className = "";
  }
}

// -----------------------------------------------------------------------------
// REGISTRO DE AÇÕES E AUDITORIA (E008)
// -----------------------------------------------------------------------------
function registrarAcao(tipo, detalhe = {}) {
  const pag = paginaAtual();
  if (!pag) return;

  if (!pag.contagem_acoes) {
    pag.contagem_acoes = {
      criar: 0, apagar: 0, mover: 0, redimensionar: 0,
      reclassificar: 0, ligar_ordem: 0, dividir: 0,
      juntar: 0, desfazer: 0, pular: 0
    };
  }
  if (!pag.acoes) pag.acoes = [];

  if (pag.contagem_acoes[tipo] !== undefined) {
    pag.contagem_acoes[tipo]++;
  }

  const t_ms = Math.round(pag.tempos ? pag.tempos.tempo_ativo_ms : 0);
  pag.acoes.push({
    tipo: tipo,
    t_ms: t_ms,
    detalhe: detalhe
  });

  atualizarResumoAcoes();
  salvarAutosave();
}

function atualizarResumoAcoes() {
  const pag = paginaAtual();
  const pontos = [
    { dir: "nw", x: x0, y: y0, cur: "nwse-resize" },
    { dir: "n",  x: (x0 + x1) / 2, y: y0, cur: "ns-resize" },
    { dir: "ne", x: x1, y: y0, cur: "nesw-resize" },
    { dir: "e",  x: x1, y: (y0 + y1) / 2, cur: "ew-resize" },
    { dir: "se", x: x1, y: y1, cur: "nwse-resize" },
    { dir: "s",  x: (x0 + x1) / 2, y: y1, cur: "ns-resize" },
    { dir: "sw", x: x0, y: y1, cur: "nesw-resize" },
    { dir: "w",  x: x0, y: (y0 + y1) / 2, cur: "ew-resize" }
  ];

  pontos.forEach(p => {
    const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
    rect.setAttribute("x", p.x - 3.5);
    rect.setAttribute("y", p.y - 3.5);
    rect.setAttribute("width", 7);
    rect.setAttribute("height", 7);
    rect.setAttribute("class", "svg-alca");
    rect.style.cursor = p.cur;
    rect.onmousedown = (e) => iniciarArrastoAlca(e, cx.id, p.dir);
    camada.appendChild(rect);
  });
}

function pontoSVG(e) {
  const svg = document.getElementById("overlay-svg");
  const pt = svg.createSVGPoint();
  pt.x = e.clientX;
  pt.y = e.clientY;
  return pt.matrixTransform(svg.getScreenCTM().inverse());
}

// -----------------------------------------------------------------------------
// EVENTOS DE INTERAÇÃO COM O MOUSE
// -----------------------------------------------------------------------------
function iniciarArrastoCaixa(e, caixaId) {
  e.stopPropagation();

  // Modo Ordem: clique adiciona ou remove da sequência
  if (app.modoOrdem) {
    salvarHistorico();
    const pag = paginaAtual();
    const pos = pag.ordem.indexOf(caixaId);
    if (pos === -1) {
      pag.ordem.push(caixaId);
      registrarAcao("ligar_ordem", { caixa_id: caixaId, acao: "adicionar", posicao: pag.ordem.length });
    } else {
      pag.ordem.splice(pos, 1);
      registrarAcao("ligar_ordem", { caixa_id: caixaId, acao: "remover", posicao_anterior: pos + 1 });
    }
    renderizarDocumento();
    salvarAutosave();
    return;
  }

  // Modo Dividir: clique fatia a caixa na coordenada Y
  if (app.modoDividir) {
    executarDivisaoCaixa(caixaId, pontoSVG(e));
    return;
  }

  // Seleção normal
  if (e.shiftKey) {
    if (app.selecionadas.has(caixaId)) app.selecionadas.delete(caixaId);
    else app.selecionadas.add(caixaId);
  } else {
    if (!app.selecionadas.has(caixaId)) {
      app.selecionadas.clear();
      app.selecionadas.add(caixaId);
    }
  }

  atualizarDetalhesCaixa();
  renderizarDocumento();

  // Iniciar arraste para mover
  const pt = pontoSVG(e);
  const pag = paginaAtual();
  const caixasIniciais = new Map();
  pag.caixas.forEach(c => {
    if (app.selecionadas.has(c.id)) {
      caixasIniciais.set(c.id, [...c.bbox]);
    }
  });

  app.arrastando = {
    tipo: "mover",
    inicioX: pt.x,
    inicioY: pt.y,
    caixasIniciais: caixasIniciais,
    moveu: false
  };

  salvarHistorico();
}

function iniciarArrastoAlca(e, caixaId, direcao) {
  e.stopPropagation();
  const pt = pontoSVG(e);
  const pag = paginaAtual();
  const cx = pag.caixas.find(c => c.id === caixaId);
  if (!cx) return;

  salvarHistorico();
  app.arrastando = {
    tipo: "alca",
    caixaId: caixaId,
    direcao: direcao,
    inicioX: pt.x,
    inicioY: pt.y,
    bboxInicial: [...cx.bbox],
    redimensionou: false
  };
}

function configurarEventosUI() {
  const svg = document.getElementById("overlay-svg");

  svg.onmousedown = (e) => {
    if (e.target !== svg) return;

    if (!e.shiftKey) {
      app.selecionadas.clear();
      atualizarDetalhesCaixa();
      renderizarDocumento();
    }

    if (app.modoOrdem || app.modoDividir) return;

    // Iniciar desenho de nova caixa
    const pt = pontoSVG(e);
    salvarHistorico();
    app.arrastando = {
      tipo: "desenhar",
      inicioX: pt.x,
      inicioY: pt.y
    };
  };

  window.onmousemove = (e) => {
    if (!app.arrastando) return;
    const pt = pontoSVG(e);
    const pag = paginaAtual();
    if (!pag) return;

    if (app.arrastando.tipo === "mover") {
      const dx = pt.x - app.arrastando.inicioX;
      const dy = pt.y - app.arrastando.inicioY;
      if (Math.abs(dx) > 2 || Math.abs(dy) > 2) app.arrastando.moveu = true;

      pag.caixas.forEach(c => {
        if (app.arrastando.caixasIniciais.has(c.id)) {
          const [x0, y0, x1, y1] = app.arrastando.caixasIniciais.get(c.id);
          c.bbox = [Math.round(x0 + dx), Math.round(y0 + dy), Math.round(x1 + dx), Math.round(y1 + dy)];
        }
      });
      renderizarDocumento();
    } else if (app.arrastando.tipo === "alca") {
      app.arrastando.redimensionou = true;
      const cx = pag.caixas.find(c => c.id === app.arrastando.caixaId);
      if (!cx) return;
      let [x0, y0, x1, y1] = app.arrastando.bboxInicial;
      const dir = app.arrastando.direcao;

      if (dir.includes("w")) x0 = Math.min(pt.x, x1 - 5);
      if (dir.includes("e")) x1 = Math.max(pt.x, x0 + 5);
      if (dir.includes("n")) y0 = Math.min(pt.y, y1 - 5);
      if (dir.includes("s")) y1 = Math.max(pt.y, y0 + 5);

      cx.bbox = [Math.round(x0), Math.round(y0), Math.round(x1), Math.round(y1)];

