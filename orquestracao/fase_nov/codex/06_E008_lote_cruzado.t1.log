function comporTextoPalavras(idsCobertos, palavrasNorm) {
  if (!idsCobertos || idsCobertos.length === 0 || !palavrasNorm) return "";
  const mapa = new Map(palavrasNorm.map(p => [p.id, p.texto]));
  return idsCobertos.map(id => mapa.get(id) || "").filter(Boolean).join(" ");
}

// -----------------------------------------------------------------------------
// IMPORTAÇÃO E PARSER DE TAREFAS (.json e .jsonl)
// -----------------------------------------------------------------------------
function carregarArquivoTarefas(conteudoTexto) {
  try {
    const textoLimpo = conteudoTexto.trim();
    let listaTarefasBruta = [];

    // 1. Detectar se é JSON Lines (.jsonl)
    const linhas = textoLimpo.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
    if (linhas.length > 1 && linhas[0].startsWith("{") && linhas[linhas.length - 1].endsWith("}")) {
      listaTarefasBruta = linhas.map(l => JSON.parse(l));
    } else {
      // 2. JSON padrão (.json)
      const parsed = JSON.parse(textoLimpo);
      if (Array.isArray(parsed)) {
        listaTarefasBruta = parsed;
      } else if (parsed.tasks) {
        listaTarefasBruta = parsed.tasks;
      } else if (parsed.paginas) {
        listaTarefasBruta = parsed.paginas;
      } else {
        listaTarefasBruta = [parsed];
      }
    }

    // Processar para o modelo interno do anotador
    const processadas = converterTarefasEntrada(listaTarefasBruta);
    if (processadas.length === 0) {
      return alert("Nenhuma página válida encontrada no arquivo.");
    }

    app.tarefasOriginais = processadas;
    if (app.embaralhar) {
      app.tarefas = embaralharLista(processadas, app.semente);
    } else {
      app.tarefas = processadas.map(p => ({ ...p }));
    }

    app.indiceAtual = 0;
    app.selecionadas.clear();
    app.historico = [];
    atualizarBadgesMeta();
    atualizarListaTarefas();
    carregarPaginaAtual();
    salvarAutosave();

    mostrarAviso(`${app.tarefas.length} página(s) carregada(s) no Modo ${app.modo}.`);
  } catch (err) {
    alert("Erro ao ler tarefas: " + err.message);
  }
}

function converterTarefasEntrada(listaBruta) {
  return listaBruta.map((item, idx) => {
    const isLS = item.annotations || (item.data && item.data.image);
    if (isLS) {
      return converterItemLabelStudio(item, idx);
    }

    const pid = item.page_id || item.id || `pag_${idx + 1}`;
    const imgNome = (item.imagem || `${idx + 1}.jpg`).split(/[\\/]/).pop();
    const dim = item.dimensions || {};
    const W = Number(dim.width) || item.largura || 595.2;
    const H = Number(dim.height) || item.altura || 842.0;

    const palavrasNorm = normalizarPalavras(item.palavras);

    // Selecionar de onde vêm as caixas iniciais
    let caixasIniciais = [];
    if (app.modo.startsWith("B")) {
      // MODO B (Simplificada): As LINHAS da proposta já vêm como unidades
      const proposta = item.proposta || item.unidades || [];
      caixasIniciais = proposta.map((p, k) => {
        let classe = "linha";
        const tipoOrig = String(p.tipo_original || p.classe || "").toLowerCase();
        if (tipoOrig === "tabela" || tipoOrig === "table") classe = "tabela";
        else if (tipoOrig === "figura" || tipoOrig === "picture" || tipoOrig === "imagem") classe = "figura";
        else if (tipoOrig === "quadro") classe = "quadro";
        else if (tipoOrig === "cabecalho" || tipoOrig === "rodape") classe = "skip_noise";

        const bbox = normalizarBbox(p.bbox || [0,0,10,10]);
        const cobertas = calcularPalavrasCobertas(bbox, palavrasNorm);
        const txt = p.texto || comporTextoPalavras(cobertas, palavrasNorm);

        return {
          id: p.id || `u${k+1}`,
          bbox: bbox,
          classe: classe,
          texto: txt,
          palavras_cobertas: cobertas
        };
      });
    } else {
      // MODO A (Densa)
      if (app.origemModoA === "proposta") {
        const proposta = item.proposta || item.unidades || [];
        caixasIniciais = proposta.map((p, k) => {
          let classe = p.classe || "texto";
          if (!CLASSES_MODO_A.some(c => c.id === classe)) classe = "texto";
          const bbox = normalizarBbox(p.bbox || [0,0,10,10]);
          const cobertas = calcularPalavrasCobertas(bbox, palavrasNorm);
          return {
            id: p.id || `c${k+1}`,
            bbox: bbox,
            classe: classe,
            texto: p.texto || comporTextoPalavras(cobertas, palavrasNorm),
            palavras_cobertas: cobertas
          };
        });
      } else if (app.origemModoA === "blocos_v3" && Array.isArray(item.blocos_v3) && item.blocos_v3.length > 0) {
        caixasIniciais = item.blocos_v3.map((b, k) => {
          const bbox = normalizarBbox(b.bbox || [0,0,10,10]);
          const cobertas = calcularPalavrasCobertas(bbox, palavrasNorm);
          return {
            id: b.id || `v${k+1}`,
            bbox: bbox,
            classe: "texto",
            texto: comporTextoPalavras(cobertas, palavrasNorm),
            palavras_cobertas: cobertas
          };
        });
      } else {
        caixasIniciais = []; // Tela em branco
      }
    }

    return {
      page_id: String(pid),
      n: item.n !== undefined ? item.n : (idx + 1),
      indice_original: idx,
      imagem: imgNome,
      largura: W,
      altura: H,
      palavras: palavrasNorm,
      caixas: caixasIniciais,
      ordem: item.ordem || [],
      motivo_pulo: null,
      tempos: {
        tempo_ativo_ms: 0,
        tempo_ativo_s: 0,
        tempo_total_ms: 0,
        tempo_total_s: 0,
        pausas_contagem: 0
      },
      contagem_acoes: {
        criar: 0, apagar: 0, mover: 0, redimensionar: 0,
        reclassificar: 0, ligar_ordem: 0, dividir: 0,
        juntar: 0, desfazer: 0, pular: 0
      },
      acoes: []
    };
  });
}

function converterItemLabelStudio(item, idx) {
  const data = item.data || {};
  const pid = data.page_id || data.id || item.id || `ls_${idx + 1}`;
  const imagem = (data.image || `${pid}.jpg`).split(/[\\/]/).pop();
  const ann = (item.annotations || [])[0] || item;
  const results = ann.result || [];
  const lead_time = ann.lead_time || 0;

  let origW = 1000, origH = 1000;
  const caixasMap = {};
  const ligacoes = [];

  results.forEach(r => {
    if (r.type === "relation") {
      let de = r.from_id;
      let para = r.to_id;
      if (r.direction === "left") [de, para] = [para, de];
      if (de && para) ligacoes.push({ de, para });
      return;
    }
    const rid = r.id;
    if (!rid) return;
    if (!caixasMap[rid]) {
      caixasMap[rid] = { id: rid, classe: "texto", texto: "", pct: null, W: null, H: null };
    }
    if (r.original_width) origW = r.original_width;
    if (r.original_height) origH = r.original_height;

    const val = r.value || {};
    if (r.type === "rectanglelabels" || r.type === "labels") {
      const labs = val[r.type] || [];
      if (labs.length > 0) caixasMap[rid].classe = labs[0];
    } else if (r.type === "textarea") {
      const txts = val.text || [];
      caixasMap[rid].texto = txts.join("\n");
    }

    if (!caixasMap[rid].pct && val.x !== undefined && val.width !== undefined) {
      caixasMap[rid].pct = [val.x, val.y, val.width, val.height];
      caixasMap[rid].W = r.original_width || origW;
      caixasMap[rid].H = r.original_height || origH;
    }
  });

  const caixas = Object.values(caixasMap).map(c => {
    const W = c.W || origW;
    const H = c.H || origH;
    let [px, py, pw, ph] = c.pct || [0,0,10,10];
    return {
      id: c.id,
      bbox: normalizarBbox([(px / 100) * W, (py / 100) * H, ((px + pw) / 100) * W, ((py + ph) / 100) * H]),
      classe: c.classe,
      texto: c.texto,
      palavras_cobertas: []
    };
  });

  let ordem = [];
  if (ligacoes.length > 0) {
    const sucessores = {};
    const entradas = {};
    caixas.forEach(c => entradas[c.id] = 0);
    ligacoes.forEach(l => {
      sucessores[l.de] = l.para;
      entradas[l.para] = (entradas[l.para] || 0) + 1;
    });
    const cabeca = caixas.find(c => entradas[c.id] === 0 && sucessores[c.id]);
    if (cabeca) {
      let atual = cabeca.id;
      const visitados = new Set();
      while (atual && !visitados.has(atual)) {
        visitados.add(atual);
        ordem.push(atual);
        atual = sucessores[atual];
      }
    }
  }

  return {
    page_id: String(pid),
    n: idx + 1,


def imagem_bancada(m, contexto):
    pid = m["page_id"]
    if pid in contexto["h4"]:
        p = pagina(contexto["h4"][pid])
        return RAIZ / "data/golden/golden_v4/img" / p["imagem"]
    if pid in contexto["bench"]:
        p = pagina(contexto["bench"][pid][1])
        lote = "golden_v1" if str(p.get("origem", "")).startswith("golden_v1") else "golden_v2"
        return RAIZ / "data/golden" / lote / "img" / p["imagem"]
    return None


def detector(m, contexto):
    """P2: mesmos pesos, renderizacao, NMS e escala; inferencia so em CPU."""
    global MODELO
    pid = m["page_id"]
    img = imagem_bancada(m, contexto)
    peso = contexto["hashes"][rel(e.ls.PESOS)]
    caminho = OUT / "cache/detector" / (e.ac.chave(pid) + ".json")
    meta = {"peso": peso, "dimensions": m["dimensions"], "imgsz": 1024,
            "conf": .25, "iou": .7, "max_det": 300, "device": "cpu"}
    if img:
        meta["imagem"] = sha(img)
    else:
        meta.update(pdf=hash_do_pdf(RAIZ / "data/raw" / m["uf"] / m["arquivo"]),
                    pagina=m["pagina"], dpi=e.layout.DPI)
    fp = digest(meta)
    if caminho.exists():
        salvo = ler(caminho)
        exigir(salvo["fingerprint"] == fp, f"Detector em cache incompatível: {pid}")
        return salvo["regioes"], rel(caminho)
    antigo = e.BASE / "detector" / (e.ac.chave(pid) + ".json")
    if img and antigo.exists():
        salvo = ler(antigo)
        if salvo.get("fingerprint") == fp:
            gravar(caminho, {**salvo, "origem": rel(antigo)})
            return salvo["regioes"], rel(antigo)
    if img is None:
        # Renderizador canonico do P2, sem OCR ou troca de extrator.
        import pdfplumber
        img = OUT / "cache/imagens" / (e.ac.chave(pid) + ".png")
        if not img.exists():
            img.parent.mkdir(parents=True, exist_ok=True)
            with pdfplumber.open(RAIZ / "data/raw" / m["uf"] / m["arquivo"]) as doc:
                page = doc.pages[m["pagina"]]
                pi = page.to_image(resolution=e.layout.DPI)
                exigir(max(abs(v) for v in pi.bbox[:2]) < .11,
                       f"CropBox deslocada: escala P2 nao e aplicavel a {pid}")
                exigir(max(abs(pi.bbox[2]-page.width), abs(pi.bbox[3]-page.height)) < .11,
                       f"Imagem nao cobre pagina inteira: {pid}")
                tmp_img = img.with_suffix(".png.tmp")
                pi.original.convert("RGB").save(tmp_img, format="PNG")
                os.replace(tmp_img, img)
                page.close()
    if MODELO is None:
        import torch
        torch.set_num_threads(4)
        torch.set_num_interop_threads(1)
        from ultralytics import YOLO
        from ultralytics.utils import SETTINGS
        dict.__setitem__(SETTINGS, "sync", False)
        MODELO = YOLO(str(e.ls.PESOS)).to("cpu")
    from PIL import Image
    with Image.open(img) as im:
        wpx, hpx = im.size
    pred = MODELO.predict(str(img), device="cpu", imgsz=1024, conf=.25, iou=.7,
                          max_det=300, verbose=False, save=False, save_txt=False)[0]
    exigir(tuple(pred.orig_shape) == (hpx, wpx), "Dimensoes da imagem inconsistentes")
    sx, sy = m["dimensions"]["width"] / wpx, m["dimensions"]["height"] / hpx
    regs = []
    for b in pred.boxes:
        cls = pred.names[int(b.cls.item())]
        exigir(cls in ("texto", "tabela", "imagem"), "Peso nao e ls3")
        x0, y0, x1, y1 = map(float, b.xyxy[0].tolist())
        regs.append({"id": f"d{len(regs)}", "classe": cls, "score": float(b.conf.item()),
                     "bbox": [x0*sx, y0*sy, x1*sx, y1*sy]})
    gravar(caminho, {"fingerprint": fp, "meta": meta, "regioes": regs, "origem": "CPU"})
    return regs, "CPU"


