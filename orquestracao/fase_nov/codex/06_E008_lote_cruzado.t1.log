            med = e.medir(b.referencia(obj, p), seq, [], {}, "P0")
            row = {"fingerprint": fp, "page_id": p["page_id"],
                   **{k: med[k] for k in ("tau", "quebras", "fid12", "sucessor_linhas")}}
            gravar(cache, row)
        rows.append(row)
    res = {"paginas": len(rows), "fontes_sha256": fontes,
