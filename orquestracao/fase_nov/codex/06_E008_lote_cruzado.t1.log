function normalizarBbox(bbox) {
  let [x0, y0, x1, y1] = bbox.map(Number);
  return [
    Math.round(Math.min(x0, x1) * 10) / 10,
    Math.round(Math.min(y0, y1) * 10) / 10,
    Math.round(Math.max(x0, x1) * 10) / 10,
    Math.round(Math.max(y0, y1) * 10) / 10
  ];
}

function normalizarPalavras(listaRaw) {
  if (!Array.isArray(listaRaw)) return [];
  return listaRaw.map((w, idx) => {
    if (Array.isArray(w)) {
      // [texto, x0, y0, x1, y1, line_idx]
      const x0 = Number(w[1]) || 0;
      const y0 = Number(w[2]) || 0;
      const x1 = Number(w[3]) || 0;
      const y1 = Number(w[4]) || 0;
      return {
        id: idx,
        texto: String(w[0] || ""),
        bbox: [x0, y0, x1, y1],
        cx: (x0 + x1) / 2,
        cy: (y0 + y1) / 2
      };
    } else if (typeof w === "object") {
      const b = w.bbox || [w.x0, w.y0, w.x1, w.y1] || [0,0,0,0];
      return {
        id: w.id !== undefined ? w.id : idx,
        texto: String(w.text || w.texto || ""),
        bbox: b,
        cx: (b[0] + b[2]) / 2,
        cy: (b[1] + b[3]) / 2
      };
    }
    return null;
  }).filter(Boolean);
}

function calcularPalavrasCobertas(boxBbox, palavrasNorm) {
  if (!palavrasNorm || palavrasNorm.length === 0) return [];
  const [bx0, by0, bx1, by1] = normalizarBbox(boxBbox);
  const ids = [];
  palavrasNorm.forEach(p => {
    if (p.cx >= bx0 - 1.0 && p.cx <= bx1 + 1.0 &&
        p.cy >= by0 - 1.0 && p.cy <= by1 + 1.0) {
      ids.push(p.id);
    }
  });
