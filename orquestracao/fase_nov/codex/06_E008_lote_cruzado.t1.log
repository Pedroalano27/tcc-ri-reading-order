+            tarefas.append(t)
+    gravar(OUT / "tarefas.jsonl", "".join(json.dumps(t, ensure_ascii=False, allow_nan=False) + "\n" for t in tarefas))
+    gravar(OUT / "blocos.json", {"semente": SEMENTE, "embaralhar_no_anotador": False,
+                                 "intervalo_minimo_dias": 7, "blocos": defs})
+    return tarefas
+
