+def validar_navegador(tarefas, node):
+    """Abre o HTML original em Chrome headless usando CDP local do Node."""
+    candidatos = [Path(os.environ.get("PROGRAMFILES", "C:/Program Files")) / "Google/Chrome/Application/chrome.exe",
