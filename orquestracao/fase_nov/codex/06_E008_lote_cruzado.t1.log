+        fp = digest([VERSAO, self.receita, self.hash_pdf(self.raw[k]), numero, 80])
+        if destino.exists():
+            obj = ler(destino)
+            exigir(obj["fingerprint"] == fp, f"Cache divergente: {pid}")
+            return obj
+        with self.pdf_aberto(k) as doc:
