+      await dormir(100);
+    }
+    if (!porta) throw Error('Chrome nao publicou a porta CDP');
+    let alvo;
+    for (let i=0;i<100;i++) {
+      const abas = await (await fetch('http://127.0.0.1:'+porta+'/json/list')).json();
