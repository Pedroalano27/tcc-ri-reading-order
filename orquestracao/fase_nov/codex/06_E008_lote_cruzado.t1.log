+    obj = {"playwright_selenium": disponibilidade, "navegador_headless": False,
+           "metodo": "Leitura do contrato + conversor original executado em Node/vm; JPEGs verificados com PIL",
+           "html_sha256": sha(HTML), "paginas": rows,
+           "limite": "Nao verifica DOM, carregamento visual, cronometro ou interacoes. Cobertura geometrica do anotador nao substitui IDs canonicos."}
+    gravar(OUT / "cache/validacao_anotador.json", obj)
+    return obj
