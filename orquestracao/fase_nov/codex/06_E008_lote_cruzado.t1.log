+        ls.append(f"| {bi} | {'A→B' if bi==1 else 'B→A'} | {c['1']} | {c['2']} | {c['3+']} | {sum(t['e008']['tabela_ls3'] for t in ps)} |")
+    ls += ["", "| Veículo | PDFs | Páginas | 1 coluna | 2 colunas | 3+ colunas | Tabela ls3 |", "|---|---:|---:|---:|---:|---:|---:|"]
