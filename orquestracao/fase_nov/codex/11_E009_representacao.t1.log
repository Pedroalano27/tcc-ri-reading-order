+    CEGAS = set(ler(lock)["page_id"]) if lock.exists() else set()
+    paths = [*b.DEP_PATHS, e.JSON, RAIZ / "models/terceiros/layoutreader/model.safetensors",
+             RAIZ / "models/terceiros/layoutreader/config.json"]
