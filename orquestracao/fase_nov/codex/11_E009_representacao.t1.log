+        linhas += ["", "| Contraste | Métrica | Δ [IC95 veículo] | Wilcoxon veículo p | Melhor/igual/pior |", "|---|---|---:|---:|---:|"]
+        for nome in ("B-A_regra", "B-A_hibrido67", "A_regra-B_regra", "A_hibrido67-B_regra", "B_hibrido67-B_regra", "A_hibrido67-A_regra"):
