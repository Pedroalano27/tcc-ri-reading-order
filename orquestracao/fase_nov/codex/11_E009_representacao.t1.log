+            "lacre_sha256": LACRE, "paginas_cegas_bloqueadas": len(CEGAS),
+            "device": "cpu", "threads": 4, "num_workers": 0, "processos_pesados": 1,
+            "inferencia_detector_cpu": 0, "inferencia_detector_gpu": 0,
+            "parametros_ajustados": 0, "limiar_hibrido": 67,
