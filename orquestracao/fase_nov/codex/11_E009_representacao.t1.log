+
+def predicoes_B():
+    out = {}
+    for coorte in COORTES:
+        path = b.OUT / "pred" / f"layoutreader_pronto__linhas__{coorte}.jsonl"
+        if path.exists():
+            for r in registros(path):
+                out[(coorte, r["page_id"])] = r["ordem"]
+    return out
