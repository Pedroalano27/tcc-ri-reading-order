+    exigir(lr is not None, "Falta LayoutReader congelado para comparador hibrido")
+    ordens = {"regra": ctx["ordem"], "hibrido67": lr if len(ctx["cs"]) <= 67 else ctx["ordem"],
+              GRAFO: gr["ordem"], **vv}
+    for nome in nomes:
+        if nome.startswith("hibrido67_"):
+            base = nome.removeprefix("hibrido67_")
+            ordens[nome] = lr if len(ctx["cs"]) <= 67 else vv[base]
+    resultados, corpos, iguais = {}, {}, {}
