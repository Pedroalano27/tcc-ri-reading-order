+                    "igual": sum(abs(d) <= 1e-12 for d in ds),
+                    "pior": sum(sinal*d < -1e-12 for d in ds)}
+            res["contrastes"][base] = testes
+            res["pares_sucessor"][base] = {tipo: {k: sum(r["pares_sucessor"][nome][base][tipo][k] for r in rr)
