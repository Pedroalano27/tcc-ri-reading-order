+
+def publicar(an, man, diag, dados, escolha, situacao, completo=False):
+    estado = {"ancora": an, "manifesto": man, "diagnostico": diag, "escolha": escolha,
+              "situacao": situacao, "completo": completo, "memoria": g.medir_memoria(),
