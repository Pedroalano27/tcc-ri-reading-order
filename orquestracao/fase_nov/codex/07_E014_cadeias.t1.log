    for part in ("treino", "validacao", "teste"):
        for uf in splits[part]:
            for pasta in (("linhas", "linhas_extra") if part == "treino" else ("linhas",)):
                for suf in (".jsonl", ".palavras.jsonl"):
                    path = b.UNIDADES / pasta / (uf+suf)
                    if path.exists():
                        paths.add(path)
