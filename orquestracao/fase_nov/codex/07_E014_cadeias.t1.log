+            registro[co+"/"+met] = {"tau": mm["tau"], "quebras": mm["quebras"], "sucessor": mm["sucessor_linhas"]}
+        linhas += ["", "### Diferenças pareadas", "", "| Método | Base | Métrica | Δ [IC95 por veículo] | p veículo | Melhor/igual/pior |",
+                   "|---|---|---|---:|---:|---:|"]
+        for met, r in resumo.items():
