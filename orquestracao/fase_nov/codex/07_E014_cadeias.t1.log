+        linhas += ["", "### Δ por veículo da variante congelada (e combinação exploratória)", "",
+                   "| Método | Base | Veículo | Δ quebras | Δτ |", "|---|---|---|---:|---:|"]
+        for met in (nome, "hibrido67_"+nome if nome else None):
