+        linhas += ["", "### Reparos/regressões de sucessores da variante contra os três controles", "",
+                   "| Método | Base | Classe | Reparos | Regressões |", "|---|---|---|---:|---:|"]
+        for met in (nome, "hibrido67_"+nome if nome else None):
