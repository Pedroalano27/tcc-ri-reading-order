+                gravar(EXEC / ("ordem_"+co+".json"), [r["page_id"] for r in dados[co]])
+            escolha = selecionar(dados)
+            if escolha["metodo"]:
+                exploratoria = "hibrido67_"+escolha["metodo"]
+                for co in o.DESENV:
