+        for met, r in resumo.items():
+            for tipo, cc in r["classes"].items():
+                linhas.append(f"| {met} | {tipo} | {cc['ouro']} | {cc['certos']} | {cc['reparos']} | {cc['regressoes']} | {cc['quebras']} |")
