+         "delta_tau": r["resultados"]["b_mediana"]["metricas"]["tau"]-r["resultados"]["regra"]["metricas"]["tau"],
+         "delta_quebras": r["resultados"]["b_mediana"]["metricas"]["quebras"]-r["resultados"]["regra"]["metricas"]["quebras"]}
