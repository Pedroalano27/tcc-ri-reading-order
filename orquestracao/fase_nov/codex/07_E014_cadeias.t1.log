+        cnt = lambda k: "/".join(str(sum(r[k][v] for r in rs)) for v in ("palavras", "linhas", "unidades"))
+        ls.append(f"| {co} | {soma('inversoes_internas_grafo')}/{soma('inversoes_internas_regra')} | "
