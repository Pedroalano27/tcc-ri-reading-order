+            trechos = "; ".join(f"`{x['id']}` ({', '.join(x['linhas_ouro'][:3])}): “{x['texto'].replace(chr(10),' ')}”" for x in d["trechos"])
+            ls.append(f"  - {desc}, {d['palavras']} palavras, {d['inversoes_internas']} inversões: {trechos}.")
