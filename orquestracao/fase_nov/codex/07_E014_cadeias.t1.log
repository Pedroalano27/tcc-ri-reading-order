+        res["quebras_mil_micro"] = 1000*sum(r["resultados"][nome]["metricas"]["quebras"] for r in rs)/sum(r["resultados"][nome]["palavras"] for r in rs)
+        for base in ("regra", "hibrido67", GRAFO):
