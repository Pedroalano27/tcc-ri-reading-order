+
+def inversoes(seq, gt):
+    """Contagem derivada do tau oficial, sem implementar outra metrica."""
+    if len(seq) < 2:
+        return 0
+    exigir(set(seq) == set(gt), "Subsequencias nao pareadas")
+    return round((1 - e.o.kendall_tau(seq, gt)) * math.comb(len(seq), 2) / 2)
+
