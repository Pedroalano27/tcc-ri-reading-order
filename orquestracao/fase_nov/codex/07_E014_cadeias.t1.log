 },
 "validacao_silver/c_local": {
  "tau": 0.6906456711713361,
  "quebras": 9.466666666666667,
  "sucessor": 0.9478878088097553
 },
 "validacao_silver/d_local_margens": {
  "tau": 0.6903277031674595,
  "quebras": 10.933333333333334,
