+           "segundos": time.perf_counter()-t0}
+    gravar(path, row)
+    return row
+
+
+def avaliar_coorte(co, nomes):
+    salvos = g.predicoes_salvas(co)
+    rows = []
+    for obj, p in o.paginas(co):
