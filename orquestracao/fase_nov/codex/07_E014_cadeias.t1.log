+def cadeias(regra, saida):
+    entradas = {v for v in saida.values() if v is not None}
+    exigir(len(entradas) == sum(v is not None for v in saida.values()), "Entrada duplicada")
+    out, vistos = [], set()
+    for uid in regra:
+        if uid in entradas:
+            continue
+        atual, u = [], uid
+        while u is not None:
+            exigir(u not in vistos, "Ciclo nas cadeias")
+            atual.append(u)
+            vistos.add(u)
+            u = saida.get(u)
+        out.append(atual)
