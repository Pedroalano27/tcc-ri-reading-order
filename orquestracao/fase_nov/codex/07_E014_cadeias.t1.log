+        cont = {k: sum(r["corretas_contiguas_fora"][k] for r in rs) for k in ("cadeias", "palavras", "linhas")}
+        ls.append(f"\n{co}: subconjunto de cadeias também contíguas fora de ordem: {cont}.\n")
