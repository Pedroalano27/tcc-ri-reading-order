+                registros[chave] = {"tau": s["metricas"]["tau"] if disponivel else None,
+                    "quebras": s["metricas"]["quebras"] if disponivel else None,
+                    "sucessor": s["metricas"]["sucessor_linhas"] if disponivel else None}
+    primario = modos["cv_conjunta"]
