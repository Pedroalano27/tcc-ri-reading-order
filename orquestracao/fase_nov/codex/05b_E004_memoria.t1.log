        if isinstance(x, str) and ("#p" in x or x.lower().endswith(".pdf")):
            ids.add(x)
        elif isinstance(x, dict):
            for k, v in x.items():
                if "#p" in k or k.lower().endswith(".pdf"):
                    ids.add(k)
                visitar(v)
        elif isinstance(x, list):
            for v in x:
                visitar(v)
