+        antigas = {co: {nome: {r["page_id"]: r["metricas"] for r in
+                   historico.get(arquivo+"__linhas__"+co, {}).get("paginas", [])}
+                   for nome, arquivo in (("regra", "regra_colunas"),
+                                         ("layoutreader_pronto", "layoutreader_pronto"))}
+                   for co in COORTES}
+        del historico
