+def ler_lote(path, item, dtype=None):
+    """Copia somente o lote e fecha o mmap para nao acumular paginas em RSS."""
+    a = np.load(path, mmap_mode="r", allow_pickle=False)
+    try:
+        return np.array(a[item], dtype=dtype, copy=True)
+    finally:
+        a._mmap.close()
