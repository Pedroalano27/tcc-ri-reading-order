+                sl = slice(lo, min(mat["n"], lo+lote))
+                X, y = ler_lote(mat["X"], sl), ler_lote(mat["y"], sl)
+                fixos += int(obrigatorios(X, y).sum())
+                positivos += int(y.sum())
+            contagens[uf] = {"originais": mat["n"], "obrigatorios": fixos, "positivos": positivos,
