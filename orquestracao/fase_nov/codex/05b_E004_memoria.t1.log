+        contagens = {}
+        for uf, mat in sorted(mats.items()):
+            fixos = positivos = 0
+            for lo in range(0, mat["n"], lote):
+                vigiar()
+                sl = slice(lo, min(mat["n"], lo+lote))
+                X, y = ler_lote(mat["X"], sl), ler_lote(mat["y"], sl)
+                fixos += int(obrigatorios(X, y).sum())
+                positivos += int(y.sum())
