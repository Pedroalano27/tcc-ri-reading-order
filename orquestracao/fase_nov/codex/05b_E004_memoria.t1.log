+            partes.append(np.flatnonzero(manter).astype(np.int32)+lo)
+            faltam -= quantidade
+            populacao -= m
+        indices = np.concatenate(partes)
+        n = len(indices)
+        xp = EXEC / "matrizes_amostradas" / (uf+"_X.npy")
+        yp = xp.with_name(uf+"_y.npy")
+        mp = xp.with_suffix(".json")
