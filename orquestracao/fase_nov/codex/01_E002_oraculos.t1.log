+    def medir(nome, ordem):
+        chave = tuple(ordem)
+        if chave not in medidas_seq:
+            medidas_seq[chave] = avaliar_ordem(obj, p, ctx, ordem, trs, q)
+        rows[nome] = medidas_seq[chave]
