+    teto = criterio(escolhido)[0]
+    reducao = 1-teto/base
+    return {"metodo": escolhido, "regra": base, "teto": teto, "reducao": reducao,
+            "decisao": "GO" if reducao >= .2 else "NO-GO", "agregacao": "peso igual por bancada v4/RN"}
+
+
