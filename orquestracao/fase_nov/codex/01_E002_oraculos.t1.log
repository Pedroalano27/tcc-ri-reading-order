+def f(v, n=3):
+    return "indisponível" if v is None else f"{v:.{n}f}".replace(".", ",")
+
+
+def ic(v, n=3):
+    return f"{f(v['media'], n)} [{f(v['ic'][0], n)}; {f(v['ic'][1], n)}]"
+
