+def processar(co, obj, p, cache, fingerprint, preds, antigas):
+    inicio = time.perf_counter()
+    ctx = c.contexto(p, obj["palavras"])
+    _, _, trs, _ = c.preparar_avaliacao(obj, p, ctx)
+    q = b.referencia(obj, p)
