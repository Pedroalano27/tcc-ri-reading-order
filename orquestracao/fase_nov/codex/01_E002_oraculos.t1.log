+                ls.append(f"| {k} | {c.ROTULOS[tipo]} | {s['presentes']}/{s['elegiveis']} | {f(ratio(s['presentes'], s['elegiveis']), 2)}% | {s['erros_presentes']}/{s['erros_elegiveis']} | {f(ratio(s['erros_presentes'], s['erros_elegiveis']), 2)}% | {s['internos']} | {s['inalcancaveis']} |")
