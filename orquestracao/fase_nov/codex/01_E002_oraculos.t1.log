+def carregar_salvos():
+    dados = b.ler(b.JSON)["resultados"]
+    preds, medidas = {}, {}
+    for co in COORTES:
+        preds[co], medidas[co] = {}, {}
+        for metodo in ("regra_colunas", "layoutreader_pronto", "regra_reordena"):
+            path = b.OUT / "pred" / f"{metodo}__linhas__{co}.jsonl"
+            if path.exists():
