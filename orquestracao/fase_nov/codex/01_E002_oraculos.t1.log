    "src/eval/metrics.py", "src/eval/baselines.py", "src/eval/politica_margens.py",
    "src/eval/protocolo.py", "orquestracao/analises/ordem_layoutreader.py")]


    """Constroi o contexto do avaliador; nenhuma referencia entra no preditor."""
    ws, gt = obj["palavras"], obj["gt_w"]
    exigir(len(gt) == len(set(gt)) and gt and set(gt) <= set(range(len(ws))), "Referencia de palavras invalida")
    h = statistics.median(w[4] - w[2] for w in ws)
    q = {"ws": ws, "gt_w": gt, "h": h,
         "p": {"page_id": p["page_id"], "dimensions": p["dimensions"]}}
    if "gold_lines" in obj:
        q.update({k: obj[k] for k in ("gold_lines", "gt_l", "reg_words", "gt_r")})
    else:
        # Silver: a referencia de PALAVRAS e o fluxo PDF. Linhas geometricas
        # sao divididas em trechos contiguos desse fluxo; nunca o reordenam.
        ls = e.o.linhas_partidas(ws, list(range(len(ws))), e.FIXA.gap, h)
        dono = {k: i for i, L in enumerate(ls) for k in L["ks"]}
        grupos = [list(g) for _, g in itertools.groupby(gt, key=dono.__getitem__)]
        gl = [{"id": f"silver:l{i}", "ks": ks} for i, ks in enumerate(grupos)]
        q.update(gold_lines=gl, gt_l=[L["id"] for L in gl],
                 reg_words={"silver": gt}, gt_r=["silver"])
    return q


def paginas(bancada, rep):
    """Le somente uma pagina com palavras, nunca o corpus todo."""
    if bancada != "teste_silver":
        for obj in jsonl(UNIDADES / "bancadas" / (bancada + ".jsonl")):
            exigir(obj["particao"] == bancada, "Particao humana divergente")
            yield obj, obj["representacoes"][rep]
        return
    splits = ler(RAIZ / "data/processed/splits.json")
    for uf in splits["teste"]:
        pp = UNIDADES / rep / (uf + ".jsonl")
        wp = UNIDADES / rep / (uf + ".palavras.jsonl")
        for p, obj in itertools.zip_longest(jsonl(pp), jsonl(wp)):
            exigir(p is not None and obj is not None and p["page_id"] == obj["page_id"],
                   f"Shards de palavras/unidades divergentes: {pp}")
            exigir(p["uf"] == uf and p["particao"] == "teste", "Veiculo/split de teste divergente")
            exigir(obj["referencia_palavras_tipo"] == "fluxo_pdf_por_palavra", "Silver diferente do fluxo PDF")
            exigir(obj["gt_w"] == list(range(len(obj["palavras"]))), "Silver nao preserva indices do fluxo")
            yield {**obj, "uf": uf, "particao": "teste_silver"}, p


def auditar_unidades(p, obj):
    us = p["bounding_boxes"]
    ids = [u["id"] for u in us]
    exigir(len(ids) == len(set(ids)) and ids, "IDs vazios/repetidos")
    exigir(sorted(k for u in us for k in u["ks"]) == list(range(len(obj["palavras"]))),
           f"Palavras perdidas/repetidas: {p['page_id']}")
    for u in us:
        b = u["bbox"]
        exigir(len(b) == 4 and all(math.isfinite(x) for x in b) and b[2] >= b[0] and b[3] >= b[1], "bbox invalida")
    return ids


def fontes():
    """Somente teto consulta ordens/ranks. Os demais recebem campos automaticos."""
    cs = [{k: u[k] for k in ("id", "bbox", "ks", "text", "tipo")} for u in p["bounding_boxes"]]
    auto = {"page_id": p["page_id"], "dimensions": p["dimensions"], "bounding_boxes": cs}
    ent = ordem_entrada(auto)
    ids = [u["id"] for u in cs]
    diag = {"unidades": len(cs), "entrada": [ids[i] for i in ent]}
    t = time.perf_counter()
    if metodo == "teto":
        ordem = list(p["ordens"]["stream"])
    elif metodo == "ingenuo":
        ordem = [ids[i] for i in sorted(ent, key=lambda i: (cs[i]["bbox"][1], cs[i]["bbox"][0]))]
    elif metodo == "xycut":
        ordem = [ids[i] for i in xycut(ent, caixas(auto))]
    elif metodo == "xycut_margens":
        ordem = xycut_margens(auto)
    elif metodo == "regra_colunas":
        h = statistics.median(w[4] - w[2] for w in ws)
        ini, corpo, marcas, fim = e.j.particao(cs, ws, p["dimensions"]["height"], "geo")
        corpo_set = set(corpo)
        diag.update(max_colunas=1, pontes=0, topo=len(ini), rodape=len(fim), marcas=len(marcas))
        oc = e.o.ordenar_projecao(cs, [i for i in ent if i in corpo_set], h, e.FIXA.vale, diag, local=True)
        chave = lambda i: (cs[i]["bbox"][1], cs[i]["bbox"][0], i)
        ordem = [ids[i] for i in sorted(ini, key=chave) + oc + sorted(marcas, key=chave) + sorted(fim, key=chave)]
    elif metodo == "layoutreader_pronto":
        exigir(lr is not None, "LayoutReader nao carregado")
        # direto() do adaptador embaralha a lista canonica com entrada-page_id.
        # Evita duas permutacoes: esta chamada deve receber indices canonicos.
        ordem_i = lr.ordenar(cs, list(range(len(cs))), p["dimensions"]["width"],
                            p["dimensions"]["height"], statistics.median(w[4]-w[2] for w in ws),
                            e.FIXA.vale, p["page_id"], diag)
        ordem = [ids[i] for i in ordem_i]
    else:
        raise ValueError(f"Ordenador desconhecido: {metodo}")
    exigir(len(ordem) == len(ids) and set(ordem) == set(ids), "Predicao nao e permutacao completa")
    diag["tempo_ms"] = 1000*(time.perf_counter()-t)
    return ordem, diag


@lru_cache(maxsize=1)
def assinatura_metricas():
    return digest([sha(p) for p in DEP_PATHS])


def expansoes(obj, p, canonica=True):
    """A ordem dentro da unidade independe do ordenador; nao altera a fonte."""
    return {u["id"]: e.o.fluxo([u], obj["palavras"]) if canonica else list(u["ks"])
            for u in p["bounding_boxes"]}


def diagnosticar_internas(obj, p):
    """Localiza divergencias de ks, incluindo linhas lado a lado nas faixas."""
    ws, gt = obj["palavras"], obj["gt_w"]
    h = statistics.median(w[4]-w[2] for w in ws)
    detalhes = []
    for u in p["bounding_boxes"]:
        can = e.o.fluxo([u], ws)
        if can == u["ks"]:
            continue
        ls = e.o.linhas(ws, u["ks"])
        lado = sum(any(ws[b][1]-ws[a][3] > max(4., e.FIXA.gap*h)
                       for a, b in zip(L["ks"], L["ks"][1:])) for L in ls)
        detalhes.append({"id": u["id"], "tipo": u["tipo"], "bbox": u["bbox"],
                         "palavras": len(can), "linhas": len(ls), "linhas_lado_a_lado": lado,
                         "piso_ks_cru": len(e.eventos(u["ks"], gt)),
                         "piso_canonico": len(e.eventos(can, gt)),
                         "primeiros_ks_crus": u["ks"][:16], "primeiros_ks_canonicos": can[:16]})
    return detalhes


def metricas(obj, p, ordem, *, canonica=True):
    ids = auditar_unidades(p, obj)
    exigir(isinstance(ordem, list) and len(ordem) == len(ids) and set(ordem) == set(ids),
           f"IDs da predicao nao pertencem a esta representacao: {p['page_id']}")
    mapa = {u["id"]: u for u in p["bounding_boxes"]}
    exp = expansoes(obj, p, canonica)
    seq = [k for uid in ordem for k in exp[uid]]
    q = referencia(obj, p)
    # Cache da regua independe do ordenador/representacao: mesma sequencia e
    # referencia implicam mesmas metricas. O piso depende das unidades.
    fp = digest([VERSAO, assinatura_metricas(), q, seq])
    cache = OUT / "cache/metricas" / (fp + ".json")
    if cache.exists():
        res = ler(cache)
    else:
        med = e.medir(q, seq, [], {}, "P0")
        res = {k: med[k] for k in METRICAS[:-1]}
        gravar(cache, res)
    # Mede transicoes dentro de CADA unidade com a mesma eventos(). Inclui
    # palavra livre interposta: tambem nao pode ser reparada reordenando IDs.
    res["piso_interno"] = sum(len(e.eventos(ks, q["gt_w"])) for ks in exp.values())
    exigir(res["piso_interno"] <= res["quebras"], "Piso excedeu quebras: expansao inconsistente")
    return res


def resumo(rows, R, rep, bancada, parcial=False):
    grupos = ("todos", "vistos", "nao_vistos") if bancada != "teste_silver" else ("todos",)
    saida = {}
    rep_base = "linhas" if rep == "caixas_finas" else rep
    base = R["resultados"].get(f"regra_colunas__{rep_base}__{bancada}", {})
    base_rows = {r["page_id"]: r for r in base.get("paginas", [])}
    for g in grupos:
        rs = [r for r in rows if g == "todos" or r["visto_treino"] == (g == "vistos")]
        if not rs:
            saida[g] = {"n": 0, "veiculos": 0, "metricas": {}, "contra_regra_colunas": {}}
            continue
        W = None if parcial else PESOS_CLUSTER(rs)
        ms = {}
        for k in METRICAS:
            v = [r["metricas"][k] for r in rs]
            vv = [x for x in v if x is not None]
            ms[k] = {"media": statistics.mean(vv) if vv else None, "n": len(vv), "ic": [None, None]} if parcial else e.media_ic(v, W)
            if k in ("quebras", "piso_interno"):
                ms[k]["total"] = sum(vv)
        # Contrastes por veiculo apenas em paginas pareadas, sem imputacao.
        testes = {}
        for k in METRICAS:
            pareadas = [r for r in rs if r["page_id"] in base_rows and r["metricas"][k] is not None and
                        base_rows[r["page_id"]]["metricas"][k] is not None]
            if parcial or not pareadas or not base.get("completa"):
                continue
            ds = [r["metricas"][k] - base_rows[r["page_id"]]["metricas"][k] for r in pareadas]
            veiculos = sorted({r["uf"] for r in pareadas})
            dvs = [statistics.mean(d for r, d in zip(pareadas, ds) if r["uf"] == uf) for uf in veiculos]
            testes[k] = {"delta": e.media_ic(ds, PESOS_CLUSTER(pareadas)),
                         "wilcoxon_veiculo": e.pratt(dvs), "n_pareadas": len(pareadas),
                         "n_veiculos": len(veiculos), "medias_diferencas_por_veiculo": dict(zip(veiculos, dvs))}
        saida[g] = {"n": len(rs), "veiculos": len({r["uf"] for r in rs}),
                    "metricas": ms, "contra_regra_colunas": testes,
                    "agrupadas_510": sum(bool(r.get("diag", {}).get("excesso_510")) for r in rs),
                    "hierarquia_510": sum(bool(r.get("diag", {}).get("hierarquia")) for r in rs)}
    return saida


def identidade(path, ordenador=None, representacao=None, bancada=None):
    """Regua importada integralmente; nenhuma escrita em caches da bancada."""
    ids = b.auditar_unidades(p, obj)
    exigir(isinstance(ordem, list) and len(ordem) == len(ids) and set(ordem) == set(ids), "Ordem invalida")
    exp = b.expansoes(obj, p)
    seq = [k for uid in ordem for k in exp[uid]]
    q = b.referencia(obj, p)
    med = e.medir(q, seq, [], {}, "P0")
    res = {k: med[k] for k in METRICAS if k != "piso_interno"}
    res["piso_interno"] = sum(len(e.eventos(ks, q["gt_w"])) for ks in exp.values())
    exigir(res["piso_interno"] <= res["quebras"], "Piso excede quebras")
    return res, seq, q, exp


def ancoras():
    """Texto normalizado pelo piloto, janelas integrais e controle tolerante 10/12."""
    ouro = ri.tokens(" ".join(ws[k][0] for k in gt))
    saida = ri.tokens(" ".join(ws[k][0] for k in seq))
    pos = ri.indice_posicoes(saida)
    res = {"tokens_ouro": len(ouro), "tokens_saida": len(saida)}
    for tam in (6, 12, 24):
        preservar = funcao_preservada(tam)
        intactas = 0
        for ini in range(max(0, len(ouro) - tam + 1)):
            frase = ouro[ini:ini + tam]
            # Toda coincidencia integral precisa alinhar o token mais raro.
            # Reduz candidatos, preservando a semantica da funcao do piloto.
            raro = min(range(tam), key=lambda k: len(pos.get(frase[k], ())))
            offsets = {i - raro for i in pos.get(frase[raro], ()) if 0 <= i - raro <= len(saida) - tam}
            restrito = {t: set() for t in set(frase)}
            for off in offsets:
                for k, t in enumerate(frase):
                    if saida[off+k] == t:
                        restrito[t].add(off+k)
            intactas += preservar(frase, saida, restrito)
        den = max(0, len(ouro) - tam + 1)
        res[f"fid{tam}"] = intactas / den if den else None
        res[f"janelas{tam}"] = den
        res[f"intactas{tam}"] = intactas
        # Conferencia independente: n-gramas lexicais, sem IDs ou tolerancia.
        janelas = {tuple(saida[i:i + tam]) for i in range(max(0, len(saida) - tam + 1))}
        esperado = sum(tuple(ouro[i:i + tam]) in janelas for i in range(den))
        if esperado != intactas:
            raise AssertionError("preservada() divergiu da janela integral")
    den = max(0, len(ouro) - 11)
    res["fid12_piloto_10de12"] = sum(ri.preservada(ouro[i:i + 12], saida, pos) for i in range(den)) / den if den else None
    return res


def eventos(seq, gt):
    """Quebra na transicao comparavel, incluindo palavras livres interpostas."""
    prox = dict(zip(gt, gt[1:]))
    ranks = {k: i for i, k in enumerate(seq)}
    gset, grank = set(gt), {k: i for i, k in enumerate(gt)}
    pw = [k for k in seq if k in gset]
    ev = []
    for a, b in zip(pw, pw[1:]):
        livre = ranks[b] != ranks[a] + 1
        if prox.get(a) != b or livre:
            ev.append({"a": a, "b": b, "esperado": prox.get(a), "livre": livre,
                       "pos_saida": ranks[a], "salto_ouro": grank[b] - grank[a]})
    return ev


def origem(ev, q, itens, metodo, previa=False):
    """Associacao operacional; nao transforma proximidade em prova causal."""
    gt = q["gt_w"]
    cobertos = set(gt)
    pw = [k for k in seq if k in cobertos]
    ev = eventos(seq, gt)
    ranks = {k: i for i, k in enumerate(seq)}
    linhas = {L["id"]: L["ks"] for L in q["gold_lines"]}
    intacta = {lid: all(ranks[b] == ranks[a] + 1 for a, b in zip(ks, ks[1:])) for lid, ks in linhas.items()}
    acertos = sum(intacta[a] and intacta[b] and ranks[linhas[b][0]] == ranks[linhas[a][-1]] + 1
                  for a, b in zip(q["gt_l"], q["gt_l"][1:]))
    dono = {k: r for r, ks in q["reg_words"].items() for k in ks}
    runs = ac.trechos(pw, dono)
    cont = collections.Counter(runs)
    ordem_primeira = list(dict.fromkeys(runs))
    gold_r = [r for r in q["gt_r"] if q["reg_words"][r]]
    grank = {r: i for i, r in enumerate(gold_r)}
    des = [abs(i - grank[r]) for i, r in enumerate(ordem_primeira)]
    res = {"tau": o.kendall_tau(pw, gt), "quebras": len(ev),
           "quebras_mil": len(ev) * 1000 / len(gt), "intercalacoes": sum(n-1 for n in cont.values()),
           "regioes_intercaladas": sum(n > 1 for n in cont.values()),
           "deslocados3": sum(d > N_DESLOCAMENTO for d in des), "deslocados5": sum(d > 5 for d in des),
           "sucessor_linhas": acertos / (len(q["gt_l"])-1) if len(q["gt_l"]) > 1 else None,
           "linhas_intactas": sum(intacta.values()), "linhas": len(linhas),
           "quebras_sem_livres": sum(not e["livre"] for e in ev),
           "quebras_projecao": len(eventos(pw, gt)), "diag": diag, "seq": seq, "items": itens,
           **fidelidade(seq, gt, q["ws"])}
    if metodo != "P0":
        res["origens"], res["eventos"] = origem(ev, q, itens, metodo)
        # Todos os pares internos ao mesmo item sobrevivem a qualquer reordenacao
        # dos itens atomicos. E um piso verificavel, nao uma escolha pelo ouro.
        res["piso_interno"] = sum(e["item_a"] == e["item_b"] and not e["livre"] for e in res["eventos"])
        if metodo in ("P1", "P1m"):
            res["origens_regra_previa"], _ = origem(eventos(pw, gt), q, itens, metodo, previa=True)
    return res


def pesos_cluster(rows):
    grupos = sorted({r["uf"] for r in rows})
    gi = np.array([grupos.index(r["uf"]) for r in rows])
    rng = np.random.default_rng(SEMENTE)
    amostra = rng.integers(0, len(grupos), (NBOOT, len(grupos)))
    count = np.zeros((NBOOT, len(grupos)), dtype=int)
    for i, draw in enumerate(amostra):
        count[i] = np.bincount(draw, minlength=len(grupos))
    return count[:, gi].astype(float)


def media_ic(v, W):
    vals = np.array([np.nan if x is None else x for x in v], dtype=float)
    mask = np.isfinite(vals)
    if not mask.any():
        return {"media": None, "ic": [None, None], "n": 0}
    den = W[:, mask].sum(axis=1)
    b = W[:, mask] @ vals[mask] / np.where(den == 0, np.nan, den)
    b = b[np.isfinite(b)]
    return {"media": float(vals[mask].mean()), "ic": np.percentile(b, [2.5, 97.5]).tolist(), "n": int(mask.sum())}


def pratt(v):
    arr = np.round(np.asarray(v, dtype=float), 12)
    if not len(arr) or np.all(arr == 0):
        return {"W": 0., "p": 1.}
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        t = wilcoxon(arr, zero_method="pratt", alternative="two-sided", method="approx")
    return {"W": float(t.statistic), "p": float(t.pvalue)}


def resumir(rows):
    W = pesos_cluster(rows)
    out = {"n": len(rows), "veiculos": len({r["uf"] for r in rows}), "metodos": {}, "testes": {}}
    for m in METODOS:
        met = {k: media_ic([r["metodos"][m][k] for r in rows], W) for k in METRICAS}
        for k in ("quebras", "intercalacoes", "deslocados3", "deslocados5"):
            met[k]["total"] = sum(r["metodos"][m][k] for r in rows)
        origem_total = collections.Counter()
        anterior = collections.Counter()
        for r in rows:
            origem_total.update(r["metodos"][m].get("origens", {}))
            anterior.update(r["metodos"][m].get("origens_regra_previa", {}))
        met.update(origens=dict(origem_total), origens_regra_previa=dict(anterior))
        if m != "P0":
            met["piso_interno"] = sum(r["metodos"][m]["piso_interno"] for r in rows)
        met["fracao_caixas"] = sum(origem_total[k] for k in SEGMENTACAO) / met["quebras"]["total"] if met["quebras"]["total"] else 0
        if m in ("P1", "P1m"):
            numer = [sum(r["metodos"][m]["origens"].get(k, 0) for k in SEGMENTACAO) for r in rows]
            denom = [r["metodos"][m]["quebras"] for r in rows]
            n, d = W @ np.array(numer), W @ np.array(denom)
            vals = n[d > 0] / d[d > 0]
            met["fracao_caixas_ic"] = np.percentile(vals, [2.5, 97.5]).tolist()
        out["metodos"][m] = met
    for base in ("P1", "P1m"):
        for k in METRICAS:
            inds = [i for i, r in enumerate(rows) if r["metodos"]["P2"][k] is not None and r["metodos"][base][k] is not None]
            d = [rows[i]["metodos"]["P2"][k] - rows[i]["metodos"][base][k] for i in inds]
            group_d = [statistics.mean(d[z] for z, i in enumerate(inds) if rows[i]["uf"] == uf)
                       for uf in sorted({rows[i]["uf"] for i in inds})]
            sentido = -1 if k in ("quebras", "quebras_mil", "intercalacoes", "deslocados3", "deslocados5") else 1
            t = {**media_ic(d, W[:, inds]), "pagina": pratt(d), "veiculo": pratt(group_d),
                 "ganha": sum(x*sentido > 1e-12 for x in d), "empata": sum(abs(x) <= 1e-12 for x in d),
                 "perde": sum(x*sentido < -1e-12 for x in d)}
            out["testes"][f"P2-{base}/{k}"] = t
    # Holm por coorte, cobrindo todos os contrastes/metrica em ambas as unidades.
    for unidade in ("pagina", "veiculo"):
        pares = sorted((t[unidade]["p"], chave) for chave, t in out["testes"].items())
        anterior = 0.
        for i, (p, chave) in enumerate(pares):
            anterior = max(anterior, min(1., p * (len(pares)-i)))
            out["testes"][chave][unidade]["holm"] = anterior
    return out


def auditar_previa(qs):
"""Seletor simples entre a regra de colunas e o LayoutReader pronto, pela densidade da página.

Motivo (resultados/ordenadores_ganha_perde.md, seção C): em `linhas`, o LayoutReader pré-treinado erra
menos que a regra nas páginas com poucas unidades e desaba nas densas. Aqui o limiar de unidades é
escolhido SÓ no golden_v4 (desenvolvimento) e medido no golden_v3 novo e no teste silver.
Não roda modelo: usa as medições por página de resultados/ordenadores_sem_caixas.json.
Uso: venv/Scripts/python.exe -B orquestracao/analises/hibrido_regra_layoutreader.py
"""
import json
import random
from pathlib import Path

RAIZ = Path(__file__).resolve().parents[2]
BANCADAS = ("golden_v4", "golden_v3_novo", "teste_silver")


def br(x, casas=2):
    return f"{x:.{casas}f}".replace(".", ",")


def main():
    d = json.loads((RAIZ / "resultados/ordenadores_sem_caixas.json").read_text(encoding="utf-8"))["resultados"]

    def paginas(ordenador, bancada):
        return {p["page_id"]: p for p in d[f"{ordenador}__linhas__{bancada}"]["paginas"]}
    dados = {b: (paginas("regra_colunas", b), paginas("layoutreader_pronto", b)) for b in BANCADAS}

    def medir(bancada, limiar):
        regra, lr = dados[bancada]
        linhas = []
        for pid, pr in regra.items():
            escolhido = lr[pid] if pr["unidades"] <= limiar else pr
            linhas.append((pr["uf"], escolhido["metricas"], pr["metricas"], lr[pid]["metricas"]))
        return linhas

    def media(linhas, i, chave):
        return sum(x[i][chave] for x in linhas) / len(linhas)

    candidatos = sorted({p["unidades"] for p in dados["golden_v4"][0].values()})
    melhor = min(candidatos, key=lambda t: (media(medir("golden_v4", t), 1, "quebras"), t))

    def ic(linhas, chave, n=5000):
        # bootstrap agrupado por veículo da diferença híbrido - regra
        por_uf = {}
        for uf, h, r, _ in linhas:
            por_uf.setdefault(uf, []).append(h[chave] - r[chave])
        ufs = sorted(por_uf)
        rng = random.Random(20261005)
        difs = []
        for _ in range(n):
            am = [v for u in (rng.choice(ufs) for _ in ufs) for v in por_uf[u]]
            difs.append(sum(am) / len(am))
        difs.sort()
        return difs[int(.025 * n)], difs[int(.975 * n)]

    out = ["# Híbrido por densidade: LayoutReader pronto nas páginas leves, regra de colunas nas densas", "",
           "Gerado por `orquestracao/analises/hibrido_regra_layoutreader.py` a partir das medições por página de",
           "`resultados/ordenadores_sem_caixas.json` (representação `linhas`). Nenhum modelo foi rodado de novo.", "",
           f"Limiar escolhido **só no golden_v4**: usar o LayoutReader quando a página tem até **{melhor} unidades**",
           "(linhas, tabelas e imagens); acima disso, a regra de colunas. O golden_v3 novo e o teste silver não",
           "participaram da escolha.", "",
           "| Bancada | n | Páginas no LayoutReader | Regra: τ / quebras | LayoutReader: τ / quebras | Híbrido: τ / quebras | Δ quebras híbrido − regra [IC 95% por veículo] | Híbrido melhor / igual / pior |",
           "|---|---:|---:|---:|---:|---:|---:|---:|"]
    for b in BANCADAS:
        L = medir(b, melhor)
        n_lr = sum(p["unidades"] <= melhor for p in dados[b][0].values())
        lo, hi = ic(L, "quebras")
        g = sum(h["quebras"] < r["quebras"] for _, h, r, _ in L)
        e = sum(h["quebras"] == r["quebras"] for _, h, r, _ in L)
        dif = media(L, 1, "quebras") - media(L, 2, "quebras")
        out.append(f"| {b} | {len(L)} | {n_lr} | {br(media(L, 2, 'tau'), 3)} / {br(media(L, 2, 'quebras'))} | "
                   f"{br(media(L, 3, 'tau'), 3)} / {br(media(L, 3, 'quebras'))} | "
                   f"{br(media(L, 1, 'tau'), 3)} / {br(media(L, 1, 'quebras'))} | "
                   f"{br(dif)} [{br(lo)}; {br(hi)}] | {g} / {e} / {len(L) - g - e} |")
    out += ["", "Sensibilidade do limiar no golden_v4 (quebras por página do híbrido):", "",
            "| Limiar (unidades) | " + " | ".join(str(t) for t in candidatos[::4]) + " |",
            "|---|" + "---:|" * len(candidatos[::4]),
            "| Quebras | " + " | ".join(br(media(medir("golden_v4", t), 1, "quebras")) for t in candidatos[::4]) + " |", "",
            "Limitações: o limiar foi escolhido nas mesmas 44 páginas em que a regra de colunas foi desenvolvida;",
            "o golden_v3 novo tem 27 páginas; no teste silver a referência é o fluxo do PDF e o piso de quebras é",
            "alto por causa da ordem dentro das tabelas. É uma pista para testar, não um método validado."]
    (RAIZ / "resultados/hibrido_regra_layoutreader.md").write_text("\n".join(out) + "\n", encoding="utf-8")
    print("\n".join(out[5:13]))


if __name__ == "__main__":
    main()
