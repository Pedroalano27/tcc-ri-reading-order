+
+def ler_lock():
+    if not LOCK.exists():
+        return None, set()
+    raw = LOCK.read_text(encoding="utf-8")
+    # Aceita JSON/JSONL ou lista textual de IDs; desconhecido implica parada.
+    ids = set(re.findall(r'[^\s"<>\[\]{},]+/[^"\r\n<>]*?\.pdf#p\d+', raw))
+    try:
+        obj = json.loads(raw)
+    except json.JSONDecodeError:
