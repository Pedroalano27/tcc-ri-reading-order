def fontes(splits):
    ps = set(b.DEP_PATHS) | {Path(__file__), RAIZ / "data/processed/splits.json",
                            e.JSON, UNIDADES / "treino_noite.json"}
    ps |= {UNIDADES / "bancadas" / (c + ".jsonl") for c in HUMANAS}
    # Tarefas, inclusive as nao concluidas: so le IDs, nunca as anotacoes.
    ps |= {RAIZ / "data/golden/golden_v4/tarefas.jsonl",
           RAIZ / "data/golden/_avaliacao/golden_v3/tarefas.jsonl"}
    for part in ("treino", "validacao", "teste"):
        for uf in splits[part]:
            pastas = ("linhas", "linhas_extra") if part == "treino" else ("linhas",)
            for pasta in pastas:
                for suf in (".jsonl", ".palavras.jsonl"):
                    p = UNIDADES / pasta / (uf + suf)
                    if pasta == "linhas_extra" and not p.exists():
                        continue
                    ps.add(p)
    for obj, p in b.paginas("golden_v4", "linhas"):
        ps.add(UNIDADES / "cache/detector" / (e.ac.chave(p["page_id"]) + ".json"))
    out = {}
    for p in sorted(ps):
        vigiar()
        exigir(p.is_file(), f"Fonte obrigatoria ausente: {p}")
        out[rel(p)] = sha(p)
    return out


def indice_shard(p):
    """Le apenas uma pagina de unidades por vez, guardando IDs e offsets."""
    out = {}
    with open(p, "rb") as f:
        while True:
            off = f.tell()
            linha = f.readline()
            if not linha:
                return out
            if not linha.strip():
                continue
            obj = json.loads(linha.decode("utf-8"))
            pid = obj["page_id"]
            exigir(pid not in out, f"Pagina duplicada no shard: {p}: {pid}")
            campos = ("page_id", "palavras", "gt_w", "referencia_palavras_tipo") if "palavras" in obj else (
                "page_id", "uf", "dimensions", "bounding_boxes", "ordens", "representacao", "referencia_palavras_tipo")
            conteudo = {k: obj[k] for k in campos if k in obj}
            out[pid] = {"offset": off, "assinatura": digest(obj), "conteudo": digest(conteudo), "uf": obj.get("uf"),
                        "particao": obj.get("particao")}


def inventario(splits, n_treino):
    humanos, ids_coortes = set(), {}
    for nome in ("data/golden/golden_v4/tarefas.jsonl", "data/golden/_avaliacao/golden_v3/tarefas.jsonl"):
        humanos.update(p["page_id"] for p in b.jsonl(RAIZ / nome))
    for c, n in zip(HUMANAS, (44, 27)):
        ids = [p["page_id"] for p in b.jsonl(UNIDADES / "bancadas" / (c + ".jsonl"))]
        exigir(len(ids) == n and len(set(ids)) == n, f"Bancada {c} incompleta/duplicada")
        ids_coortes[c] = ids
        humanos.update(ids)
    exigir(not set(ids_coortes[HUMANAS[0]]) & set(ids_coortes[HUMANAS[1]]), "Bancadas humanas sobrepostas")
    planos, excluidos, duplicatas = {}, {}, []
    for part in ("treino", "validacao", "teste"):
        regs, excl = {}, []
        for uf in splits[part]:
            for pasta in (("linhas", "linhas_extra") if part == "treino" else ("linhas",)):
                p = UNIDADES / pasta / (uf + ".jsonl")
                w = p.with_name(uf + ".palavras.jsonl")
                if not p.exists() and pasta == "linhas_extra":
                    exigir(not w.exists(), f"Shard de palavras sem unidades: {w}")
                    continue
                vigiar()
                exigir(p.exists() and w.exists(), f"Par de shards incompleto: {p}")
                ip, iw = indice_shard(p), indice_shard(w)
                exigir(set(ip) == set(iw), f"IDs de palavras/unidades divergentes: {p}")
                for pid, meta in ip.items():
                    exigir(meta["uf"] == uf and pid.split("/", 1)[0] == uf, "Veiculo divergente do shard")
                    permitido = ("treino", "treino_extra") if part == "treino" else (part,)
                    exigir(meta["particao"] in permitido, f"Particao divergente: {pid}")
                    if pid in humanos:
                        excl.append(pid)
                        continue
                    if pid in regs:
                        # Base/extra tem particao e procedencia distintas, mas
                        # precisa conter as mesmas unidades, palavras e ouro.
                        exigir(regs[pid]["conteudo"] == meta["conteudo"] and
                               regs[pid]["conteudo_palavras"] == iw[pid]["conteudo"],
                               f"Duplicata base/extra diferente: {pid}")
                        duplicatas.append(pid)
                        continue
                    regs[pid] = {**meta, "page_id": pid, "path": rel(p), "palavras_path": rel(w),
                                 "palavras_offset": iw[pid]["offset"],
                                 "assinatura_palavras": iw[pid]["assinatura"], "conteudo_palavras": iw[pid]["conteudo"]}
        planos[part] = list(regs.values())
        excluidos[part] = sorted(set(excl))
    # Amostra pequena distribuida entre veiculos; nao escolhe por eficacia.
    filas = {uf: sorted((m for m in planos["treino"] if m["uf"] == uf),
                        key=lambda m: digest([SEMENTE, m["page_id"]])) for uf in splits["treino"]}
    escolhidos = []
    for i in range(max((len(f) for f in filas.values()), default=0)):
    path = EXEC / "avaliacao" / co / (e.ac.chave(p["page_id"]) + ".json")
    salvo = ler(path)
    if salvo:
        exigir(salvo["pagina_sha256"] == c.digest([obj, p]), "Pagina do cache mudou")
        return salvo
    t0 = time.perf_counter()
    ctx, trs, q = g.preparar_pagina(obj, p)
    pid = p["page_id"]
    lr = salvos.get("layoutreader_pronto", {}).get(pid)
    exigir(len(ctx["cs"]) > 67 or lr is not None, "Hibrido incompleto: " + pid)
    inicial = ctx["ordem"] if len(ctx["cs"]) > 67 else lr
    ordens = {"regra": ctx["ordem"], "hibrido67": inicial}
    rr = salvos.get("regra_reordena", {}).get(pid)
    if co != "validacao_silver":
        exigir(rr is not None, "Reordenacao restrita ausente")
    if rr is not None:
        ordens["regra_reordena"] = rr
    # Teto diagnostico E002 previamente salvo, com inicio na regra (declarado).
    po = FONTE_ORACULO / co / (hashlib.sha256(pid.encode("utf-8")).hexdigest() + ".json")
    antigo = b.ler(po)
    exigir(antigo["page_id"] == pid and antigo["resultados"]["regra_colunas"]["ordem"] == ctx["ordem"],
           "Oraculo E002 pertence a outra pagina/representacao")
    ordens["oraculo_residual"] = antigo["resultados"]["oraculo_residual"]["ordem"]
    resultados, corpos, hits, por_ordem = {}, {}, {}, {}
    operacoes = {"oraculo_residual": antigo["operacoes"]}
    def medir(nm, ordem):
        exigir(len(ordem) == len(ctx["ordem"]) and set(ordem) == set(ctx["ordem"]), "Permutacao incompleta")
        chave = tuple(ordem)
        if chave not in por_ordem:
            med = o.avaliar_ordem(obj, p, ctx, ordem, trs, q)
            corpo = m.avaliar_corpo(q, ctx, ordem)
            seq = [k for u in ordem for k in ctx["exp"][u]]
            hit = o.lm.acertos(q, seq, trs, med["metricas"])
            por_ordem[chave] = med, corpo, hit
        resultados[nm], corpos[nm], hits[nm] = por_ordem[chave]
    for nm, ordem in ordens.items():
        medir(nm, ordem)
    for nm, fonte in (("regra", "regra_colunas"), ("oraculo_residual", "oraculo_residual"),
                      ("hibrido67", "hibrido67"), ("regra_reordena", "regra_reordena")):
        if nm in resultados and fonte in antigo["resultados"]:
            for k in o.METRICAS:
                exigir(abs(resultados[nm]["metricas"][k]-antigo["resultados"][fonte]["metricas"][k]) < 1e-11,
                       "Comparador divergiu do E002: " + nm + "/" + k)
    cand = o.candidatos(ctx)[32]
    escores = Escores(co, ctx)
    configs = [(lam, limite) for lam in LIMIARES for limite in LIMITES] if escolha is None else [
        (escolha["lambda"], escolha["M"])]
    for lam in dict.fromkeys(lam for lam, _ in configs):
        busca = buscar(co, ctx, inicial, cand, escores, lam, escolha["M"] if escolha else None)
        for _, limite in (cfg for cfg in configs if cfg[0] == lam):
            nm = nome(lam, limite) if escolha is None else CAND
            ordem, ops = prefixo(inicial, busca, limite)
            medir(nm, ordem)
            operacoes[nm] = ops
    reparos = {}
    for nm in resultados:
        reparos[nm] = {}
        for base in ("regra", "hibrido67", "regra_reordena"):
            if base in hits:
                reparos[nm][base] = {tipo: {
                    "reparos": sum(new and not old for tr, old, new in zip(trs, hits[base], hits[nm]) if tr["tipo"] == tipo),
                    "regressoes": sum(old and not new for tr, old, new in zip(trs, hits[base], hits[nm]) if tr["tipo"] == tipo)} for tipo in c.TIPOS}
    row = {"page_id": pid, "uf": obj["uf"], "pagina_sha256": c.digest([obj, p]),
           "unidades": len(ctx["cs"]), "palavras_ouro": len(q["gt_w"]), "resultados": resultados, "corpo": corpos,
           "pares_sucessor": reparos, "operacoes": operacoes, "segundos": time.perf_counter()-t0,
           "escores": {"pares": len(escores.valores), "fora_pool": sum(v not in escores.ranks[u] for u, v in escores.valores)}}
    gravar(path, row)
    return row


def coorte(co, args, escolha=None):
"""Mede qualquer ordenador sobre unidades sem caixas finas, sem alterar dados.

Ks define pertinencia; expande cada unidade por ordem_sem_bbox.fluxo() e
importa medir/eventos de erros_ponta_a_ponta. As ancoras P2 sao reexecutadas
em CPU com deteccoes congeladas; P1m vem do JSON historico, sem reextracao.
Paginas, predicoes e metricas persistem em fluxo; so LayoutReader e carregado.
O teto usa a ordem de referencia de unidades exportada (posto mediano): nao
e uma otimizacao combinatoria quando uma unidade atravessa a referencia.

Executar da raiz com venv/Scripts/python.exe -B e este caminho:
  --somente-ancoras
  --metodos teto ingenuo xycut xycut_margens regra_colunas
  --metodos layoutreader_pronto --max-minutos 30
  --avaliar-pred resultados/ordenadores_sem_caixas/pred/modelo__linhas__golden_v4.jsonl
  --conferir
O padrao executa os seis metodos nas tres representacoes e bancadas.
Saidas restritas a resultados/ordenadores_sem_caixas/** e seu .md/.json.
Nao usa GPU, rede, multiprocessing, treino, dados do Label Studio ou OCR.
"""
