+def verificar_id(raw):
+    m = re.search(r'"page_id"\s*:\s*("(?:[^"\\]|\\.)*")', raw)
+    exigir(m is not None, "Registro sem page_id")
+    pid = json.loads(m.group(1))
+    permitido(pid)
+    return pid
+
+
+def ler(path, pagina=False):
+    path = fonte(path)
+    raw = path.read_text(encoding="utf-8")
+    if pagina:
+        verificar_id(raw)
+    return json.loads(raw)
+
