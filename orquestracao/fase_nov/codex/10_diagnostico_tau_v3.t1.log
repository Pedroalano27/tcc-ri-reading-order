def avaliar_corpo(q, ctx, ordem):
    """Projecao diagnostica fixa pelo detector de margens da propria regra."""
    excluir = {k for u in ctx["margem"] for k in ctx["exp"][u]}
    gt = [k for k in q["gt_w"] if k not in excluir]
    if len(gt) < 2:
