+                      f"{len(top)} página(s) cobrem ≥80% da perda bruta")
+    return [f"1. Âncora reproduzida: golden_v4 τ {f(estado['ancora']['tau'])} e {f(estado['ancora']['quebras'])} quebras/página.",
