+    ls += tabela(["Método", "Base", "Página", "Δτ", "Δ quebras", "Perda bruta total Στ", "% acumulada",
+                  "Unidades", "Palavras total/ouro", "Maior unidade: palavras (%)", "Maior átomo", "Colunas"], tab)
+    ls += ["", "#### O que trocou de posição nessas páginas", "",
