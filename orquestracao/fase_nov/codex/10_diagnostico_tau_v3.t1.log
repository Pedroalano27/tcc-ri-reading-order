+    tmp = MD.with_suffix(".md.tmp")
+    with tmp.open("w", encoding="utf-8", newline="\n") as f0:
+        f0.write(texto)
+        f0.flush()
+        os.fsync(f0.fileno())
+    os.replace(tmp, MD)
+    return texto
