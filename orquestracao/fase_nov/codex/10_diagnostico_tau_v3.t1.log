+def permitido(pid):
+    pdf = pid.rsplit("#p", 1)[0]
+    exigir(pid not in PROTEGIDOS and pdf not in PROTEGIDOS,
+           "Pagina/PDF protegido pelo teste cego; abortando antes de desserializar")
