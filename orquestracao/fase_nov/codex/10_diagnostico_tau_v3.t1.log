+BASES = METODOS[:2]
+GRAFO = "grafo_K24_maxregret_t0.00"
+METRICAS = ("tau", "tau_unidades", "tau_linhas", "tau_unidades_mediana",
+            "quebras", "quebras_mil", "fid12", "sucessor_linhas")
+TAUS = METRICAS[:4]
+MARCADOR = "<!-- CACHE_DIAGNOSTICO_TAU_V3 "
+FONTES = {}
