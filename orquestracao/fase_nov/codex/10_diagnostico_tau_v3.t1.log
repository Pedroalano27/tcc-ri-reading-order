+            ls += tabela(["Unidade", "Tipo", "Palavras", "% página", "Coluna", "Posto base → método"], [
+                [u, r["tipos"][u], r["tamanhos"][u], f(100*r["tamanhos"][u]/r["palavras"],2),
+                 r["cols"][u], f"{bp[u]} → {np[u]}"] for u in moved])
+            ls += ["", "Maiores contribuições (até oito pares): " + "; ".join(
