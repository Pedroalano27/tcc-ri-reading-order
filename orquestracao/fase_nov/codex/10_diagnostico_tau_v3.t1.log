+def publicar(estado):
+    estado["fontes"] = dict(FONTES)
+    payload = base64.b64encode(zlib.compress(json.dumps(estado, ensure_ascii=False,
+                         separators=(",", ":"), allow_nan=False).encode("utf-8"), 9)).decode("ascii")
+    texto = relatorio(estado) + "\n" + MARCADOR + payload + " -->\n"
