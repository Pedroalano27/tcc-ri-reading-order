+def jsonl_seguro(path):
+    # Valida ID antes de desserializar palavras, unidades ou referencia.
+    with path.open(encoding="utf-8") as f:
+        for raw in f:
+            if raw.strip():
+                verificar_id(raw)
+                yield json.loads(raw)
+    fonte(path)
