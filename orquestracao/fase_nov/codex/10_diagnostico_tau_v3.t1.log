+def relatorio(estado):
+    dados = estado["dados"]
+    completo = all(len(dados.get(co, [])) == ESPERADO[co] for co in COORTES)
+    if not completo:
+        return "\n".join(["Diagnóstico em andamento; cache retomável no comentário final.",
