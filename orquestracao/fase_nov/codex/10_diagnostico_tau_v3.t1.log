+
+
+def fonte(path):
+    path = path.resolve()
+    exigir(path.is_relative_to(RAIZ) and not path.is_relative_to(RAIZ / "data"),
+           "Leitura fora do escopo de resultados/codigo: " + str(path))
+    valor = sha(path)
