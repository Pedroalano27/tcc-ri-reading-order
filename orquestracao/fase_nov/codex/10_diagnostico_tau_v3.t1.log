+    rn = next(r for r in dados["validacao_silver"] if r["page_id"].endswith("DOE-RN_2022-12-29_Ordinaria.pdf#p40"))
+    ls += ["## RN p40: contraprova ao resumo ‘seis linhas curtas’", "",
