+
+def f(x, n=6):
+    return "—" if x is None else f"{x:.{n}f}".replace(".", ",")
+
+
+def tabela(cab, rows):
+    return ["| " + " | ".join(cab) + " |", "|" + "|".join("---" for _ in cab) + "|"] + [
+        "| " + " | ".join(str(x) for x in row) + " |" for row in rows]
+
+
+def delta(r, nome, base, k):
+    return r["metricas"][nome][k] - r["metricas"][base][k]
+
+
+def sinal(v):
