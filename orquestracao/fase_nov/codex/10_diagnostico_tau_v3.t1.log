+            grandes = -sum(r["contrastes"][nome]["hibrido67"]["delta_grandes"] for r in losers)
+            padrao = ("o sinal da perda depende da granularidade" if len({sinal(v) for v in ds}) > 1
+                      else "o sinal é o mesmo nas três granularidades")
