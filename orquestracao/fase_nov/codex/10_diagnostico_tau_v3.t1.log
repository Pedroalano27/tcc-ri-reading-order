+        exigir(abs(d["delta"]-esperado) < 1e-12, "Autoteste: atribuicao incorreta")
+        exigir(decompor(base, base, ranks, {u: len(ks) for u, ks in exp.items()}, len(gt))["delta"] == 0,
+               "Autoteste: identidade incorreta")
