+            linhas.append(f"| {uf} | {sum(r['uf'] == uf for r in rs)} | " +
+                          " | ".join(f(v,6) for v in vals) + " |")
+        graves = [(r, r["resultados"]["hier1"]["metricas"]["tau"]-
