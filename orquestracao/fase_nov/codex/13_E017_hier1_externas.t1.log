+def congelar():
+    """Somente fontes de ajuste e metadados; nenhuma externa e aberta aqui."""
+    global FONTE, FONTE16, ASSINATURA, CONGELAMENTO, ESCORES
+    ponteiro = hi.OUT / "cache/ultima_execucao.json"
