+    for uf in splits["teste"]:
+        paths += [b.UNIDADES / "linhas" / (uf+s) for s in (".jsonl", ".palavras.jsonl")]
+    for co in EXTERNAS:
+        paths.append(b.OUT / "pred" / f"layoutreader_pronto__linhas__{co}.jsonl")
+    for path in paths:
+        path = seguro(path)
