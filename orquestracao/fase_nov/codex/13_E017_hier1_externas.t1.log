+                     for k in o.METRICAS}
+            ref = esperado[co + "/" + nome]
+            exigir(all(abs(atual[k]-ref[z]) < 1e-11 for k, z in (
+                ("tau", "tau"), ("quebras", "quebras"), ("sucessor_linhas", "sucessor"))),
