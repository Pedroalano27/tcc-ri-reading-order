+        for _ in o.linhas_seguras(path):
+            pass
+        FONTES_EXTERNAS[relativo(path)] = c.sha(path)
+    path = OUT / "cache/fontes_externas.json"
+    atual = {"assinatura": ASSINATURA, "fontes": dict(FONTES_EXTERNAS)}
