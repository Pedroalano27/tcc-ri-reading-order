+
+def executar(co):
+    rows = []
+    for obj, p in o.paginas(co):
+        vigiar()
+        row = processar(co, obj, p)
+        rows.append(row)
+        print(f"{co}: {len(rows)} paginas; {len(row['segmentos'])} segmentos", flush=True)
+        gc.collect()
+    exigir(rows and len({r["page_id"] for r in rows}) == len(rows), "Bancada vazia/duplicada")
+    return rows
