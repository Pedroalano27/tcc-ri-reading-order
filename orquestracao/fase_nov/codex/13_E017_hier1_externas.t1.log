+def ler(path, pagina=False):
+    path = seguro(path)
+    raw = path.read_text(encoding="utf-8")
+    if pagina:
+        m = o.re.search(r'"page_id"\s*:\s*("(?:[^"\\]|\\.)*")', raw)
