+    ESCORES = types.FunctionType(hi.escores.__code__, {**hi.escores.__globals__,
+        "EXEC": OUT / "cache", "FONTE": FONTE, "INFO": info,
+        "MODELO": None, "gravar": gravar}, "escores_e016")
+    print("Congelamento conferido: " + ASSINATURA, flush=True)
