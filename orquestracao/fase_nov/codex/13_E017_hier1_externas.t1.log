+        graves = sorted(((r, d) for r, d in graves if d < -.1), key=lambda par: par[1])
+        linhas += ["", "### Regressões graves do HIER-1: Δτ < −0,1 vs híbrido", "",
+            f"{len(graves)} páginas. Colunas = número de cortes globais do contexto original + 1 "
