+def ancoras():
+    """Reexecuta os controles antes de permitir qualquer leitura externa."""
+    an = o.ancora()
+    dados = {co: executar(co) for co in AJUSTE}
+    exigir(len(dados["golden_v4"]) == 44 and len(dados["validacao_silver"]) == 15,
