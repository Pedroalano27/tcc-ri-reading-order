+def autoteste():
+    o.autoteste()
+    p = {"page_id": "sintetico/controle.pdf#p0", "dimensions": {"width": 600, "height": 800},
+         "bounding_boxes": [{"id": f"u{i}", "bbox": [20+(i//3)*250, 50+(i%3)*30,
+                              220+(i//3)*250, 60+(i%3)*30], "ks": [i], "text": str(i), "tipo": "texto"}
