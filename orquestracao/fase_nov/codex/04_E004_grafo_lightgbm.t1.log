+                                    ss["regra"]["metricas"]["tau"]["media"]-.005)
+        veredito = "GO" if all(criterios.values()) else "NÃO GO"
+    f, ic = o.f, o.ic
+    linhas = [f"1. Âncora reproduzida: τ {f(an['tau'], 6)}; {f(an['quebras'], 6)} quebras/página no golden_v4.",
