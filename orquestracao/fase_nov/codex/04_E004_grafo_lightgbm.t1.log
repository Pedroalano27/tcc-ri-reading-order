+                                           (("tau", "tau"), ("quebras", "quebras"), ("sucessor", "sucessor_linhas"))}
+        linhas += ["", "### Diferenças pareadas", "", "| Método | Base | n | Métrica | Δ [IC95 por veículo] | p veículo | Melhor/igual/pior |",
+                   "|---|---|---:|---|---:|---:|---:|"]
