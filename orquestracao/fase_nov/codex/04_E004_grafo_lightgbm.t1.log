+DECODERS = {"guloso": o.guloso, "matching": o.matching,
+            "maxregret": o.lm.max_regret}
+COORTES = o.COORTES
+AJUSTE = o.DESENV
+EXTERNAS = COORTES[2:]
+METRICAS = o.METRICAS
