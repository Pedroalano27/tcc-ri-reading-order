+EXTERNAS = COORTES[2:]
+METRICAS = o.METRICAS
+HIPERS = ({"num_leaves": 15, "min_data_in_leaf": 100},
+          {"num_leaves": 31, "min_data_in_leaf": 100})
+ARVORES = (40, 80, 120)
