+    exigir(assinatura == LOCK_SHA, "Lock cego mudou durante a execucao")
+    mem = b.memoria()
+    exigir(not mem or mem["ram_livre_mb"] >= 800 and mem["commit_livre_mb"] >= 1200,
+           "Memoria insuficiente; cache preservado: "+str(mem))
