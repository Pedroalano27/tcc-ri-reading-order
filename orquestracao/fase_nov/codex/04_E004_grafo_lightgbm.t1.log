        gravar(path, manifesto)


def max_regret(ordem, scores):
    """Cobre todas as unidades: fixa maior diferenca melhor-segunda aresta viavel.

    FIM e privado por fonte (varios caminhos). Destino tem no maximo uma entrada;
    union-find impede ciclo. Recalcula regrets apos cada fixacao. Ao final, costura
    raizes pelo posto da PRIMEIRA unidade na regra. Nao e um otimizador exato.
    """
    rank = {u:i for i,u in enumerate(ordem)}
    pendentes = set(ordem)
    entrada, saida = {}, {}
    pai = {u:u for u in ordem}
    def raiz(u):
        while pai[u] != u:
            pai[u] = pai[pai[u]]
            u = pai[u]
        return u
    while pendentes:
        escolha = None
        for u in ordem:
            if u not in pendentes:
                continue
            viaveis = [(v,s) for v,s in scores[u].items()
                       if v is None or (v not in entrada and raiz(u) != raiz(v))]
            viaveis.sort(key=lambda it: (-it[1], rank.get(it[0], len(rank))))
            exigir(viaveis, "Fonte sem FIM")
            v, valor = viaveis[0]
            regret = valor-viaveis[1][1] if len(viaveis) > 1 else float("inf")
            chave = (regret, valor, -rank[u])
            if escolha is None or chave > escolha[0]:
                escolha = (chave, u, v)
        _, u, v = escolha
        saida[u] = v
        pendentes.remove(u)
        if v is not None:
            entrada[v] = u
            pai[raiz(u)] = raiz(v)
    resultado = []
    for u in sorted((u for u in ordem if u not in entrada), key=rank.__getitem__):
        while u is not None:
            resultado.append(u)
            u = saida[u]
    exigir(len(resultado) == len(ordem) and set(resultado) == set(ordem), "Grafo perdeu/repetiu unidade")
    return resultado


"""Mede qualquer ordenador sobre unidades sem caixas finas, sem alterar dados.

Ks define pertinencia; expande cada unidade por ordem_sem_bbox.fluxo() e
importa medir/eventos de erros_ponta_a_ponta. As ancoras P2 sao reexecutadas
em CPU com deteccoes congeladas; P1m vem do JSON historico, sem reextracao.
Paginas, predicoes e metricas persistem em fluxo; so LayoutReader e carregado.
O teto usa a ordem de referencia de unidades exportada (posto mediano): nao
e uma otimizacao combinatoria quando uma unidade atravessa a referencia.

Executar da raiz com venv/Scripts/python.exe -B e este caminho:
  --somente-ancoras
  --metodos teto ingenuo xycut xycut_margens regra_colunas
  --metodos layoutreader_pronto --max-minutos 30
  --avaliar-pred resultados/ordenadores_sem_caixas/pred/modelo__linhas__golden_v4.jsonl
  --conferir
O padrao executa os seis metodos nas tres representacoes e bancadas.
Saidas restritas a resultados/ordenadores_sem_caixas/** e seu .md/.json.
Nao usa GPU, rede, multiprocessing, treino, dados do Label Studio ou OCR.
"""
