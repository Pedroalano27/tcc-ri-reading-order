+def publicar(an, diagnosticos, dados, situacao, treino=None, escolha=None, completo=False):
+    nomes = ["regra", "hibrido67", "regra_reordena", "layoutreader_pronto"]
+    if escolha:
+        nomes.append(escolha["metodo"])
