+              "situacao": situacao, "treino": treino, "escolha": escolha, "completo": completo,
+              "execucao": EXEC.relative_to(OUT).as_posix(), "manifesto": MANIFESTO,
+              "resumos": {co: resumir(rs, nomes) for co, rs in dados.items() if rs}}
