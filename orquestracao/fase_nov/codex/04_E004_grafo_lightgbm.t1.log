+                             for co in c.HUMANAS))
+    splits = b.ler(RAIZ / "data/processed/splits.json")
+    exigir(not set(splits["treino"]) & set(splits["validacao"]+splits["teste"]),
+           "Veiculos de treino/validacao/teste sobrepostos")
+    vistos = {}
+    for pasta in ("linhas", "linhas_extra"):
