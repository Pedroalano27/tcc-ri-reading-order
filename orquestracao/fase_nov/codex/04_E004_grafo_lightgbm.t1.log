+            linhas.append(f"| {cfg['K']} | {cfg['decoder']} | {f(cfg['limiar'], 2)} | {cfg['restricao_coluna']} | {f(a['bancadas']['golden_v4']['quebras'])} | {f(a['bancadas']['validacao_silver']['quebras'])} | {f(a['quebras'])} | {f(a['tau'], 6)} |")
