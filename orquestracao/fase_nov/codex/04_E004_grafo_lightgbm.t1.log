+        pass
+    class DatasetTeste:
+        def __init__(self, data, **kwargs):
+            self.data = data
+        def set_init_score(self, score):
+            self.score = score
+    class LGBTeste:
+        Sequence, Dataset = SequenceTeste, DatasetTeste
