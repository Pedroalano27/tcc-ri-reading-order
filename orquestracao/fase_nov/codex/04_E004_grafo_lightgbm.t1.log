+
+
+def diagnosticar(co, obj, p, salvos):
+    pid = p["page_id"]
+    path = EXEC / "diagnostico" / co / (e.ac.chave(pid)+".json")
+    salvo = carregar(path)
+    if salvo:
+        return salvo
+    inicio = time.perf_counter()
+    ctx, trs, q = preparar_pagina(obj, p)
