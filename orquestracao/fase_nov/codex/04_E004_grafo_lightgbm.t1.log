+def salvar_npz(path, **dados):
+    path = destino(path)
+    tmp = path.with_suffix(path.suffix+".tmp")
+    with tmp.open("wb") as f:
+        np.savez_compressed(f, **dados)
+        f.flush()
+        os.fsync(f.fileno())
+    c.substituir(tmp, path)
