+    sys.modules["torch"].set_num_threads(4)
+
+OUT = RAIZ / "resultados/e004_grafo"
+CACHE = OUT / "cache"
+SEMENTE = 20261102
+VERSAO = "e004-1"
+KS = (12, 24, 32)
+LIMIARES = (0., .5, .8, .95)
