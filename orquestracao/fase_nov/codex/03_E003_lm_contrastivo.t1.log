        ls += ["", "| Bancada | Método | n | Quebras/pág [IC] | τ [IC] | Sucessor linhas [IC] | Arestas certas/ouro | Reparos/regressões |",
               "|---|---|---:|---:|---:|---:|---:|---:|"]
        for co, mets in A["resultados"].items():
            for n,s in mets.items():
