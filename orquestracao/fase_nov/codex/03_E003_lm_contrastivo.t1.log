+               "IDs marginais divergentes")
+        path = BASE/"pares_marginal"/(co+".jsonl")
+        if path.exists():
+            exigir(list(b.jsonl(path)) == rows, "Marginais existentes diferem; nao sobrescrever")
+        else:
