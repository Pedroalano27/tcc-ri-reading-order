+def numero(v, n=6):
+    return "indisponível" if v is None else f"{v:.{n}f}".replace(".", ",")
+
+
+def intervalo(d):
+    return f"{numero(d['media'])} [{numero(d['ic'][0])}; {numero(d['ic'][1])}]"
