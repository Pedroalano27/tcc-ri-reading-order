+                  TRANSFORMERS_OFFLINE="1", TOKENIZERS_PARALLELISM="false",
+                  OMP_NUM_THREADS="4", MKL_NUM_THREADS="4",
+                  OPENBLAS_NUM_THREADS="4", NUMEXPR_NUM_THREADS="4")
