+                for k, d in cs.items():
+                    ls += [f"| {nm} | {base} | {k} | {intervalo(d)} | {numero(d['wilcoxon_veiculo']['p'])} | {d['melhor']}/{d['igual']}/{d['pior']} |"]
+        ls += ["", "### Sucessores reparados e perdidos", "", "| Método | Referência | Reparos | Regressões |", "|---|---|---:|---:|"]
+        for nm, s in ss.items():
