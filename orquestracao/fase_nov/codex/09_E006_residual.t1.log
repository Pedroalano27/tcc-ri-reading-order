+    fontes = {}
+    for p in sorted(paths):
+        exigir("labelstudio" not in p.as_posix().lower(), "Fonte proibida")
+        fontes[p.relative_to(RAIZ).as_posix()] = c.sha(p)
+    MAN = {"experimento": "E006", "fontes": fontes, "lock_sha256": LOCK_SHA,
