+            escolha = selecionar(dados)
+            congelar(an, dados, escolha)
+            alias_ajuste(dados, escolha)
+            publicar(an, dados, escolha)
+            print(f"Congelado: {nome(escolha['lambda'],escolha['M'])}", flush=True)
