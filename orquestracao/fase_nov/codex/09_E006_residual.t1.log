        fontes[path.relative_to(RAIZ).as_posix()] = c.sha(path)
    MAN = {"experimento": "E015", "fontes": fontes, "base_e014": base,
           "criterios": CRITERIOS, "lock_sha256": m.LOCK_SHA,
