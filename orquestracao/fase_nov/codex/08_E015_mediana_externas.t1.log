+
+
+def iniciar():
+    """Verifica hashes das fontes; nao desserializa paginas externas."""
+    global EXEC, MAN, AJUSTE_E014
+    origem14 = m.OUT
+    AJUSTE_E014 = origem14 / b.ler(origem14 / "cache/ultima_execucao.json")["execucao"]
+    m.OUT = OUT
