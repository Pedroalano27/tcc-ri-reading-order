+    for nome in nomes:
+        if nome in resumo:
+            z = resumo[nome]["corpo"]
+            ls.append(f"| {nome} | {z['tau']['n']} | {numero(z['tau']['media'])} | {numero(z['quebras']['media'])} | "
+                      f"{numero(z['fid12']['media'])} | {numero(z['sucessor_linhas']['media'])} |")
+    return ls + [""]
+
+
+def relatorio(estado):
