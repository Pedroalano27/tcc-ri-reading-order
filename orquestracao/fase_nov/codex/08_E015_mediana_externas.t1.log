+RN = "official_diary_rn/DOE-RN_2022-12-29_Ordinaria.pdf#p40"
+CRITERIOS = {
+    "candidato": CAND, "salvaguarda": "tau_palavras(mediana,regra)<0 => regra",
+    "tau_sem_referencia": True, "limiar": 0,
+    "externas": list(o.COORTES[2:]), "margem_tau": .005,
