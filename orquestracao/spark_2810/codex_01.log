def iniciar(a):
    """Move uma unidade; preserva ordem relativa das outras e arestas ja aceitas."""
    rank = {a:i for i,a in enumerate(regra)}
    candidatos = [(a,v) for a,v in propostas.items() if alerts.get(a) and
        v['vantagem'] is not None and v['vantagem'] > limiar and
        v['z'] != (regra[rank[a]+1] if rank[a]+1 < len(regra) else None)]
    candidatos.sort(key=lambda x:(-x[1]['vantagem'],rank[x[0]]))
    ordem = list(regra)
    aceitas = {}
    log = []
    for a,v in candidatos:
        z = v['z']
        ia = ordem.index(a)
        iz = ordem.index(z) if z is not None else len(ordem)-1
        if abs(iz-ia) > JANELA:
            log.append({'a':a,'z':z,'vantagem':v['vantagem'],'estado':'fora_janela'})
            continue
        nova = list(ordem)
        if z is None:
            nova.remove(a); nova.append(a)
        else:
            nova.remove(z); nova.insert(nova.index(a)+1,z)
        suces = dict(zip(nova,nova[1:]+[None]))
        if any(suces[u] != dest for u,dest in aceitas.items()):
            log.append({'a':a,'z':z,'vantagem':v['vantagem'],'estado':'conflito'})
            continue
        exigir(len(nova) == len(regra) and set(nova) == set(regra),'Movimento perdeu unidade')
        ordem = nova
        aceitas[a] = z
        log.append({'a':a,'z':z,'vantagem':v['vantagem'],'estado':'aceita'})
    antigo = dict(zip(regra,regra[1:]+[None]))
    realizado = dict(zip(ordem,ordem[1:]+[None]))
    return ordem,{'propostas':len(candidatos),'aceitas':len(aceitas),
                  'alteradas':sum(antigo[a] != realizado[a] for a in regra),
                  'fontes':len(regra),'log':log}


def acertos_linhas(q,seq,trs,met):
    # Diagnostico de reparos; a metrica continua vindo de e.medir.
    ranks = {k:i for i,k in enumerate(seq)}
    intactas = {L['id']:all(ranks[z] == ranks[a]+1 for a,z in zip(L['ks'],L['ks'][1:]))
                for L in q['gold_lines']}
    hits = [bool(intactas[tr['linha_a']] and intactas[tr['linha_z']] and
                 ranks[tr['palavra_z']] == ranks[tr['palavra_a']]+1) for tr in trs]
    exigir(not trs or abs(sum(hits)/len(trs)-met['sucessor_linhas']) < 1e-12,
           'Decomposicao de reparos diverge da regua')
    return hits


def diagnosticar(ctx,trs,propostas,cands,alerts):
    d = collections.Counter()
    """Constroi o contexto do avaliador; nenhuma referencia entra no preditor."""
    ws, gt = obj["palavras"], obj["gt_w"]
    exigir(len(gt) == len(set(gt)) and gt and set(gt) <= set(range(len(ws))), "Referencia de palavras invalida")
    h = statistics.median(w[4] - w[2] for w in ws)
    q = {"ws": ws, "gt_w": gt, "h": h,
         "p": {"page_id": p["page_id"], "dimensions": p["dimensions"]}}
    if "gold_lines" in obj:
        q.update({k: obj[k] for k in ("gold_lines", "gt_l", "reg_words", "gt_r")})
    else:
        # Silver: a referencia de PALAVRAS e o fluxo PDF. Linhas geometricas
        # sao divididas em trechos contiguos desse fluxo; nunca o reordenam.
        ls = e.o.linhas_partidas(ws, list(range(len(ws))), e.FIXA.gap, h)
        dono = {k: i for i, L in enumerate(ls) for k in L["ks"]}
        grupos = [list(g) for _, g in itertools.groupby(gt, key=dono.__getitem__)]
        gl = [{"id": f"silver:l{i}", "ks": ks} for i, ks in enumerate(grupos)]
        q.update(gold_lines=gl, gt_l=[L["id"] for L in gl],
                 reg_words={"silver": gt}, gt_r=["silver"])
    return q


def paginas(bancada, rep):
    """Le somente uma pagina com palavras, nunca o corpus todo."""
    if bancada != "teste_silver":
        for obj in jsonl(UNIDADES / "bancadas" / (bancada + ".jsonl")):
            exigir(obj["particao"] == bancada, "Particao humana divergente")
            yield obj, obj["representacoes"][rep]
        return
    splits = ler(RAIZ / "data/processed/splits.json")
    for uf in splits["teste"]:
        pp = UNIDADES / rep / (uf + ".jsonl")
        wp = UNIDADES / rep / (uf + ".palavras.jsonl")
        for p, obj in itertools.zip_longest(jsonl(pp), jsonl(wp)):
            exigir(p is not None and obj is not None and p["page_id"] == obj["page_id"],
                   f"Shards de palavras/unidades divergentes: {pp}")
            exigir(p["uf"] == uf and p["particao"] == "teste", "Veiculo/split de teste divergente")
            exigir(obj["referencia_palavras_tipo"] == "fluxo_pdf_por_palavra", "Silver diferente do fluxo PDF")
            exigir(obj["gt_w"] == list(range(len(obj["palavras"]))), "Silver nao preserva indices do fluxo")
            yield {**obj, "uf": uf, "particao": "teste_silver"}, p


def auditar_unidades(p, obj):
    us = p["bounding_boxes"]
    ids = [u["id"] for u in us]
    exigir(len(ids) == len(set(ids)) and ids, "IDs vazios/repetidos")
    exigir(sorted(k for u in us for k in u["ks"]) == list(range(len(obj["palavras"]))),
           f"Palavras perdidas/repetidas: {p['page_id']}")
    for u in us:
        b = u["bbox"]
        exigir(len(b) == 4 and all(math.isfinite(x) for x in b) and b[2] >= b[0] and b[3] >= b[1], "bbox invalida")
    return ids


def fontes():
    paths = DEP_PATHS + [RAIZ / "data/processed/splits.json", e.JSON]
    paths += [RAIZ / "models/terceiros/layoutreader" / n for n in ("config.json", "model.safetensors")]
    grupos = ("todos", "vistos", "nao_vistos") if bancada != "teste_silver" else ("todos",)
    saida = {}
    rep_base = "linhas" if rep == "caixas_finas" else rep
    base = R["resultados"].get(f"regra_colunas__{rep_base}__{bancada}", {})
    base_rows = {r["page_id"]: r for r in base.get("paginas", [])}
    for g in grupos:
        rs = [r for r in rows if g == "todos" or r["visto_treino"] == (g == "vistos")]
        if not rs:
            saida[g] = {"n": 0, "veiculos": 0, "metricas": {}, "contra_regra_colunas": {}}
            continue
        W = None if parcial else PESOS_CLUSTER(rs)
        ms = {}
        for k in METRICAS:
            v = [r["metricas"][k] for r in rs]
            vv = [x for x in v if x is not None]
            ms[k] = {"media": statistics.mean(vv) if vv else None, "n": len(vv), "ic": [None, None]} if parcial else e.media_ic(v, W)
            if k in ("quebras", "piso_interno"):
                ms[k]["total"] = sum(vv)
        # Contrastes por veiculo apenas em paginas pareadas, sem imputacao.
        testes = {}
        for k in METRICAS:
            pareadas = [r for r in rs if r["page_id"] in base_rows and r["metricas"][k] is not None and
                        base_rows[r["page_id"]]["metricas"][k] is not None]
            if parcial or not pareadas or not base.get("completa"):
                continue
            ds = [r["metricas"][k] - base_rows[r["page_id"]]["metricas"][k] for r in pareadas]
            veiculos = sorted({r["uf"] for r in pareadas})
            dvs = [statistics.mean(d for r, d in zip(pareadas, ds) if r["uf"] == uf) for uf in veiculos]
            testes[k] = {"delta": e.media_ic(ds, PESOS_CLUSTER(pareadas)),
                         "wilcoxon_veiculo": e.pratt(dvs), "n_pareadas": len(pareadas),
                         "n_veiculos": len(veiculos), "medias_diferencas_por_veiculo": dict(zip(veiculos, dvs))}
        saida[g] = {"n": len(rs), "veiculos": len({r["uf"] for r in rs}),
                    "metricas": ms, "contra_regra_colunas": testes,
                    "agrupadas_510": sum(bool(r.get("diag", {}).get("excesso_510")) for r in rs),
                    "hierarquia_510": sum(bool(r.get("diag", {}).get("hierarquia")) for r in rs)}
    return saida


def identidade(path, ordenador=None, representacao=None, bancada=None):
    partes = Path(path).stem.split("__")
    if R.get("ancoras", {}).get("aprovada"):
        return
    historico = ler(e.JSON)
    velhos = {r["page_id"]: {m: {k: r["metodos"][m][k] for k in ("seq", "tau", "quebras")}
                             for m in ("P2", "P1m")}
              for r in historico["paginas"] if r["coorte"] == "v4"}
    del historico
    rows = []
    # Cache de controle independe dos scores novos; depende de todas as fontes
    # usadas na ancora. Edicoes no novo script nao exigem refazer o controle.
    deps = {k: v for k, v in R["fontes"].items() if k != b.rel(__file__)}
    afp = c.digest([deps, "ancora-seq-v1", e.FIXA.id])
    for obj, p in b.paginas("golden_v4", "linhas"):
        vigiar()
        pid = p["page_id"]
        cp = BASE / "ancoras" / afp / (e.ac.chave(pid) + ".json")
        if cp.exists():
            row = ler(cp)
            exigir(row["pagina_sha"] == c.digest([obj, p]), "Cache de ancora incompatível")
        else:
            ordem, _ = b.prever(c.automatico(p), obj["palavras"], "regra_colunas")
            med, seq, q, _ = c.medir(obj, p, ordem)
            q["ls3"] = ler(b.UNIDADES / "cache/detector" / (e.ac.chave(pid) + ".json"))["regioes"]
            q["d"] = {"detector": {"regioes": []}}
            sp2, its, dg = e.ls.prever(q, e.FIXA, "ls3")
            exigir(seq == sp2 == velhos[pid]["P2"]["seq"], f"Sequencia de ancora diverge: {pid}")
            m2 = e.medir(q, sp2, its, dg, "P0")
            for k in ("tau", "quebras"):
                exigir(abs(med[k] - m2[k]) < 1e-12 and abs(m2[k] - velhos[pid]["P2"][k]) < 1e-12,
                       f"Metrica de ancora diverge: {pid}/{k}")
            row = {"page_id": pid, "uf": obj["uf"], "pagina_sha": c.digest([obj, p]),
                   "regra": {k: med[k] for k in ("tau", "quebras")},
                   "P1m_historico": {k: velhos[pid]["P1m"][k] for k in ("tau", "quebras")},
                   "seq_identica_P2": True}
            gravar(cp, row)
        rows.append(row)
        R["ancoras"] = {"aprovada": False, "paginas": rows}
        salvar()
        print(f"Âncoras: {len(rows)}/44", flush=True)
    exigir(len(rows) == 44 and {r["page_id"] for r in rows} == set(velhos), "Coorte de ancora diferente")
    ms = {m: {k: statistics.mean(r[m][k] for r in rows) for k in ("tau", "quebras")}
          for m in ("regra", "P1m_historico")}
    R["ancoras"]["medias"] = ms
    exigir(abs(ms["regra"]["tau"] - .985948) <= .00000051 and
           abs(ms["regra"]["quebras"] - 6.045455) <= .00000051,
           f"PARE: ancora obrigatoria nao bate: {ms['regra']}")
    exigir(abs(ms["P1m_historico"]["tau"] - .952) <= .006 and
           abs(ms["P1m_historico"]["quebras"] - 8.93) <= .0051, "Controle P1m nao bate")
    R["ancoras"].update(aprovada=True, fingerprint=afp)
    salvar()


