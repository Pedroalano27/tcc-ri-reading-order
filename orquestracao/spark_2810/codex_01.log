diff --git a/orquestracao/analises/ordem_lm_arestas.py b/orquestracao/analises/ordem_lm_arestas.py
new file mode 100644
index 0000000000000000000000000000000000000000..bad7a2b1a11f822dbb0c255a243347de806c6c0d
--- /dev/null
