+    total = sum(s["pares"] for s in man["bancadas"].values())
+    tamanho = sum(s["bytes"] for s in man["bancadas"].values())
+    ls += ["",f"Total: {total} pares; {tamanho} bytes. Exportação: {fmt(man['segundos_exportacao'])} s.",
