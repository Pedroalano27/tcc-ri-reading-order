@'
import json
from pathlib import Path
from types import SimpleNamespace
from cluster.pontuar_pares_lm import Pontuador
import torch
base = Path('resultados/ordem_lm')
paginas = [json.loads(l) for l in (base/'pares/golden_v4.jsonl').read_text(encoding='utf-8').splitlines()[:3]]
pares = [paginas[0]['pares'][0], paginas[0]['pares'][1], paginas[0]['pares'][-2], paginas[0]['pares'][-1], paginas[1]['pares'][0], paginas[2]['pares'][0]]
a = SimpleNamespace(modelo='Qwen/Qwen3-0.6B', revisao='c1899de289a04d12100db370d81485cdf75e47ca', dispositivo='cuda', dtype='float16', threads=4, nsp=None, lote=4, max_tokens=512)
p = Pontuador(a)
medidos = p.pontuar(pares)
erros = []
with torch.inference_mode():
    for par, s in zip(pares, medidos):
        ctx = p.tok.encode(par['contexto']+'\\n', add_special_tokens=True)
        cont = [p.tok.eos_token_id] if par['id_destino'] is None else p.tok.encode(' '+par['continuacao'], add_special_tokens=False)
        ctx = ctx[-(a.max_tokens-len(cont)):]
        x = torch.tensor([ctx+cont], device='cuda')
        logits = p.model(input_ids=x, use_cache=False).logits[0,len(ctx)-1:-1].float()
        soma = -torch.nn.functional.cross_entropy(logits, x[0,len(ctx):], reduction='sum').item()
        erros.append(abs(soma/len(cont)-s['logp_media']))
        assert s['n_tokens'] == len(cont)
        assert abs(s['logp_soma']/s['n_tokens']-s['logp_media']) < 1e-12
assert max(erros) < .05, erros
print(json.dumps({'verificacao':'padding esquerdo contra cross_entropy independente sem padding', 'pares':len(pares), 'inclui_EOS':True, 'erro_maximo_logp_medio':max(erros), 'aprovado':True}, ensure_ascii=False))
