+           "| Modelo bf16 | Memória apenas pesos (GB decimais) | Horas estimadas |", "|---|---:|---:|"]
+    for nome,p in (("Qwen/Qwen3-8B (aprox.)",8e9),("Modelo ~30B",30e9)):
