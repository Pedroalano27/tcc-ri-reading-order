+    for co,s in man["bancadas"].items():
+        ls.append(f"| {co} | {s['paginas']} | {s['fontes']} | {s['pares']} | {s['bytes']} | {fmt(s['bytes']/2**20)} | "+
+                  fmt(100*s["candidatos_cobertos"]/s["candidatos_ouro"],2)+"% | "+
