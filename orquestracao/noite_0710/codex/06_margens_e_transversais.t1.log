+        gravar(BASE/'execucoes'/R['assinatura_fontes']/'estado.json',R)
+        R={}
+    R.update(fontes=fontes, assinatura_fontes=hash_obj(fontes), splits=ler(RAIZ / "data/processed/splits.json"), comando=sys.argv)
