+        R["memoria_minima_mb"] = min(R.get("memoria_minima_mb", mem["ram_livre_mb"]), mem["ram_livre_mb"])
+        exigir(mem["ram_livre_mb"] >= 900 and mem["commit_livre_mb"] >= 1200,
+               f"Parada retomável por memória: {mem}")
