+        for st, rot in ROT.items():
+            out += [f"**({st}) {rot}**", ""]
+            xs = exemplos[st]
+            escolhidos, usados = [], set()
+            for x in xs:
+                if x[1] not in usados:
+                    escolhidos.append(x)
+                    usados.add(x[1])
+                if len(escolhidos) == 3:
