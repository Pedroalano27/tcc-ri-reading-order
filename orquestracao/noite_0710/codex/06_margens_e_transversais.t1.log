+        if nome=='teste_silver':
+            grupos['sem_humanas'] = [r for r in rows if not r['sobrepoe_humanas']]
+        sums[nome] = {g:estatisticas(rs) for g,rs in grupos.items() if rs}
+    R['resumos'] = sums
+    gravar(BASE/'estatisticas.json',sums)
+    salvar()
