+                    break
+                if x not in escolhidos:
+                    escolhidos.append(x)
+            if not escolhidos:
+                out += ["Nenhuma ocorrência atribuída a este subtipo nesta execução.", ""]
+            for nome, pid, t in escolhidos:
+                out += [f"- `{pid}` ({nome}; {t['linha_a']} → {t['linha_z']}; {'interna à unidade' if t['interno'] else 'entre unidades'}).",
