+        diagnosticar()
+        if args.etapa == "tudo":
+            raise NotImplementedError("Etapa de variante ainda não implementada")
+        R["etapa_concluida"] = args.etapa
+        salvar()
+    except Exception as exc:
+        R["erro"] = f"{type(exc).__name__}: {exc}"
+        salvar()
+        raise
+
+
+if __name__ == "__main__":
+    main()

