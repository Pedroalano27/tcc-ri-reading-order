+        rows = sorted(R['diagnostico'][nome],key=lambda r:(-r['tipos']['margem']['erros'],-r['tipos']['margem']['quebras_palavra'],r['page_id']))[:8]
+        ids = {r['page_id']:r for r in rows}
+        for obj,p in b.paginas(nome,'linhas'):
+            if p['page_id'] not in ids:
