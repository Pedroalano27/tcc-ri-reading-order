+                    for original in b.jsonl(tarefas):
+                        if original['page_id']==p['page_id']:
+                            candidates.insert(0,tarefas.parent/'img'/original['imagem'])
+            candidato = next((x for x in candidates if x.exists()),None)
+            if candidato:
+                out[p['page_id']] = candidato
+    return out
