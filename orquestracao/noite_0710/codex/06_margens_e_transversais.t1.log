+def f(v, n=3):
+    return "—" if v is None else f"{v:.{n}f}".replace(".", ",")
+
+
+def cel(m, percentual=False, casas=3):
+    mul = 100 if percentual else 1
+    a,z = m['ic']
+    return f"{f(m['media']*mul,casas)} [{f(a*mul,casas)}; {f(z*mul,casas)}]"
+
