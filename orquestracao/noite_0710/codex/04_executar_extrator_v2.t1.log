+        grupo.add_argument("--com-" + c.lower(), dest=c, action="store_true")
+        grupo.add_argument("--sem-" + c.lower(), dest=c, action="store_false")
+        ap.set_defaults(**{c: True})
+    args = ap.parse_args()
