+                "fingerprint": R["fingerprint"], "conclusao": conclusao(R),
+                "medias": {bc: {**resumo_pareado(pareadas(R, bc), "depois", "linhas"),
+                                 "n": len(pareadas(R, bc))} for bc in BANCADAS}}
+    gravar(INDICE, ix)
