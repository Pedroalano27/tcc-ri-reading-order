from PIL import Image
from orquestracao.analises import extrator_sem_paragrafos_v2 as s
ast.parse(Path(s.__file__).read_text(encoding='utf-8'))
r=s.ler_json(s.OUT/'resultado.json')
assert r['fase']=='concluida' and r['completa'] and r['ancoras']['aprovada']
assert s.relatorio(r)==s.MD.read_text(encoding='utf-8')
run=s.OUT/'cache'/r['fingerprint']
assert s.ler_json(run/'estado.json')==r
counts={}
for bc,expected in s.BANCADAS.items():
    rows=s.pareadas(r,bc)
    assert len(rows)==expected
    for row in rows:
        cache=s.ler_json(run/'paginas'/(s.chave(row['page_id'])+'.json'))
        assert cache['fingerprint']==row['fingerprint_v2']
        obj=cache['objeto']
        for rep in s.REPS: s.b.auditar_unidades(obj['representacoes'][rep],obj)
    counts[bc]=len(rows)
assert len(r['paineis'])==8
for x in r['paineis']:
    path=s.RAIZ/'resultados'/x['arquivo']
    assert path.exists() and s.sha(path)==x['sha256']
    with Image.open(path) as img: img.verify()
assert len(list(s.OUT.glob('*.jpg')))==8
assert not list((s.NOVO/'bancadas').glob('*.jsonl'))
ix=s.ler_json(s.INDICE)
assert len(ix)==7
initial=s.ler_json(s.RAIZ/ix['ABCDE inicial']['estado'])
changed=[k for k,v in initial['fontes'].items() if r['fontes'].get(k)"'!=v]
assert changed==['"'orquestracao/analises/extrator_sem_paragrafos_v2.py'], changed
check={'bancadas':counts,'paineis_validos':len(r['paineis']),'configuracoes_avaliadas':len(ix),
       'fontes_modificadas_desde_inicio':changed,'markdown_reproduzido_do_json':True,
       'integridade_palavras_unidades':True,'sem_exportacao_final_aprovada':True,
       'fingerprint':r['fingerprint']}
s.gravar(s.OUT/'verificacao.json',check)
print(json.dumps(check,ensure_ascii=False))
