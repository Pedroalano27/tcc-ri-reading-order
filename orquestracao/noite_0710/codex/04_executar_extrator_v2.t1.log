        if not tpath.exists():
            continue
        with open(tpath, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    doc = json.loads(line)
                    pid = doc.get("page_id")
                    img_name = doc.get("imagem")
                    if pid and img_name:
                        cand = ipath / img_name
                        if cand.exists() and pid not in mapa:
                            mapa[pid] = cand
                except Exception:
                    continue
    return mapa


def carregar_estruturas_golden() -> dict[str, dict]:
    """Carrega as 45 paginas com anotacao de estruturas (cabecalho, rodape, quadro_externo)."""
    estruturas = {}
    p = RAIZ / "resultados/estruturas_golden_v4/linhas.jsonl"
    if p.exists():
        with open(p, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    doc = json.loads(line)
                    pid = doc.get("page_id")
                    if pid:
                        estruturas[pid] = doc
                except Exception:
                    continue
    return estruturas

