+        for src in [NOVO / "bancadas" / (bc + ".jsonl") for bc in BANCADAS] + [manifesto]:
+            if src.exists():
+                exigir(src.resolve().is_relative_to(NOVO.resolve()), "Origem de arquivo fora do escopo")
+                alvo = destino(OUT / "unidades_iniciais" / src.relative_to(NOVO))
