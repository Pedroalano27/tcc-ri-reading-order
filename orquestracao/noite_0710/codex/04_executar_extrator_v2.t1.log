+    """IC descritivo da diferenca pareada; nao altera nenhuma metrica."""
+    nboot, seed = 2000, 20261008
+    out = {"semente": seed, "reamostras": nboot, "bancadas": {}}
+    for bc in BANCADAS:
+        rows = pareadas(R, bc)
+        grupos = collections.defaultdict(list)
