+def transicoes(nome,obj,p,ctx):
+    if nome in HUMANAS:
+        return ler(BASE/'diagnostico'/nome/(e.ac.chave(p['page_id'])+'.json'))['transicoes']
+    _,_,trs,_ = preparar(obj,p,ctx)
+    pap,_ = m.evidencia(ctx)
+    for tr in trs:
+        if tr['tipo']=='margem':
+            tr['subtipo'] = m.subtipo(ctx,tr['a'],tr['z'],pap)
+    return trs
