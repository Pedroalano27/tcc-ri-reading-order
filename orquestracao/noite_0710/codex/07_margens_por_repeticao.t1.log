+    for met in METODOS:
+        text = ''.join(json.dumps({'page_id':r['page_id'],'ordem':r['metodos'][met]['ordem']},ensure_ascii=False)+'\n' for r in rows)
+        gravar(BASE/'pred'/f'{met}__linhas__{nome}.jsonl',text)
