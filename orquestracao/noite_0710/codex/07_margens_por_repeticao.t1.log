+            cp = BASE/'avaliacao'/nome/(e.ac.chave(p['page_id'])+'.json')
+            fp = b.digest([R['assinatura_fontes'],par,METODOS,obj,p])
+            row = ler(cp) if cp.exists() else {}
+            if row.get('fingerprint') != fp:
