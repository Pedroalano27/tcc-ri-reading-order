+                row = {'page_id':p['page_id'],'uf':p['uf'],'visto_treino':p['uf'] in R['splits']['treino'],
+                       'sobrepoe_humanas':p['page_id'] in R['humanos'],'vizinhas':rep['vizinhas'],
