+            salvar()
+            print(f'Avaliacao {nome}: {len(rows)} paginas',flush=True)
+            gc.collect()
+        exigir(rows, f'Bancada vazia: {nome}')
+        R['avaliacao'][nome]['completa'] = True
+        resumir(nome)
