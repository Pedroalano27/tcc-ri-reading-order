+    splits=ler(RAIZ/'data/processed/splits.json')
+    paths.update(b.UNIDADES/'linhas'/(uf+suf) for uf in splits['teste']+splits['validacao'] for suf in ('.jsonl','.palavras.jsonl'))
+    return {b.rel(p):b.sha(p) for p in sorted(paths)}
