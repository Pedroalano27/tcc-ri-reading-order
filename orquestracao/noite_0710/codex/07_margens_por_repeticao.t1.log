+                for n,rows in coortes.items()} for key,coortes in tabela.items()}
+    base = tab['0:original']
+    candidatos = [key for key in tab if ':combinacao_' in key]
+    elegiveis = [key for key in candidatos if all(tab[key][n]['tau']>=base[n]['tau']-.002 for n in base)]
