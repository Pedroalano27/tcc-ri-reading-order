+def fontes():
+    paths=set(b.DEP_PATHS)|{Path(m.__file__),Path(c.__file__),Path(__file__),e.JSON,
+        RAIZ/'data/processed/splits.json',RAIZ/'data/golden/golden_v4/tarefas.jsonl',
