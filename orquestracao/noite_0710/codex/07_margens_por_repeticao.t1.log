+        raise RuntimeError('Prazo atingido; repetir o comando retoma os caches.')
+    mem = b.memoria()
+    if mem:
+        R['ram_minima_mb'] = min(R.get('ram_minima_mb', mem['ram_livre_mb']), mem['ram_livre_mb'])
