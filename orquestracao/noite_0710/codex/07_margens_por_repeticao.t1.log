+        out += ['', '| Ablação contra original | Δ quebras [IC] / p veículo | Δ τ [IC] / p veículo | Δ fidelidade de 12 (p.p.) [IC] / p | Δ sucessor (p.p.) [IC] / p |', '|---|---:|---:|---:|---:|']
+        for method,st in sums[nome]['todos'].items():
