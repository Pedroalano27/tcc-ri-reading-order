def paginas(c):
    if c in HUMANAS:
        yield from b.paginas(c, "linhas")
    else:
        part = {"validacao_silver": "validacao", "teste_silver": "teste", "treino": "treino"}[c]
        for m in ESTADO["inventario"]["planos"][part]:
            yield ler_meta(m)


def automatico(p):
    return {"page_id": p["page_id"], "dimensions": dict(p["dimensions"]),
            "bounding_boxes": [{k: u[k] for k in ("id", "bbox", "ks", "text", "tipo")}
                               for u in p["bounding_boxes"]]}


def medir(obj, p, ordem):
    """Regua importada integralmente; nenhuma escrita em caches da bancada."""
    ids = b.auditar_unidades(p, obj)
    exigir(isinstance(ordem, list) and len(ordem) == len(ids) and set(ordem) == set(ids), "Ordem invalida")
    exp = b.expansoes(obj, p)
    seq = [k for uid in ordem for k in exp[uid]]
    q = b.referencia(obj, p)
    med = e.medir(q, seq, [], {}, "P0")
    res = {k: med[k] for k in METRICAS if k != "piso_interno"}
    res["piso_interno"] = sum(len(e.eventos(ks, q["gt_w"])) for ks in exp.values())
    exigir(res["piso_interno"] <= res["quebras"], "Piso excede quebras")
    return res, seq, q, exp


def ancoras():
    """Reexecuta regra/P2 congelado; P1m e controle historico explicitamente."""
    if ESTADO.get("ancoras", {}).get("aprovada"):
        return
    historico = ler(e.JSON)
    antigos = {r["page_id"]: {m: {k: r["metodos"][m][k] for k in ("tau", "quebras", "seq")}
                             for m in ("P2", "P1m")}
               for r in historico["paginas"] if r["coorte"] == "v4"}
    del historico
    rows = []
    for obj, p in paginas("golden_v4"):
        vigiar()
        pid = p["page_id"]
        cp = DIR_EXEC / "ancoras" / (e.ac.chave(pid) + ".json")
        if cp.exists():
            row = ler(cp)
        else:
            auto = automatico(p)
            ordem, _ = b.prever(auto, obj["palavras"], "regra_colunas")
            med, seq, q, _ = medir(obj, p, ordem)
            q["ls3"] = ler(UNIDADES / "cache/detector" / (e.ac.chave(pid) + ".json"))["regioes"]
            q["d"] = {"detector": {"regioes": []}}
            seq_p2, its, diag = e.ls.prever(q, e.FIXA, "ls3")
            mp2 = e.medir(q, seq_p2, its, diag, "P0")
            exigir(pid in antigos, "Pagina da ancora sem historico")
            exigir(seq == seq_p2 == antigos[pid]["P2"]["seq"], f"Sequencia da ancora diverge: {pid}")
            row = {"page_id": pid, "uf": obj["uf"],
                   "regra": {k: med[k] for k in ("tau", "quebras")},
                   "P2": {k: mp2[k] for k in ("tau", "quebras")},
                   "P1m_historico": {k: antigos[pid]["P1m"][k] for k in ("tau", "quebras")}}
            gravar(cp, row)
        rows.append(row)
        ESTADO["ancoras"] = {"aprovada": False, "paginas": rows, "concluidas": len(rows)}
        salvar()
        print(f"Ancoras: {len(rows)}/44", flush=True)
    exigir(len(rows) == 44 and {r["page_id"] for r in rows} == set(antigos), "Coorte da ancora mudou")
    medias = {m: {k: statistics.mean(r[m][k] for r in rows) for k in ("tau", "quebras")}
              for m in ("regra", "P2", "P1m_historico")}
    ESTADO["ancoras"].update(medias=medias)
    for nome, tau, qb in (("regra", .985948, 6.045455), ("P2", .985948, 6.045455),
                          ("P1m_historico", .952424, 8.931818)):
        exigir(abs(medias[nome]["tau"] - tau) <= .006 and
               abs(medias[nome]["quebras"] - qb) <= .0051, f"Ancora {nome} nao reproduzida: {medias[nome]}")
    ESTADO["ancoras"]["aprovada"] = True
    salvar()


def cx(u):
    return (u["bbox"][0] + u["bbox"][2]) / 2


def cy(u):
    return (u["bbox"][1] + u["bbox"][3]) / 2


def tipo_unidade(u):
    t = u["tipo"]
    return "tabela" if t in ("table", "tabela") else "imagem" if t in ("picture", "imagem", "figura") else "texto"


def contexto(p, ws):
    """Somente campos automaticos; jamais recebe ranks ou ordens de referencia."""
    auto = automatico(p)
    cs = auto["bounding_boxes"]
    ordem, diag = b.prever(auto, ws, "regra_colunas")
    exp = {u["id"]: e.o.fluxo([u], ws) for u in cs}
    alturas = [w[4] - w[2] for w in ws if w[4] > w[2]]
    exigir(alturas, "Pagina sem alturas de palavra positivas")
    h = statistics.median(alturas)
    ini, corpo, marcas, fim = e.j.particao(cs, ws, auto["dimensions"]["height"], "geo")
    cortes = e.o.vales_locais(cs, corpo, h, e.FIXA.vale) if corpo else []
    if not cortes and corpo:
        cortes = e.o.vales(cs, corpo, h, e.FIXA.vale)
    largura = max(u["bbox"][2] for u in cs) - min(u["bbox"][0] for u in cs)
    margem = {cs[i]["id"]: t for ids, t in ((ini, "topo"), (fim, "rodape"), (marcas, "marca")) for i in ids}
    cols = {u["id"]: bisect.bisect_right(cortes, cx(u)) for u in cs}
    pontes = {u["id"] for u in cs if any(u["bbox"][0] < c < u["bbox"][2] and
              min(c-u["bbox"][0], u["bbox"][2]-c) >= .10*largura for c in cortes)}
    mapa = {u["id"]: u for u in cs}
    grupos = {col: sorted((u["id"] for u in cs if cols[u["id"]] == col and
                          u["id"] not in pontes and u["id"] not in margem),
                         key=lambda uid: (mapa[uid]["bbox"][1], mapa[uid]["bbox"][0]))
              for col in range(len(cortes)+1)}
    pos = {uid: i / max(1, len(g)-1) for g in grupos.values() for i, uid in enumerate(g)}
    return {"auto": auto, "cs": cs, "mapa": {u["id"]: u for u in cs}, "ws": ws, "h": h,
            "ordem": ordem, "regra": dict(zip(ordem, ordem[1:] + [None])), "diag": diag,
            "exp": exp, "col": cols, "cortes": cortes, "pontes": pontes, "margem": margem,
            "grupos": grupos, "pos": pos, "rank_regra": {uid: i for i, uid in enumerate(ordem)},
            "entrada": [cs[i]["id"] for i in ordem_entrada(auto)],
            "objetos": [u for u in cs if tipo_unidade(u) != "texto" or u["id"] in pontes]}


def sobreposicao(a, z):
    ba, bz = a["bbox"], z["bbox"]
    return max(0., min(ba[2], bz[2])-max(ba[0], bz[0])) / max(1., min(ba[2]-ba[0], bz[2]-bz[0]))


def obstaculos(ctx, a, z):
    if z is None:
        return 0
    lo, hi = sorted((cy(a), cy(z)))
    x0, x1 = min(a["bbox"][0], z["bbox"][0]), max(a["bbox"][2], z["bbox"][2])
    return sum(u["id"] not in (a["id"], z["id"]) and lo < cy(u) < hi and
               u["bbox"][0] < x1 and u["bbox"][2] > x0 for u in ctx["objetos"])


def categoria(ctx, a, z, *, bbox_a=None, bbox_z=None):
    """Tipologia exclusiva, geometrica e sem classes humanas.

    Precedencia: margem, atomo, ponte, retorno entre colunas, continuacao, outro.
    Calhas sao proxies globais do corpo; nao prova causal nem anotacao humana.
    """
    if a is None or z is None:
        return "outro"
    ua, uz = ctx["mapa"][a], ctx["mapa"][z]
    if a in ctx["margem"] or z in ctx["margem"]:
        return "margem"
    if tipo_unidade(ua) != "texto" or tipo_unidade(uz) != "texto":
        return "tabela_imagem" if a != z else "outro"
    if a in ctx["pontes"] or z in ctx["pontes"] or obstaculos(ctx, ua, uz):
        return "transversal"
    aa = {"bbox": bbox_a or ua["bbox"]}
    zz = {"bbox": bbox_z or uz["bbox"]}
    ca, cz = bisect.bisect_right(ctx["cortes"], cx(aa)), bisect.bisect_right(ctx["cortes"], cx(zz))
    if cz == ca+1 and cy(zz) < cy(aa)-2*ctx["h"] and ctx["pos"].get(a, 0) >= .65 and ctx["pos"].get(z, 1) <= .35:
        return "proxima_coluna"
    if ca == cz and cy(zz) >= cy(aa)-.5*ctx["h"] and sobreposicao(aa, zz) >= .25:
        return "mesma_coluna"
    return "outro"


def confianca_regra(ctx, uid):
    """Proxy geometrico, nao probabilidade calibrada fornecida pela regra."""
    z = ctx["regra"][uid]
    if z is None:
        return .5
    a, alvo = ctx["mapa"][uid], ctx["mapa"][z]
    gap = (alvo["bbox"][1]-a["bbox"][3]) / ctx["h"]
    if categoria(ctx, uid, z) == "mesma_coluna" and -.5 <= gap <= 2.5 and sobreposicao(a, alvo) >= .75:
        return .99
    return .5


def candidatos(ctx, uid, nivel):
    """Todos os desempates partem da entrada embaralhada, sem consultar ouro."""
    a = ctx["mapa"][uid]
    ent = [z for z in ctx["entrada"] if z != uid]
    if nivel == -1:
        return ent + [None]
    out = []
    def incluir(z):
        if z != uid and z not in out:
            out.append(z)
    incluir(ctx["regra"][uid])
    abaixo = sorted((z for z in ent if ctx["col"][z] == ctx["col"][uid] and cy(ctx["mapa"][z]) > cy(a)+.25*ctx["h"]),
                    key=lambda z: (cy(ctx["mapa"][z])-cy(a), abs(cx(ctx["mapa"][z])-cx(a))))
    if abaixo:
        incluir(abaixo[0])
    proxima = sorted((z for z in ent if ctx["col"][z] == ctx["col"][uid]+1),
                     key=lambda z: (ctx["mapa"][z]["bbox"][1], ctx["mapa"][z]["bbox"][0]))
    if proxima:
        incluir(proxima[0])
    trans = sorted((z for z in ent if z in ctx["pontes"] and cy(ctx["mapa"][z]) > cy(a)),
                   key=lambda z: cy(ctx["mapa"][z])-cy(a))
    if trans:
        incluir(trans[0])
    proximos = sorted(ent, key=lambda z: math.hypot(cx(ctx["mapa"][z])-cx(a), cy(ctx["mapa"][z])-cy(a)))
    for z in proximos[:nivel]:
        incluir(z)
    if nivel > 3:
        for z in abaixo[:nivel] + proxima[:nivel]:
            incluir(z)
        # Inclui retornos ao topo, vizinhos na ordem-base e objetos proximos.
        for col in sorted(ctx["grupos"]):
            for z in ctx["grupos"][col][:nivel]:
                incluir(z)
        na_regra = sorted(ent, key=lambda z: abs(ctx["rank_regra"][z]-ctx["rank_regra"][uid]))
        for z in na_regra[:nivel]:
            incluir(z)
        for z in sorted((u["id"] for u in ctx["objetos"] if u["id"] != uid),
                        key=lambda z: abs(cy(ctx["mapa"][z])-cy(a)))[:nivel]:
            incluir(z)
    incluir(None)
    # Retira a ordem de montagem como possivel feature implicita.
    return [z for z in ent if z in out] + [None]


def preparar_avaliacao(obj, p, ctx):
    med, seq, q, exp = medir(obj, p, ctx["ordem"])
    dono = {k: uid for uid, ks in exp.items() for k in ks}
    ranks = {k: i for i, k in enumerate(seq)}
    ls = {L["id"]: L for L in q["gold_lines"]}
    intactas = {lid: all(ranks[z] == ranks[a]+1 for a, z in zip(L["ks"], L["ks"][1:])) for lid, L in ls.items()}
    trs = []
    for la, lz in zip(q["gt_l"], q["gt_l"][1:]):
        ka, kz = ls[la]["ks"][-1], ls[lz]["ks"][0]
        ua, uz = dono[ka], dono[kz]
        interno = ua == uz
        alcancavel = (ranks[kz] == ranks[ka]+1) if interno else exp[ua][-1] == ka and exp[uz][0] == kz
        bbox_a = e.o.envelope([obj["palavras"][k][1:5] for k in ls[la]["ks"]])
        bbox_z = e.o.envelope([obj["palavras"][k][1:5] for k in ls[lz]["ks"]])
        trs.append({"linha_a": la, "linha_z": lz, "palavra_a": ka, "palavra_z": kz,
                    "a": ua, "z": uz, "interno": interno, "alcancavel": alcancavel,
                    "tipo": categoria(ctx, ua, uz, bbox_a=bbox_a, bbox_z=bbox_z),
                    "acerto": intactas[la] and intactas[lz] and ranks[kz] == ranks[ka]+1})
    # A anotacao de cada transicao apenas decompoe a metrica oficial importada.
    if trs:
        exigir(abs(sum(t["acerto"] for t in trs)/len(trs) - med["sucessor_linhas"]) < 1e-12,
               "Diagnostico de linhas diverge da regua oficial")
    ev = e.eventos(seq, q["gt_w"])
    cont = {t: {"ouro": 0, "acertos": 0, "erros": 0, "quebras_palavra": 0,
                "internas": 0, "transicoes_internas": 0, "inalcancaveis": 0} for t in TIPOS}
    for t in trs:
        r = cont[t["tipo"]]
        r["ouro"] += 1
        r["acertos"] += int(t["acerto"])
        r["erros"] += int(not t["acerto"])
        r["transicoes_internas"] += int(t["interno"])
        r["inalcancaveis"] += int(not t["alcancavel"])
    for evn in ev:
        z = dono.get(evn["esperado"])
        cat = categoria(ctx, dono[evn["a"]], z)
        cont[cat]["quebras_palavra"] += 1
        cont[cat]["internas"] += int(dono[evn["a"]] == dono[evn["b"]])
    exigir(sum(r["quebras_palavra"] for r in cont.values()) == med["quebras"], "Quebras nao particionadas")
    exemplos = [{**t, "texto_a": " ".join(obj["palavras"][k][0] for k in ls[t["linha_a"]]["ks"][-6:]),
                 "texto_z": " ".join(obj["palavras"][k][0] for k in ls[t["linha_z"]]["ks"][:6])}
                for t in trs if not t["acerto"]][:12]
    return med, cont, trs, exemplos


def metadados(p):
    uf = p["uf"]
    return {"page_id": p["page_id"], "uf": uf,
            "visto_split": uf in ESTADO["splits"]["treino"],
            "visto_treino": uf in ESTADO["inventario"]["treino_veiculos_efetivos"]}
    return (c.tipo_unidade(ctx["mapa"][uid]) == "texto" and uid not in ctx["margem"] and
            uid not in ctx["pontes"])


def detectar_alertas(ctx):
    """Alertas geometricos calculados antes de qualquer consulta a referencia."""
    out = []
    h = ctx["h"]
    for i, (a, z) in enumerate(zip(ctx["ordem"], ctx["ordem"][1:])):
        ua, uz = ctx["mapa"][a], ctx["mapa"][z]
        if a in ctx["margem"] or z in ctx["margem"]:
            continue
        ca, cz = ctx["col"][a], ctx["col"][z]
        dy = c.cy(uz) - c.cy(ua)
        nomes, saltadas = [], []
        if movel(ctx, a):
            for v in ctx["grupos"].get(ca, []):
                if v in (a, z) or not movel(ctx, v):
                    continue
                uv = ctx["mapa"][v]
                dv = c.cy(uv) - c.cy(ua)
                if .25*h < dv <= 4*h and c.sobreposicao(ua, uv) >= .25 and (
                        ca != cz or c.cy(uv) < c.cy(uz)-.25*h):
                    saltadas.append(v)
            if saltadas:
                nomes.append("salto")
        if dy < -.75*h and c.categoria(ctx, a, z) != "proxima_coluna":
            nomes.append("retorno")
        if movel(ctx, a) and movel(ctx, z) and ca == cz:
            delta = min(abs(ua["bbox"][0]-uz["bbox"][0]), abs(ua["bbox"][2]-uz["bbox"][2])) / h
            if delta > 1.5 or c.sobreposicao(ua, uz) < .4:
                nomes.append("alinhamento")
        if (c.tipo_unidade(ua) != "texto" or c.tipo_unidade(uz) != "texto" or
                c.obstaculos(ctx, ua, uz)):
            nomes.append("objeto")
        if nomes:
            out.append({"i": i, "a": a, "z": z, "tipos": nomes, "saltadas": saltadas})
    return out


def janelas(ctx, alerts):
    """Seleciona janelas somente a partir dos alertas, com um separador fixo."""
"""Carrega um checkpoint e prediz as tres bancadas em CPU, pagina por pagina.

Usa o contrato estrito da bancada, sem expandir unidades nem consultar ouro.
Checkpoint e shards sao identificados por hash. Cada predicao e fsync em JSONL;
retoma por page_id e remove apenas a ultima linha truncada do arquivo proprio.
--avaliar invoca bancada_ordenadores.py --avaliar-pred depois de liberar a rede.

Uso: venv/Scripts/python.exe -B orquestracao/analises/ordenar_bancadas.py
 --checkpoint resultados/ordenadores_treinados_sem_caixas/lstm_geo_linhas/melhor.pt
 --avaliar
"""
from __future__ import annotations
import sys
sys.dont_write_bytecode = True
from pathlib import Path
RAIZ = Path(__file__).resolve().parents[2]
sys.path.insert(0,str(RAIZ))
import argparse
import gc
import json
import os
import subprocess
import time
import re
import statistics
os.environ.update(CUDA_VISIBLE_DEVICES="-1", HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1",
                  HF_DEACTIVATE_ASYNC_LOAD="1", OMP_NUM_THREADS="4", MKL_NUM_THREADS="4")
import torch
from orquestracao.analises import treinar_sem_caixas as t
from orquestracao.analises import bancada_ordenadores as b


def relatorio_final():
    """Completa o relatorio com evidencias executadas e leitura dos resultados."""
    t.relatorio()
    path = RAIZ / "resultados/ordenadores_treinados_sem_caixas.md"
    texto = path.read_text(encoding="utf-8")
    linhas = []
    for l in texto.splitlines():
        if l.startswith("|"):
            l = re.sub(r"(?<=\d)\.(?=\d)", ",", l)
            l = l.replace("| Device |", "| Dispositivo |").replace("| True |", "| sim |").replace("| False |", "| não |")
        linhas.append(l)
    R = t.ler(RAIZ / "resultados/ordenadores_sem_caixas.json")
    r0 = R["resultados"]["regra_colunas__linhas__golden_v4"]
    aprendidos = [v for v in R["resultados"].values() if v["ordenador"].startswith("lstm_")
        and v["representacao"] == "linhas" and v["bancada"] == "golden_v4" and v["completa"]]
    if aprendidos:
        media = lambda r,k: statistics.mean(p["metricas"][k] for p in r["paginas"])
        linhas += ["", "## Leitura do resultado principal", "",
            "| Ordenador em linhas, v4 | τ palavras | Quebras/página |", "|---|---:|---:|"]
        for r in [r0] + sorted(aprendidos,key=lambda x:x["ordenador"]):
            linhas.append(f"| {r['ordenador']} | {media(r,'tau'):.6f} | {media(r,'quebras'):.2f} |".replace(".",","))
        if all(media(r,"quebras") > media(r0,"quebras") for r in aprendidos):
            linhas += ["", "Os BiLSTMs em linhas avaliados até aqui tiveram mais quebras de leitura que a regra de colunas. Portanto este orçamento de treino não sustenta ganho de continuidade por BiLSTM."]
    alvos = [("sucessor_linhas","linhas"),("layoutreader_ajustado_linhas","linhas"),
             ("sucessor_colunas_margens","colunas_margens"),("pontual_linhas","linhas")]
    pendentes = [f"{m}__{rep}__{bancada}" for m,rep in alvos for bancada in b.BANCADAS
        if not R["resultados"].get(f"{m}__{rep}__{bancada}",{}).get("completa")]
    linhas += ["", f"Transformers da fila: {len(pendentes)} avaliações completas ainda pendentes. A comparação com eles só pode ser concluída após a execução dos roteiros."] if pendentes else ["", "As avaliações dos Transformers da fila estão completas e constam das tabelas acima."]
    linhas += ["", "## Evidência das fumaças em CPU", "",
        "| Fumaça | Páginas selecionadas | Visitadas | Passos de otimizador | Bancadas inferidas | Isolamento do ouro |", "|---|---:|---:|---:|---:|---|"]
    for cp in sorted(t.OUT.glob("fumaca_*/treino.json")):
        info = t.ler(cp)
        ds = list((cp.parent / "pred_fumaca").glob("*__tempos.json"))
        checks = [d for p in ds for d in t.ler(p).values()]
        ok = bool(checks) and all(d.get("isolamento_ouro") and "metricas_fumaca" in d for d in checks)
        linhas.append(f"| {info['config']['nome']} | {info['paginas_treino']} | {info.get('paginas_visitadas',0)} | {info.get('passos',0)} | {len(checks)} | {'sim' if ok else 'pendente'} |")
    linhas += ["", "Fumaças usam CPU/float32, sem carregar outra rede em paralelo. Cada inferência limitada confere permutação, avalia pela função original da bancada e repete a predição sem referência de unidades. Seus valores de eficácia são controles de execução, não avaliações completas. JSONs de treino e tempos em `resultados/ordenadores_treinados_sem_caixas/fumaca_*/` preservam os números.", "",
        "O Bash desta sessão falhou antes de analisar os roteiros (`CreateFileMapping`, erro de acesso do Windows). Por isso a prova executável usa diretamente o Python do projeto com os mesmos argumentos. A sintaxe Bash precisa de conferência no terminal da fila. Nenhum pico de memória/tempo em GPU foi medido; micro-lote e congelamento de camadas são escolhas de execução a confirmar quando a fila rodar.", ""]
    path.write_text("\n".join(linhas),encoding="utf-8")


def retomar(path):
    """Repara so EOF incompleto do nosso arquivo, nunca uma predicao invalida."""
    vistos = set()
    if not path.exists():
        return vistos
    with path.open("r+b") as f:
        while True:
            off = f.tell()
            line = f.readline()
            if not line:
                break
            if not line.endswith(b"\n"):
                f.seek(off)
                f.truncate()
                break
            q = json.loads(line.decode("utf-8"))
            if q["page_id"] in vistos:
                raise ValueError("Page_id duplicado no arquivo de predicao")
            vistos.add(q["page_id"])
    return vistos


def executar(a):
    ck = torch.load(a.checkpoint, map_location="cpu", weights_only=False)
    config = dict(ck["config"])
    config["device"] = "cpu"
    cfg = argparse.Namespace(**config)
    rep, nome = cfg.representacao, cfg.nome
    a.dir_saida.mkdir(parents=True,exist_ok=True)
    paths = [a.dir_saida / f"{nome}__{rep}__{bancada}.jsonl" for bancada in a.bancadas]
    meta = a.dir_saida / f"{nome}__{rep}__checkpoint.json"
    fingerprint = {"checkpoint_sha256":t.sha(a.checkpoint),"config":config,"fontes":b.fontes()}
    if meta.exists() and t.ler(meta) != fingerprint:
        raise ValueError("Modelo/fontes mudaram; nao misturar predicoes")
    t.gravar(meta,fingerprint)
    model, cod = t.criar_modelo(cfg)
    model.load_state_dict(ck["modelo"])
    del ck
    model.eval()
    diagnosticos = {}
    for bancada,path in zip(a.bancadas,paths):
        vistos = retomar(path)
        esperado = set()
        with path.open("a",encoding="utf-8",newline="\n") as f:
            for i, (obj,p) in enumerate(b.paginas(bancada,rep)):
                pid = p["page_id"]
                esperado.add(pid)
                if a.limite and i >= a.limite:
                    break
                if pid in vistos:
                    continue
                # So p entra no preditor; obj contem ouro/palavras e nao e passado.
                inicio = time.perf_counter()
                pred = t.prever(model,cod,p,cfg)
                ids = [u["id"] for u in p["bounding_boxes"]]
                if len(pred) != len(ids) or set(pred) != set(ids) or len(set(pred)) != len(pred):
                    raise ValueError(f"Predicao nao e permutacao: {pid}")
                f.write(json.dumps({"page_id":pid,"ordem":pred},ensure_ascii=False)+"\n")
                f.flush()
                os.fsync(f.fileno())
                diagnosticos[pid] = {"tempo_ms":1000*(time.perf_counter()-inicio),
                    "unidades":len(ids),"hierarquia":cfg.modelo != "lstm" and len(ids)>510}
                if a.limite:
                    # Fumaca real: contrato + regua existente + isolamento do ouro.
                    sem_ouro = {k:v for k,v in p.items() if k != "ordens"}
                    if t.prever(model,cod,sem_ouro,cfg) != pred:
                        raise AssertionError("Preditor depende da referencia de unidades")
                    diagnosticos[pid]["isolamento_ouro"] = True
                    diagnosticos[pid]["metricas_fumaca"] = b.metricas(obj,p,pred)
                if (i+1)%20 == 0:
                    print(f"[inferir] {nome} {rep} {bancada}: {i+1}",flush=True)
        if not a.limite and not vistos <= esperado:
            raise ValueError("Predicoes possuem pagina fora da bancada")
        print(f"[pred] {path}",flush=True)
    t.gravar(a.dir_saida/f"{nome}__{rep}__tempos.json",diagnosticos)
    del model,cod
    gc.collect()
    if a.avaliar:
        for path in paths:
            subprocess.run([sys.executable,"-B",str(RAIZ/"orquestracao/analises/bancada_ordenadores.py"),
                "--avaliar-pred",str(path)],cwd=RAIZ,check=True)
        relatorio_final()


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--checkpoint",type=Path)
    ap.add_argument("--relatorio",action="store_true")
    ap.add_argument("--dir-saida",type=Path,default=t.OUT/"pred")
    ap.add_argument("--bancadas",nargs="+",choices=b.BANCADAS,default=list(b.BANCADAS))
    ap.add_argument("--limite",type=int,default=0)
    ap.add_argument("--avaliar",action="store_true")
    a = ap.parse_args()
    if a.relatorio:
        relatorio_final()
    elif a.checkpoint is None:
        ap.error("Informe --checkpoint ou --relatorio")
    else:
        executar(a)


if __name__ == "__main__":
    if hasattr(sys.stdout,"reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")
    main()

