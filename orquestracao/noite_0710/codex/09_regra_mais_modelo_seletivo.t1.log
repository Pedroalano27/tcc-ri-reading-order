def lote_reader(p, ordem, device):
    n = len(ordem)
    W, H = p["dimensions"]["width"], p["dimensions"]["height"]
    bb = [pontual.normalizar_bbox(p["bounding_boxes"][i]["bbox"], W, H) for i in ordem]
