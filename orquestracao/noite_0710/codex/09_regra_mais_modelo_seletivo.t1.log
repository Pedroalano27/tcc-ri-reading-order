    trocas = {"UmToken": ComTexto, "criar_modelo": criar_modelo,
              "perda": perda, "gravar": gravar,
              "salvar_torch": salvar_torch, "relatorio": relatorio}
    antigos = {k: getattr(t, k) for k in trocas}
    try:
