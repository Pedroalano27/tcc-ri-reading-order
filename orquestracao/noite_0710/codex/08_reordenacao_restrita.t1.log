+            R.pop("parada", None)
+            salvar()
+            ancoras()
+            if args.somente_ancoras:
+                return
+            for co in BANCADAS:
+                if not R["bancadas"].get(co, {}).get("completa"):
+                    processar(co)
+                R["bancadas"][co]["resumos"] = resumos(co, R["bancadas"][co]["paginas"])
+                salvar()
+                publicar(co)
