+    rows = {r["page_id"]: r for r in R["bancadas"][co]["paginas"]}
+    for obj, p in b.paginas(co, "linhas"):
+        vigiar()
+        for m in METODOS[1:]:
+            path = PRED / f"{m}__linhas__{co}.jsonl"
+            with open(path, "rb") as f:
