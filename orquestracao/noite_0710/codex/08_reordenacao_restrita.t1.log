+                          f"{cel(tests['tau']['delta'],6)} | {f(tests['tau']['wilcoxon_veiculo']['p'],6)} | "
+                          f"{sum(d<0 for d in ds)} / {sum(d==0 for d in ds)} / {sum(d>0 for d in ds)} |")
