+def autoteste():
+    # O teste usa a funcao oficial eventos; nao cria outra regua de quebras.
+    base = list(range(12))
+    w1, w2 = (1, 5), (7, 11)
+    alts1 = [base[1:5], [2, 1, 3, 4], [4, 1, 2, 3]]
+    alts2 = [base[7:11], [8, 7, 9, 10], [10, 7, 8, 9]]
