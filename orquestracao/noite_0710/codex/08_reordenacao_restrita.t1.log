+            ls.append(f"| {co} / {g} | {sum(ns[:3])} | "+" | ".join(str(n) for n in ns)+" |")
+    ls += ["", "Coluna atribuída é a proxy global pelo centro da unidade; a tipologia de sucessor usa também a caixa da linha-ouro. "
