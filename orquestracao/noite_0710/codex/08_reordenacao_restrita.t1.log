+    ctx = {"ordem": [u["id"] for u in cs], "mapa": {u["id"]: u for u in cs},
+           "col": {u["id"]: 0 for u in cs}, "margem": {}, "pontes": set()}
+    w = {"lo": 0, "hi": 8, "slots": list(range(8)), "col": 0}
