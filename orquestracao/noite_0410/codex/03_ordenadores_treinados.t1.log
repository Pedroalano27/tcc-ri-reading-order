    txt += ["", "### Linhas e regiões: τ e sucessor", "", "| Variante | Referência | Régua/métrica | Δ (IC por veículo) | p Pratt página | p veículo | p Holm |", "|---|---|---|---:|---:|---:|---:|"]
    for t in R["testes"]:
