+            passos += 1
+            if passos % 10 == 0:
+                print(f"  ep={ep+1} pagina={cursor}/{len(treino)} passo={passos} loss={loss_value:.5f} s={segundos+time.monotonic()-inicio:.1f}", flush=True)
+            if time.monotonic()-ultima_gravacao >= 60:
