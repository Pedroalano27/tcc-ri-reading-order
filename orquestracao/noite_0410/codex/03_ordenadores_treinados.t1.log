+            txt.append(f"| {r['ordenador']} | {r['representacao']} | {r['bancada']} | {group} | {len(rows)} | {met['tau']:.6f} | {met['quebras']:.2f} | {100*met['fid12']:.2f}% | {100*met['sucessor_linhas']:.2f}% | {dt} | {dq} |")
+    txt += ["", "## Veículos vistos nas bancadas humanas", ""]
