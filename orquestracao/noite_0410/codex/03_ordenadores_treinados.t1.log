+
+def auditar():
+    R = {}
+    congelado = ler(UNIDADES / "treino_noite.json")
+    todos = {}
+    for rep in REPS:
+        R[rep] = {}
+        for part in ("treino","validacao","teste"):
+            refs = indice(rep,part)
+            ns, hier = [], []
+            for r in refs:
