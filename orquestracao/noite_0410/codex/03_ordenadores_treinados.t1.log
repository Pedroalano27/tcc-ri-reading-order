+    txt += ["", "## Treinos executados", "", "| Modelo | Representação | Device | Páginas | Visitadas | Passos | Épocas completas | Segundos | τ validação de unidades | Concluído |", "|---|---|---|---:|---:|---:|---:|---:|---:|---|"]
+    for path in sorted(OUT.glob("*/treino.json")):
