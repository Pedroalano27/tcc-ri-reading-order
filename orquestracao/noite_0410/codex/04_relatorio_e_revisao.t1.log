+    OMP_NUM_THREADS="4", MKL_NUM_THREADS="4", OPENBLAS_NUM_THREADS="4",
+    TOKENIZERS_PARALLELISM="false")
+import numpy as np
+from orquestracao.analises import bancada_ordenadores as b
