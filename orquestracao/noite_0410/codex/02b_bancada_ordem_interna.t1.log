+            f.seek(off)
+            l = f.readline()
+            off = f.tell()
+        if not l:
+            return
+        i += 1
+        if l.strip():
+            try:
+                yield json.loads(l.decode("utf-8"))
+            except (UnicodeError, json.JSONDecodeError) as exc:
+                raise ValueError(f"JSONL invalido {path}:{i}") from exc
 
 
