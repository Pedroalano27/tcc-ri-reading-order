                nome = v["ordenador"] + (" (parcial)" if not v["completa"] else "")
                ls.append(f"| {v['representacao']} | {nome} | {g} | {s['n']} | " + " | ".join([
                    cel(ms["tau"]), cel(ms["quebras"], n=2), cel(ms["quebras_mil"], n=2),
