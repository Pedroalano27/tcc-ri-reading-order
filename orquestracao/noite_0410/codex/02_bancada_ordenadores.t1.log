+    if R.get("modelo_layoutreader"):
+        ls += ["LayoutReader carregado: `" + json.dumps(R["modelo_layoutreader"], ensure_ascii=False) + "`.", ""]
+    if R.get("progresso"):
+        ls += ["Progresso persistido: `" + json.dumps(R["progresso"], ensure_ascii=False) + "`.", ""]
+    if R.get("bloqueio"):
