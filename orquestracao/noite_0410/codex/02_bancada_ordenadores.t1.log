+         "bounding_boxes": [{"id": "a", "ks": [0,2,1]+list(range(3,8)), "text": "a", "tipo": "texto", "bbox": [0,10,50,20]},
+                            {"id": "b", "ks": list(range(8,15)), "text": "b", "tipo": "texto", "bbox": [0,30,50,40]}]}
