+                            R["bloqueio"] = "Prazo --max-minutos atingido; retome o mesmo comando."
+                            salvar(R)
+                            return
+                        key = f"{m}__{rep}__{b}"
+                        pronto = R["resultados"].get(key, {})
+                        if pronto.get("completa"):
