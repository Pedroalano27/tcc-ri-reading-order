+    return "\n".join(ls)
+
+
+def conferir(R):
+    exigir(R["fontes"] == fontes(), "Fontes alteradas")
+    exigir(MD.read_text(encoding="utf-8") == relatorio(R), "Markdown diverge do JSON")
