+            ver = verificar(contexto, feitos, i == len(contexto["plano"]))
+            relatorio(contexto, feitos, anc, i == len(contexto["plano"]), ver,
+                      {"tempo_s": time.perf_counter()-t0, "memoria": memoria(), "paginas_novas": nnovas})
