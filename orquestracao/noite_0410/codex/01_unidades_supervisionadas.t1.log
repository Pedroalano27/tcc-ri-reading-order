+
+OUT = RAIZ / "resultados/unidades_sem_caixas"
+MD = RAIZ / "resultados/unidades_sem_caixas.md"
+REPS = ("linhas", "colunas", "colunas_margens")
+SEMENTE = 20261004
+VERSAO = "unidades-v1"
+MODELO = None
+HASHES_PDF = {}
