+
+def percentil(xs, p):
+    xs = sorted(xs)
+    i = (len(xs)-1)*p
+    a = int(i)
+    return xs[a] + (xs[min(a+1, len(xs)-1)]-xs[a])*(i-a)
+
+
+def exportar(contexto, feitos):
+    """Transacao por arquivo: escreve shards sem juntar paginas em memoria."""
+    destinos = collections.defaultdict(list)
