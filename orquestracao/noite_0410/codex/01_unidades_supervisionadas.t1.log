+            for p in obj["representacoes"].values():
+                auditar_pagina(p, len(obj["palavras"]))
+            retomada = True
+        else:
+            try:
+                obj, retomada = processar(m, contexto)
+            except Exception:
+                exportar(contexto, feitos)
+                ver = verificar(contexto, feitos, False)
+                relatorio(contexto, feitos, anc, False, ver,
