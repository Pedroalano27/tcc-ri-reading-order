+                raise
+        feitos.append(m)
+        nnovas += not retomada
+        print(f"[{i}/{len(contexto['plano'])}] {m['particao']} {m['page_id']} "
+              f"unidades={','.join(str(len(p['bounding_boxes'])) for p in obj['representacoes'].values())} "
+              f"tempo={obj['tempo_s']:.2f}s {'cache' if retomada else 'nova'}", flush=True)
