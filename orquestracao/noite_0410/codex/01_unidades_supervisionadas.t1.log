+            vistos[(m["particao"], obj["veiculo_visto_treino"])] += 1
+        estratos = [m["particao"]]
+        if m["colecao"] == "bancadas":
+            estratos.append(m["particao"] + ("_veiculos_vistos" if obj["veiculo_visto_treino"] else "_veiculos_nao_vistos"))
+        for rep, p in obj["representacoes"].items():
