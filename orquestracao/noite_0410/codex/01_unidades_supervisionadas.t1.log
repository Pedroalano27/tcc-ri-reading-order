+        except Exception as exc:
+            gravar(MD, "# Unidades sem caixas finas — interrompido nas âncoras\n\n"+str(exc)+"\n\nNenhum número novo de representação foi publicado. Consulte `ancoras.json` e caches por página.\n")
+            raise
