+            raise
+    # Incluir todos os caches prontos ANTES de publicar shards parciais. Assim
+    # uma retomada nao apaga paginas prontas nem compara shards antigos a uma
+    # lista que ainda nao chegou a elas no laco desta invocacao.
+    feitos = []
