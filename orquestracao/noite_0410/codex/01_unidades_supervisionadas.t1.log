+                    g["sem_ref"] += c["n_palavras_referencia"] == 0
+                    g["atravessam"] += c["atravessa_referencia"]
+                    g["palavras"] += c["n_palavras_referencia"]
+                    g["palavras_ruins"] += c["n_palavras_fora_ordem_vizinha"]
+    stats = []
+    for (part, rep), g in sorted(grupos.items()):
