def entradas(qs):
    ps = list(o.ENTRADAS) + list(o.FONTES) + [Path(o.__file__), Path(j.__file__), Path(__file__), PESOS,
        RAIZ / "src/data/taxonomia_layout.py", RAIZ / "Ultralytics/settings.json"]
