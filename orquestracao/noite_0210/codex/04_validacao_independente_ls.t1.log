+
+def f(x,n=3):
+    return "—" if x is None else f"{x:.{n}f}".replace(".",",")
+
+
+def cel(e,percent=False):
+    esc = 100 if percent else 1
+    if e["media"] is None:
+        return "—"
+    n = 1 if percent else 3
+    return f"{f(e['media']*esc,n)}{'%' if percent else ''} [{f(e['ic'][0]*esc,n)}; {f(e['ic'][1]*esc,n)}]"
+
