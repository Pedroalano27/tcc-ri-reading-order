+    for m in metodos:
+        if m not in S:
+            continue
+        s=S[m]
+        out.append(f"| {NOMES[m]} | {s[regua]['tau']['n']} | {cel(s[regua]['tau'])} | {cel(s[regua]['sucessor'],True)} | {cel(s[regua]['ard'])} | {cel(s['fragmentacao'],True)} |")
+    return out
