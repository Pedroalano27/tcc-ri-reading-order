+       {"id":"v","bbox":[0,120,70,160],"classe":"figure","text":""}]}
+    ws=[["a",1,21,10,30],["b",1,41,10,50],["c",91,21,100,30],["d",91,41,100,50]]
+    q=referencia(p,{"ordem":["a","b","v"]},ws)
+    r=avaliar(q,[0,2,1,3])
