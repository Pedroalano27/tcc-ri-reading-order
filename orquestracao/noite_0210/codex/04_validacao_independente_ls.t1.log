+    p={"dimensions":{"width":200,"height":300},"bounding_boxes":[
+       {"id":"a","bbox":[0,20,70,100],"classe":"paragraph","text":"a b"},
+       {"id":"b","bbox":[90,20,160,100],"classe":"paragraph","text":"c d"},
