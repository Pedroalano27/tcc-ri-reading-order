+    maior = 0.
+    for rank,i in enumerate(sorted(range(len(out)),key=lambda i:out[i]["p_pratt"])):
+        maior = max(maior,min(1.,out[i]["p_pratt"]*(len(out)-rank)))
+        out[i]["p_holm"] = maior
+    return out
