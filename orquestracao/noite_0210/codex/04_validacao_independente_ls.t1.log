+        rs = []
+        for b in pred.boxes:
+            nome = pred.names[int(b.cls.item())]
+            if nome not in ("texto", "tabela", "imagem"):
+                raise ValueError(f"Classe inesperada no ls3: {nome}")
+            if nome == "texto":
+                continue
+            px = [float(v) for v in b.xyxy[0].tolist()]
