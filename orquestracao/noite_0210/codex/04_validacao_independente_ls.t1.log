+def assinatura_numerica(R):
+    return hashlib.sha256(json.dumps({"resumos":R.get("resumos"),"golden":R.get("golden_resumo"),
+                         "auditoria":R.get("auditoria")},sort_keys=True,ensure_ascii=False).encode()).hexdigest()
