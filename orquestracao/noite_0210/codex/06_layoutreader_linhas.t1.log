+    orig = {p["page_id"]:p for p in antigo["sequencias_cv"]}
+    if any(cs[i].id != orig[q["p"]["page_id"]]["config"] for q,i in zip(ps,ids)):
+        raise ValueError("Configurações LOPO não reproduzem o experimento anterior")
