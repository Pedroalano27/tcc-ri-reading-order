+    for j,q in enumerate(ps):
+        pid = q["p"]["page_id"]
+        if pid not in completos:
+            R["grade_paginas"].append({"page_id":pid,"metricas":grade_pagina(q,cs)})
+            gravar(R,parcial(R))
+        print(f"[grade {j+1}/{len(ps)}] {pid}",flush=True)
+    R["grade_paginas"].sort(key=lambda p:p["page_id"])
+    ids = selecionar(R,cs)
