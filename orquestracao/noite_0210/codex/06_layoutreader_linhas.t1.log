+
+def hashes():
+    caminhos = o.ENTRADAS + o.FONTES + [Path(o.__file__), Path(justo.__file__),
+        Path(__file__), ORIGINAL, MODELO / "config.json", MODELO / "model.safetensors",
+        MODELO / "README.md"]
+    return {p.relative_to(RAIZ).as_posix(): justo.digest(p) for p in caminhos}
