+        if all(anterior.get("hashes",{}).get(k)==v for k,v in H.items() if k!=Path(__file__).relative_to(RAIZ).as_posix()) and anterior.get("parametros")==params:
+            for a,b in zip(rows,anterior["paginas"]):
+                for m in NOMES:
