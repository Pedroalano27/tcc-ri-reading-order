+    txt = ["# LayoutReader — execução parcial", "", "Sem veredito até concluir a amostra.", "",
+           f"Grade reproduzida em {len(R['grade_paginas'])} páginas; variantes executadas em {len(rows)} páginas.", ""]
+    if rows:
