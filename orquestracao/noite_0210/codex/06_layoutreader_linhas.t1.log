+                "metodos":metodos,"ordens_r":ordens,"gt_r":q["gt_r"],"campos":campos})
+            gravar(R,parcial(R))
+        print(f"[variantes {j+1}/{len(ps)}] {pid}",flush=True)
+    R["paginas"].sort(key=lambda p:p["page_id"])
+    rows = R["paginas"]
+    erros = []
+    antigos = {p["page_id"]:p for p in antigo["por_pagina"]}
