    taus = np.array([[r["regioes"]["tau"] for r in vr[c.id]] for c in cs])
    sucs = np.array([[r["regioes"]["sucessor"] for r in vr[c.id]] for c in cs])
    total_t, total_s = taus.sum(axis=1), sucs.sum(axis=1)
