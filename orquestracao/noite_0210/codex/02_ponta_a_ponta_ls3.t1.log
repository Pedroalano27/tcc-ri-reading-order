+        if pid in prontas:
+            continue
+        row = {"page_id": pid, "veiculo": q["veiculo"], "colunas": q["colunas"],
+               "auditoria": q["auditoria"], "bases": bases(q), "variantes": {}, "qualidade": {}}
+        for fonte in FONTES:
