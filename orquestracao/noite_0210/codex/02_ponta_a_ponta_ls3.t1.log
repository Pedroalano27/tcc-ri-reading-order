+    g = {"diamond_ouro": [{"id": "a", "classe": "tabela", "bbox": [0, 0, 10, 10]}],
+         "ls3": [{"id": "1", "classe": "tabela", "bbox": [0, 0, 10, 10], "score": .9},
+                 {"id": "2", "classe": "tabela", "bbox": [0, 0, 10, 10], "score": .8}]}
+    if qualidade(g, "ls3", .25)["tabela"]["tp"] != 1:
