+def controles():
+    """Casos substantivos: intercalacao, paginas/caixas vazias, pixels e IoU."""
+    q = {"ws": [["a", 0, 0, 1, 1], ["b", 0, 2, 1, 3], ["c", 2, 0, 3, 1], ["d", 2, 2, 3, 3]],
