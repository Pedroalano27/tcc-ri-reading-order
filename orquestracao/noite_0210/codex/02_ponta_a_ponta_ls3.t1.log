+    T = np.array([[1, .4, .2], [.2, .8, .4], [.4, .6, .9]])
+    U = np.array([[.1, .2, .3], [.3, .2, .1], [.5, .5, .5]])
+    W = np.array([[1, 1, 1], [2, 1, 1], [0, 4, 2]])
+    excluidos = [[p] for p in range(T.shape[1])]
+    ids = escolher(T, U, W, excluidos)
+    for b, w in enumerate(W):
+        for p in range(T.shape[1]):
