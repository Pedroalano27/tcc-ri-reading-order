+    print("[OK] Relatório bate com resultados salvos; 44 predições únicas, conversão px→pt e grade conferidas.")
+    print("Veredito:", veredito(R))
+    print("\n".join(tabela(R, PRINCIPAIS, "palavras")))
+    return R
