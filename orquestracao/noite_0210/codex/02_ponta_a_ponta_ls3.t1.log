+def estratos(R, qs, metodos, W):
+    out = {}
+    for rotulo, ids in (("uma coluna geométrica", [i for i, q in enumerate(qs) if q["colunas"]["n"] == 1]),
+                        ("multicoluna geométrica", [i for i, q in enumerate(qs) if q["colunas"]["n"] > 1])):
+        if not ids:
