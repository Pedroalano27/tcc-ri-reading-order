+        sx, sy = p["escala_px_pt"]
+        for b in p["regioes"]:
+            px = b["bbox_px"]
+            if not np.allclose(b["bbox"], [px[0]*sx, px[1]*sy, px[2]*sx, px[3]*sy], rtol=0, atol=1e-10):
+                raise ValueError("Conversão pixels/pontos inconsistente")
