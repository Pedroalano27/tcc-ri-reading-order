+        out.append(f"| {NOMES[n]} | {cel(s[regua]['tau'])} | {cel(s[regua]['sucessor'],True)} | {cel(s[regua]['ard'])} | {f(100*s['fragmentacao']['media'],1)}% |")
+    return out
