+    if a["regioes"]["tau"] != 1 or not (a["palavras"]["tau"] < 1 and a["diag"]["fracao"] == 1):
+        raise ValueError("Regua principal nao detecta intercalacao")
+    vazia = {"ws": [], "p": {"bounding_boxes": [{"id": "Z", "bbox": [0, 0, 10, 10]}]},
