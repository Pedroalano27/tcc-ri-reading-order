+                        ("multicoluna geométrica", [i for i, q in enumerate(qs) if q["colunas"]["n"] > 1])):
+        if not ids:
+            continue
+        ss = {}
+        for nome in PRINCIPAIS:
+            ss[nome] = {m: resumir([metodos[nome][i]["palavras"][m] for i in ids], W[:, ids])[0] for m in METRICAS}
