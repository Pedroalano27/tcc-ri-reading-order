+        razoes = []
+        if capt_b > capt_a:
+            razoes.append(f"ls3 põe {capt_b-capt_a} palavras textuais adicionais em átomos; possível fusão indevida")
+        elif capt_b < capt_a:
+            razoes.append(f"ls3 libera {capt_a-capt_b} palavras textuais antes capturadas por átomos Docling")
