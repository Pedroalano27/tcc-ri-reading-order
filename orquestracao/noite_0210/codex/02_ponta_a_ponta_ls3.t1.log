+         "gt_r": ["A", "B"], "gt_l": ["A0", "A1", "B0", "B1"], "gt_w": [0, 1, 2, 3],
+         "reg_words": {"A": [0, 1], "B": [2, 3]},
+         "gold_lines": [{"id": s, "ks": [k], "bbox": [0, k, 1, k+1]} for k, s in enumerate(["A0", "A1", "B0", "B1"])]}
