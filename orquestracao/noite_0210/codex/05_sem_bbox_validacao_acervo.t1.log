+        if sha(RAIZ / path) != h:
+            raise ValueError("Entrada/fonte mudou durante a execução: " + path)
+    gravar(ESTADO, s)
+    escrever_relatorio(s)
+    imprimir(s)
+
+
+if __name__ == "__main__":
+    main()

