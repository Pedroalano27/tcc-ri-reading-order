+    for nome, label in CONJUNTOS.items():
+        res = s["conjuntos"][nome]
+        if not res["n"]:
+            continue
+        for m, ml in METODOS.items():
+            r = res["metodos"][m][regua]
+            out.append(f"| {label} | {res['n']} / {res['veiculos']} | {ml} | {ic(r['tau'])} | {ic(r['sucessor'], True)} | {ic(r['ard'])} |")
