+def autoteste():
+    """Casos de borda e contraprova da mediana sem usar assert."""
+    def exigir(cond, mensagem):
+        if not cond:
+            raise ValueError("Autoteste falhou: " + mensagem)
+    p = {"page_id": "sintetica", "dimensions": {"width": 100, "height": 100},
