+        unica.setdefault(r["page_id"], r)
+    piores = sorted(unica.values(), key=lambda r: (r["metodos"]["fixo"]["palavras"]["tau"] - r["metodos"]["xycut"]["palavras"]["tau"], r["page_id"]))[:8]
