+                l.append(f"| {CONJUNTOS[nome]} | {t['regua']} | {METODOS[t['referencia']]} | {t['metrica']} | {ic(t, nd=5)} | [{fmt(ip[0], nd=5)}; {fmt(ip[1], nd=5)}] | {t['ganha']}/{t['empata']}/{t['perde']} | {fmt(t['pagina']['p'], nd=6)} | {fmt(t.get('p_holm'), nd=6)} | {fmt(t['veiculo']['p'], nd=6)} |")
