+def ic(s, pct=False, nd=3):
+    if s["media"] is None:
+        return "—"
+    a, b = s["ic"]
+    return f"{fmt(s['media'], pct, nd)} [{fmt(a, pct, nd)}; {fmt(b, pct, nd)}]"
