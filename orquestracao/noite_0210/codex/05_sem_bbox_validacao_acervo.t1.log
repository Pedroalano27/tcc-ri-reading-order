+                if r["fonte"] == "A":
+                    labels.append("grupo/" + r["grupo"])
+                for label in labels:
+                    grupos.setdefault(label, []).append(r)
+            estratos[nome] = {k: resumir(v, inferencia=False) for k, v in sorted(grupos.items())}
+    novas = [r for r in paginas if not r["repetida"] and r["status"] == "ok"]
