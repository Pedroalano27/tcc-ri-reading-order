+            for q in [q for q in amostra if q["p"]["page_id"] == pid]:
+                fingerprint = digest([VERSAO, fontes_hash, q, extraido["fingerprint"], dets.get(pid), FIXA.id, SEM_MARGENS.id])
+                cp = CACHE / "avaliacao_acervo" / (q["fonte"] + "_" + chave(pid) + ".json")
