+    ap.add_argument("--autoteste", action="store_true")
+    ap.add_argument("--workers", type=int, default=2)
+    args = ap.parse_args()
+    tests = autoteste()
+    if args.autoteste:
+        print("[OK] " + "; ".join(tests))
+        return
+    if args.conferir:
