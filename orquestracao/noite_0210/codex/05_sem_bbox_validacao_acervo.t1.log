+def escrever_relatorio(s):
+    texto = renderizar(s)
+    tmp = RELATORIO.with_suffix(".md.tmp")
+    with open(tmp, "w", encoding="utf-8", newline="\n") as f:
+        f.write(texto)
+    os.replace(tmp, RELATORIO)
