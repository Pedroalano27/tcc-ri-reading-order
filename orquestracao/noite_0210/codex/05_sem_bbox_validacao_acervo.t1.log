+def selecionar(paginas, nome):
+    fonte = nome[0]
+    rs = [r for r in paginas if r["fonte"] == fonte]
+    if nome.endswith("novas"):
+        return [r for r in rs if not r["repetida"]]
+    if nome.endswith("repetidas"):
+        return [r for r in rs if r["repetida"]]
+    return rs
+
