+def fmt(x, pct=False, nd=3):
+    if x is None:
+        return "—"
+    return (f"{100 * x:.1f}%" if pct else f"{x:.{nd}f}").replace(".", ",")
+
+
+def ic(s, pct=False):
+    if s["media"] is None:
+        return "—"
+    a, b = s["ic"]
+    return f"{fmt(s['media'], pct)} [{fmt(a, pct)}; {fmt(b, pct)}]"
+
