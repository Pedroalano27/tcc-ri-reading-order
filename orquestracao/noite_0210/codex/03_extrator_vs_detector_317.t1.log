+def avaliar(paginas, auditoria, B, status):
+    sistemas = {"extrator": {}}
+    for nome in ("ls3", "ls16"):
+        if status[nome]["incluido"]:
+            sistemas[nome] = {}
+    palavras = {}
+    for p in paginas:
+        w = ler(caminho_cache(p, "palavras"))
