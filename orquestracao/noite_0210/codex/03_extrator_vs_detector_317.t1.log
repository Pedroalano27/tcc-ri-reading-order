+        linhas.append(f"| {n} | {cobertura[n]} | " + " | ".join(vals) + f" | {numero(r['latencias'][n].get('media_ms'), 1)} |")
+    for n in ausentes:
+        linhas.append(f"| {n} (fora) | 0 | — | — | — | — | — | — | — |")
