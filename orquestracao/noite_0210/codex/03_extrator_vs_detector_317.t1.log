+                if k % 10 == 0 or k == len(paginas):
+                    print(f"[palavras] {k}/{len(paginas)}; novas {novas}", flush=True)
+                    if novas > ultimo_relatorio:
+                        avaliar(paginas, auditoria, a.bootstrap, status)
