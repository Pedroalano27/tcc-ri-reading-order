+        exemplo = perdidos[0] if perdidos else p["ouro"][0] if p["ouro"] else None
+        trecho = re.sub(r"\s+", " ", exemplo["texto"])[:140] if exemplo else ""
+        detalhe = ""
+        if exemplo:
