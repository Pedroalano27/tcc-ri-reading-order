+    melhores = [n for n in ("ls3", "ls16") if len(metricas.get(n, {})) == len(paginas)]
+    melhor = max(melhores, key=lambda n: resumo[n]["c3_50"]["f1"]) if melhores else None
+    pareado = None
+    if melhor:
+        ids = sorted(set(metricas["extrator"]) & set(metricas[melhor]))
+        if ids:
