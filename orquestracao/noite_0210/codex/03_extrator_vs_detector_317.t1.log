import json,pathlib,collections
r=pathlib.Path('.'); dec=json.JSONDecoder()
def it(f):
 with f.open(encoding='utf-8') as h:
  b=''; eof=False; started=False
  while True:
   if not eof and len(b)<65536:
    c=h.read(65536); eof=not c;b+=c
   b=b.lstrip()
   if not started:
    if not b:break
    assert b[0]=='[';b=b[1:];started=True;continue
   b=b.lstrip(' ,\\r\\n\\t')
   if b.startswith(']'):break
   try:o,n=dec.raw_decode(b)
   except json.JSONDecodeError:
    if eof:raise
    b+=h.read(65536); continue
   yield o;b=b[n:]
for f in r.glob('data/labelstudio/ls_p*_seed*.json'):
 if 'order' in f.name:continue
 counts=collections.Counter(); nann=collections.Counter(); origins=collections.Counter(); mult=0
 for o in it(f):
  anns=[a for a in o.get('annotations',[]) if not a.get('was_cancelled')];nann[len(anns)]+=1
  for a in anns:
   counts[str(a.get('completed_by'))]+=1
   for x in a.get('result',[]):
    if x.get('type')=='labels':origins[x.get('origin','ausente')]+=1
 print(f.name,'annotations per task',nann,'annotators',counts,'labels origin',origins)
