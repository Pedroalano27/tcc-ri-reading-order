+def status_detectores():
+    status = {}
+    for n in ("ls3", "ls16"):
+        ok = (RAIZ / f"runs/detect/{n}/treino_ok").is_file()
+        peso = (RAIZ / f"runs/detect/{n}/weights/best.pt").is_file()
+        status[n] = {"treino_ok": ok, "checkpoint": peso, "incluido": ok and peso,
