+    print(f"Relatorio: {RELATORIO}\nEvidencia: {CACHE / 'metricas.json'}", flush=True)
+    if resultado["cobertura"]["extrator"] != len(paginas):
+        raise SystemExit("Execucao incompleta: consultar falhas e retomar")
+
+
+if __name__ == "__main__":
+    main()

