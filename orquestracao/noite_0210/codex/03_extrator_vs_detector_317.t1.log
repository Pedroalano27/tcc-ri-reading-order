+                print(f"[extrator ERRO] {p['page_id']}: {e}", flush=True)
+            if k % 10 == 0 or k == len(paginas):
+                print(f"[extrator] {k}/{len(paginas)}; erros {len(erros)}", flush=True)
+                avaliar(paginas, auditoria, a.bootstrap, status)
