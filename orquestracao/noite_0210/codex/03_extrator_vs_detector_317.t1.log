+            a = np.array([x["bbox"] for x in g], dtype=float).reshape(-1, 4)
+            b = np.array([x["bbox"] for x in pred], dtype=float).reshape(-1, 4)
+            inter = np.maximum(0, np.minimum(a[:, None, 2:], b[None, :, 2:])-
