+def escrever_relatorio(r, paginas, sistemas, palavras):
+    nomes = list(sistemas)
+    cobertura = r["cobertura"]
+    completa = cobertura.get("extrator", 0) == r["n_paginas"]
+    ausentes = [n for n, s in r["status_detectores"].items() if not s["incluido"]]
+    pareado = r["pareado"]
