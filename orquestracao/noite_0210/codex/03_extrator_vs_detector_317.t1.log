            "documentos": [{"ids": d["ids"], "comeca_em_pagina_anterior": d["comeca_antes"],
                            "continua_na_proxima_pagina": d["continua_depois"]}
                           for d in p["documentos"]],
            "problemas": [list(x) for x in p["problemas"]],
