+            ids = [p["page_id"] for p in paginas if p["page_id"] in palavras and p["page_id"] in metricas[nome]
+                   and (palavras[p["page_id"]]["texto_escasso"] if tipo == "texto_escasso"
+                        else palavras[p["page_id"]]["sem_texto"] == (tipo == "sem_texto"))]
