+        latencias[nome] = ({"n": len(lat), "media_ms": float(lat.mean()), "mediana_ms": float(np.median(lat)),
+                           "p95_ms": float(np.percentile(lat, 95)), "total_s": float(lat.sum()/1000)} if len(lat) else {})
+        fontes = defaultdict(list)
