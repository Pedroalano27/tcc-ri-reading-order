+    for n in nomes:
+        for k, v in r["resumo"][n].items():
+            linhas.append(f"| {n} / {k} | " + " | ".join(map(str, v["contagens"])) + f" | {numero(v['f1'])} | {numero(v['f1_macro'])} |")
+    linhas += ["", "## Páginas com e sem camada de texto", "", "Sem texto = nenhuma palavra alfanumérica extraída; isso sugere digitalização, mas não prova ausência de texto visual. Página digitalizada com OCR embutido pertence ao grupo com texto. Texto escasso (<5 palavras) é também mostrado como subconjunto de com texto; não é somado de novo ao total.", "",
