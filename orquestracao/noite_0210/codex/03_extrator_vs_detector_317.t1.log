+           "auditoria_split": auditoria_split, "sensibilidade_alias": sensibilidade,
+           "n_ouro": sum(len(p["ouro"]) for p in paginas), "n_ouro3": sum(mapa3(b["classe"]) is not None for p in paginas for b in p["ouro"]),
