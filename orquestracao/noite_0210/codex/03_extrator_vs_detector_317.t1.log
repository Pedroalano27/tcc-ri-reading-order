+                           f"classe predita {pred[j]['classe']}; "
+                           + ("geometria abaixo do limiar." if ious[j] < .5 else "a classe ou a disputa um a um impede o par com classe."))
+            else:
+                detalhe = "O extrator não produziu caixa nessa página."
