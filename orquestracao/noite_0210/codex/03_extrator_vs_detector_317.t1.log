    arq = os.path.join(dir_lote, "tarefas.jsonl")
    existentes = ler_jsonl(arq)
    ja = {t["page_id"] for t in existentes}
    escolhidas = escolher([t for t in fonte if t["page_id"] not in ja], a.n, f"{a.semente}-{a.lote}-{len(existentes)}")
    if not escolhidas:
