+                    tw=time.perf_counter()-t0
+                    ds,ts,err=detectar(pg,"plumber",incluir_text=variant=="rapido_text")
+                    td=time.perf_counter()-t0-tw
+                    aux=dict(p=p,ws=ws,h=statistics.median(w[4]-w[2] for w in ws) if ws else 10)
