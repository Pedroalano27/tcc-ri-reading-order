+    return chave(dict(golden=R.get('golden'),ls=R.get('ls'),
+                 palavras=[dict(page_id=r['page_id'],comparacao=r['comparacao'],
+                      invisiveis=r['invisiveis'],duplicatas=r['duplicatas']) for r in R.get('palavras',[])]))
