+        ck=chave([chave_base,digest(path),asdict(c),threads,sem_docling])
+        arq=arquivo_cache("tempo",pid)
+        r=None if do_zero else ler(arq)
+        if not r or r.get("chave")!=ck:
+            r=dict(page_id=pid,chave=ck,threads=threads)
