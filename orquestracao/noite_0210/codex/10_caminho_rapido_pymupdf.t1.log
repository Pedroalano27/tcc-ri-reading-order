+            v=s[cls]
+            out.append(f"| {DET_NOMES[nome]} | {rot} | {v['tp']} / {v['fp']} / {v['fn']} | {pct(v['precisao'])} | {pct(v['recall'])} | {pct(v['f1'])} |")
+    return out
