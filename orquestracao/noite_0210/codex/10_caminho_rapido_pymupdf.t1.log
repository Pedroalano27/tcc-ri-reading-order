+                    to=time.perf_counter()-start
+                r[variant]=dict(total=time.perf_counter()-t0,palavras=tw,regioes=td,ordem=to,
+                                n_palavras=len(seq),erros=err)
+            if sem_docling:
+                r["docling_erro"]="Detector ao vivo desativado explicitamente"
+            else:
+                try:
