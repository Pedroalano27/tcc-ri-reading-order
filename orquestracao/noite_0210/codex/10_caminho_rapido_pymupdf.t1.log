+              if r["metodos"][nome]["diag"]["fracao_estrita"] is not None]
+        out.append(f"| {NOMES[nome]} | {cel(ss['tau'])} | {cel(ss['sucessor'],True)} | {cel(ss['ard'])} | {pct(statistics.mean(frag) if frag else None)} |")
+    return out
