+            sx,sy = W/w,H/h
+            px = dict(p,bounding_boxes=[dict(r,bbox=[r["bbox"][0]/sx,r["bbox"][1]/sy,
+                  r["bbox"][2]/sx,r["bbox"][3]/sy]) for r in p.get("bounding_boxes",[])
+                  if valido(r.get("bbox",[]))])
+            row["escala_pt_px"] = [sx,sy]
+            row["aspecto_erro"] = abs(sx/sy-1)
