+        if vs:
+            out.append(f"| {label} | {len(vs)} | {f(statistics.mean(vs))} | {f(statistics.median(vs))} | {f(float(np.percentile(vs,95)))} | {f(len(vs)/sum(vs),2)} |")
+    return out
