+def benchmark(qs, rows, do_zero, chave_base, threads, sem_docling, ao_salvar=None):
+    """Latencia fim-a-fim de ambos os pipelines, mesmas paginas e geometria."""
+    import pdfplumber
+    model=None; carga=None; out=[]
