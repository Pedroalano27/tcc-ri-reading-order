RE_CID = re.compile(r"\(cid:\d+\)")
# Palavra cortada no fim da linha: hifen COLADO na palavra e continuacao em minuscula.
RE_TRANSLINEACAO = re.compile(r"(\w{2,})-\s+([a-zà-ÿ])")
