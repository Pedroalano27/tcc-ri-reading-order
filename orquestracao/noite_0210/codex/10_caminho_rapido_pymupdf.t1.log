GUIA = tuple(LABELS_GUIA)  # 16 classes

# --- Guia -> 9 classes do extrator atual (colapso; sempre bem definido) ---
GUIA_PARA_EXTRATOR = {
    "act": "titulo", "act section": "titulo",
    "title": "titulo", "section title": "titulo", "sub section title": "titulo",
    "paragraph": "texto",
