+                        start=time.perf_counter(); seq,diag=prever(aux,ds,c); to=time.perf_counter()-start
+                    r["docling"]=dict(total=time.perf_counter()-t0,palavras=tw,render=tr,regioes=td,
+                                      ordem=to,n_palavras=len(seq))
