+    for z,q in enumerate(qs):
+        p=q['p'];path=RAIZ/'data/raw'/p['uf']/p['arquivo']
+        key=chave([ck,digest(path),p['pagina'],'plumber'])
+        raw=linha_rapida(p,path,'plumber',int(p['pagina']),key,args.do_zero)
