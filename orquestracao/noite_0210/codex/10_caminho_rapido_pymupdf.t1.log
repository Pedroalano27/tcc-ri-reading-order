+                        gravar(BASE/"modelo.json",dict(carga_s=carga,threads=threads,device="cpu"))
+                    from src.data.layout import DPI
+                    t0=time.perf_counter()
+                    with pdfplumber.open(util) as doc:
+                        pg=doc.pages[int(p["pagina"])]
