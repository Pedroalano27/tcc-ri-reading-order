PESOS = RAIZ / "runs/detect/ls3/weights/best.pt"
MARCADOR = "ORDEM_SEM_BBOX_LS3_CHECKPOINT_V1"
REGUAS = ("palavras", "linhas", "regioes")
METRICAS = ("tau", "sucessor", "ard")
FONTES = ("docling", "ls3", "ouro", "nenhum", "texto_ls3")
NOMES = {
    "xy_ouro": "XY-cut regiões-ouro, pura†",
    "xy_ouro_margens": "XY-cut regiões-ouro + mesmas margens†",
    "docling": "(a) Linhas + átomos Docling, LOPO",
    "ls3": "(b) Linhas + átomos ls3, LOPO",
    "ouro": "(c) Linhas + átomos ouro, LOPO†",
    "nenhum": "(d) Linhas, sem átomos, LOPO",
    "texto_ls3": "Caixas texto/tabela/imagem ls3 + XY-cut, LOPO",
    "ls3_comum": "ls3 nos parâmetros LOPO do Docling",
    "ouro_comum": "Ouro nos parâmetros LOPO do Docling†",
    "nenhum_comum": "Sem átomos nos parâmetros LOPO do Docling",
    "docling_regioes": "Docling, LOPO por τ de regiões (legado)",
}
PRINCIPAIS = ("xy_ouro", "xy_ouro_margens") + FONTES


def escrever(path, texto):
    """Fecha e sincroniza cada checkpoint antes de continuar o calculo."""
    with path.open("w", encoding="utf-8", newline="\n") as f:
        f.write(texto)
        f.flush()
        os.fsync(f.fileno())


def digest(p):
    return j.digest(p)


def entradas(qs):
    ps = list(o.ENTRADAS) + list(o.FONTES) + [Path(o.__file__), Path(j.__file__), Path(__file__), PESOS,
        RAIZ / "src/data/taxonomia_layout.py", RAIZ / "Ultralytics/settings.json"]
    ps += [RAIZ / f"data/diamond/{l}/anotacoes.jsonl" for l in ("diamond_piloto", "diamond_treino")]
    ps += [RAIZ / "data/golden/golden_v4/img" / q["p"]["imagem"] for q in qs]
    return {p.relative_to(RAIZ).as_posix(): digest(p) for p in ps}


def preparar():
    qs = j.preparar()
    anns = {l: j.ler_jsonl(RAIZ / f"data/diamond/{l}/anotacoes.jsonl")
            for l in ("diamond_piloto", "diamond_treino")}
    for q in qs:
        p = q["p"]
        aa = [a for a in anns[p["origem"]] if a.get("page_id") == p["page_id"]
              and a.get("status") == "concluida"
              and a.get("salvo_em") == p.get("diamond", {}).get("salvo_em")]
        if len(aa) != 1:
            raise ValueError(f"Revisão Diamond congelada ausente/ambígua: {p['page_id']}")
        q["diamond_ouro"] = aa[0].get("regioes", [])
        for r in q["diamond_ouro"]:
            if len(r.get("bbox", [])) != 4 or o.area(r["bbox"]) <= 0:
                raise ValueError(f"Caixa Diamond inválida: {p['page_id']} {r}")
        q["veiculo"] = p["page_id"].split("/", 1)[0]
        q["colunas"] = j.colunas(q)
    return qs


def carregar_md():
    if not MD.exists():
        return None
    t = MD.read_text(encoding="utf-8")
    m = re.search(r"<!-- " + MARCADOR + r"\n([A-Za-z0-9+/=]+)\n-->", t)
    if not m:
        return None
    try:
        return json.loads(zlib.decompress(base64.b64decode(m.group(1))))
    except (ValueError, zlib.error):
        return None


def salvar_md(R, texto):
    raw = json.dumps(R, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
    ck = base64.b64encode(zlib.compress(raw, 9)).decode("ascii")
    escrever(MD, texto + f"\n<!-- {MARCADOR}\n{ck}\n-->\n")


def carregar_pred(chave):
    rows = {}
    if PRED.exists():
        with PRED.open(encoding="utf-8") as f:
            for l in f:
                try:
                    a = json.loads(l)
                except (ValueError, json.JSONDecodeError):
                    continue
                if a.get("chave") == chave:
                    rows[a["page_id"]] = a
    return rows


def detectar(qs, H, R, do_zero, threads):
    """Prediz pixels da imagem original; converte e guarda sem arredondar."""
    from importlib.metadata import version
    versoes = {n: version(n) for n in ("ultralytics", "torch", "numpy", "scipy", "Pillow")}
    meta = {"peso_sha256": H[PESOS.relative_to(RAIZ).as_posix()], "imgsz": 1024,
            "device": "cpu", "conf": 0.25, "iou_nms": 0.7, "max_det": 300,
            "threads": threads, "versoes": versoes,
            "imagens": {k: v for k, v in H.items() if "/img/" in k},
            "golden_sha256": H["data/golden/golden_v4/tarefas.jsonl"]}
    chave = hashlib.sha256(json.dumps(meta, sort_keys=True).encode("utf-8")).hexdigest()
    if R.get("chave_pred") != chave:
        R["rows"] = []
    R["chave_pred"] = chave
    pred = {} if do_zero else carregar_pred(chave)
    pids = {q["p"]["page_id"] for q in qs}
    pred = {k: v for k, v in pred.items() if k in pids}
    # Reescrever limpa cauda truncada e duplicatas; somente esta saida e tocada.
    escrever(PRED, "".join(json.dumps(v, ensure_ascii=False, allow_nan=False) + "\n"
                          for k, v in sorted(pred.items())))
    modelo = None
    R["detector"] = meta
    for i, q in enumerate(qs):
        pid = q["p"]["page_id"]
        if pid in pred:
            q["ls3"] = pred[pid]["regioes"]
            continue
        if modelo is None:
            # Configuracao ja existente/valida; nao criar settings nem salvar imagens.
            os.environ["YOLO_CONFIG_DIR"] = str(RAIZ)
            os.environ["YOLO_OFFLINE"] = "true"
            os.environ["HF_HUB_OFFLINE"] = "1"
            os.environ["CUDA_VISIBLE_DEVICES"] = "-1"
            os.environ["OMP_NUM_THREADS"] = str(threads)
            os.environ["MKL_NUM_THREADS"] = str(threads)
            import torch
            torch.set_num_threads(threads)
            torch.set_num_interop_threads(1)
            from ultralytics import YOLO
            from ultralytics.utils import SETTINGS
            # dict.__setitem__ evita a persistencia automatica de JSONDict.
            dict.__setitem__(SETTINGS, "sync", False)
            modelo = YOLO(str(PESOS))
            modelo.to("cpu")
        p = q["p"]
        img = RAIZ / "data/golden/golden_v4/img" / p["imagem"]
        with Image.open(img) as im:
            wpx, hpx = im.size
        sx, sy = p["dimensions"]["width"] / wpx, p["dimensions"]["height"] / hpx
        t0 = time.perf_counter()
        res = modelo.predict(str(img), device="cpu", imgsz=1024, conf=0.25, iou=0.7,
        if fluxos is not None:
            fluxos[nome] = seq
        saida[nome] = avaliar(q, seq, [items[i]["id"] for i in ordem])
    return saida


def ouro_det(q, golden=False):
    classes = ("tabela", "figura") if golden else ("table", "figure", "chart", "heading")
    return [{"rotulo": "table" if r["classe"] in ("table", "tabela") else "picture",
             "score": 1., "bbox": r["bbox"]} for r in q["p"]["bounding_boxes"] if r["classe"] in classes]


def desenvolver_golden():
    """Executa antes de avaliar o LS; sem grade, escolha ou ajuste no dado novo."""
    rows = []
    for q in j.preparar():
        met = {}
        for fonte, det in (("docling", q["d"]["detector"]["regioes"]), ("ouro", ouro_det(q, True))):
            for exp in (False, True):
                seq, _, diag = prever(q, det, exp)
                met[fonte+("_exp" if exp else "")] = avaliar(q, seq)
                met[fonte+("_exp" if exp else "")]["diag"].update(diag)
                if not exp and fonte == "docling":
                    antiga, _, _ = o.prever(q, CFG)
                    if antiga != seq:
                        raise ValueError("Configuracao congelada difere do script original")
        rows.append({"page_id": q["p"]["page_id"], "veiculo": q["p"]["page_id"].split("/",1)[0],
                     "colunas": j.colunas(q)["n"], "metodos": met})
    gravar(BASE / "desenvolvimento_golden.json", rows)
    return rows


def tokens(s):
    s = unicodedata.normalize("NFKD", s).lower()
    return collections.Counter(re.findall(r"[a-z0-9]+", s))


def conferir_texto(p, ws):
    """Compara tokens espacialmente associados com transcricao, sem usar ordem humana."""
    kws, livres, amb = o.donos(ws, p["bounding_boxes"])
    inter, ref, pred, n, regioes = 0, 0, 0, 0, []
    for r, ks in zip(p["bounding_boxes"], kws):
        a = tokens(r.get("text") or "")
        b = tokens(" ".join(ws[k][0] for k in ks))
        if not a:
            continue
        hit = sum((a & b).values())
        nr, npred = sum(a.values()), sum(b.values())
        inter += hit; ref += nr; pred += npred; n += 1
        regioes.append({"id": r["id"], "tokens_transcricao": nr, "tokens_pdf": npred,
                        "comuns": hit, "recall": hit/nr})
    return {"regioes_transcritas": n, "tokens_transcricao": ref, "tokens_pdf_transcritos": pred,
            "tokens_comuns": inter, "recall": inter/ref if ref else None,
            "f1": 2*inter/(ref+pred) if ref+pred else None, "por_regiao": regioes}


def pdf_util(path):
    """Extrai PKCS#7 sob resultados; PDFs normais e com zeros finais ficam intactos."""
    with path.open("rb") as f:
        inicio = f.read(1024)
    off = inicio.find(b"%PDF")
    if off in (0, -1) and not path.parent.name.upper().endswith("-MG"):
        return path, False
    raw = path.read_bytes()
    ini, fim = raw.find(b"%PDF"), raw.rfind(b"%%EOF")
    if ini < 0 or fim < ini:
        raise ValueError("Envelope sem PDF completo")
    out = BASE / "pdf_temporarios" / (digest(path)+".pdf")
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_suffix(".pdf.tmp")
    with tmp.open("wb") as f:
        f.write(raw[ini:fim+5])
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp,out)
    return out, True


def extrair_grupo(registros):
    """Abre cada PDF uma vez por grupo; guarda cada pagina antes de seguir."""
    import pdfplumber
    out = []
    path = RAIZ / registros[0]["mapa"]["pdf_local"]
    try:
        util, envelope = pdf_util(path)
        with pdfplumber.open(util) as pdf:
            for rec in registros:
                p = rec["p"]
                arquivo = BASE / "palavras" / (hashlib.sha256(p["page_id"].encode()).hexdigest()+".json")
                idx = int(rec["mapa"]["pagina"])-1
                if int(p["pagina"]) != int(rec["mapa"]["pagina"]):
                    raise ValueError("Pagina do export difere do mapa")
                if not 0 <= idx < len(pdf.pages):
                    out.append({"page_id": p["page_id"], "erro": "indice_fora_do_pdf"})
                    continue
                pg = pdf.pages[idx]
                W, H = float(pg.width), float(pg.height)
                sx, sy = W/p["dimensions"]["width"], H/p["dimensions"]["height"]
                pt = dict(p, dimensions={"width": W, "height": H})
                pt["bounding_boxes"] = [dict(r, bbox=[r["bbox"][0]*sx,r["bbox"][1]*sy,
                      r["bbox"][2]*sx,r["bbox"][3]*sy]) for r in p["bounding_boxes"]]
                def palavras(page):
                    return [[w["t"],w["x0"],w["top"],w["x1"],w["bottom"]]
                            for w in palavras_da_pagina(page)]
                ws = palavras(pg)
                audit = conferir_texto(pt, ws)
                # Verifica as duas interpretacoes vizinhas, apenas como auditoria.
                alternativas = []
                for ix in (idx-1, idx+1):
                    if 0 <= ix < len(pdf.pages) and audit["regioes_transcritas"]:
                        outra = pdf.pages[ix]
                        ow = palavras(outra)
                        alt = conferir_texto(pt, ow)
                        alternativas.append({"indice_zero": ix, "f1": alt["f1"]})
                        outra.close()
                audit["alternativas"] = alternativas
                audit["vizinha_melhor"] = any(x["f1"] is not None and audit["f1"] is not None
                                             and x["f1"] > audit["f1"]+.05 for x in alternativas)
                row = {"page_id": p["page_id"], "chave": rec["chave"], "p": pt, "ws": ws,
                       "pdf": rec["mapa"]["pdf_local"], "pagina_um": idx+1, "indice_zero": idx,
                       "numero_paginas_pdf": len(pdf.pages), "pkcs7": envelope,
                       "escala_px_pt": [sx, sy], "texto": audit}
                gravar(arquivo, row)
                pg.close()
                out.append(row)
    except Exception as e:
        out.append({"pdf": str(path.relative_to(RAIZ)), "erro": f"{type(e).__name__}: {e}"})
    return out


