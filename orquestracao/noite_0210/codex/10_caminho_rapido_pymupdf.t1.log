+def nms(rs):
+    """Suprime duplicatas da mesma classe; nunca funde tabelas adjacentes."""
+    out = []
+    for r in rs:
+        if not valido(r.get("bbox", [])):
+            continue
+        if any(r["rotulo"] == m["rotulo"] and
+               (iou(r["bbox"], m["bbox"]) >= .5 or
+                o.inter(r["bbox"], m["bbox"]) >= .9 * min(o.area(r["bbox"]), o.area(m["bbox"])))
+               for m in out):
+            continue
+        out.append(r)
+    return out
