+         "rapido_text": "Plano LOPO + PyMuPDF incluindo text", "nenhum": "Plano LOPO sem átomos"}
+DET_NOMES = {"lines": "find_tables(lines)", "text": "find_tables(text)",
+             "tracos": "Agrupamento de traços/retângulos", "raster": "Imagens incorporadas",
