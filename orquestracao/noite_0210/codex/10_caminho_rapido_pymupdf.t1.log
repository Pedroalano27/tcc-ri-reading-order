+    return [[str(w[4]), *bbox(w[:4], mat)] for w in raw if str(w[4]).strip() and valido(w[:4])]
+
+
+def regiao(rotulo, b, fonte, **extras):
+    return dict(rotulo=rotulo, bbox=[float(x) for x in b], score=1.0, fonte=fonte, **extras)
+
