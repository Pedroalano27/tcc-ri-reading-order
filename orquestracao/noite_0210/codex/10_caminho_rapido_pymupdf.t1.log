+def valido(b):
+    return len(b) == 4 and all(math.isfinite(float(v)) for v in b) and o.area(b) > 0
+
+
+def iou(a, b):
+    inter = o.inter(a, b)
+    return inter / max(1e-12, o.area(a) + o.area(b) - inter)
