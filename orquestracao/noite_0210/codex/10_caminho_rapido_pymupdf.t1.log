def gravar(path, objeto):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporario = path.with_name(path.name + ".tmp")
    with temporario.open("w", encoding="utf-8", newline="\n") as f:
        f.write(objeto if isinstance(objeto, str) else json.dumps(objeto, ensure_ascii=False,
                                                               indent=2, allow_nan=False))
        f.flush()
        os.fsync(f.fileno())
    os.replace(temporario, path)


def carregar_json(path):
    """Cache incompleto apos queda nao impede retomar dos outros arquivos."""
    try:
        with path.open(encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def digest(path):
    return j.digest(path)


def lista_json(path):
    """Decodifica uma tarefa por vez, sem read_text nem leitura integral do export."""
    dec = json.JSONDecoder()
    with path.open(encoding="utf-8") as f:
        buf, iniciou, acabou = "", False, False
        while not acabou:
            bloco = f.read(65536)
            buf += bloco
            while True:
                buf = buf.lstrip()
                if not iniciou:
                    if not buf:
                        break
                    if buf[0] != "[":
                        raise ValueError("Export precisa ser lista de tarefas")
                    iniciou, buf = True, buf[1:]
                    continue
                buf = buf.lstrip(" \r\n\t,")
                if buf.startswith("]"):
                    acabou = True
                    break
                if not buf:
                    break
                try:
                    tarefa, fim = dec.raw_decode(buf)
                except json.JSONDecodeError:
                    if not bloco:
                        raise ValueError("Export incompleto")
                    break
                yield tarefa
                buf = buf[fim:]
            if not bloco and not acabou:
                raise ValueError("Export sem fechamento")


def converter():
    """Usa o conversor existente, trocando apenas o carregador integral em memoria."""
    pares, origens = [], {}
    cont = collections.Counter()
    for t in lista_json(EXPORT):
        cont["tarefas_export"] += 1
        for pred in t.get("predictions") or []:
            if isinstance(pred, dict):
                origens[("pred", pred.get("id"))] = pred.get("result") or []
        for a in t.get("annotations") or []:
            if not isinstance(a, dict):
                continue
            origens[("ann", a.get("id"))] = a.get("result") or []
            if a.get("was_cancelled"):
                cont["canceladas"] += 1
            elif ls._anotador(a) == "desconhecido":
                cont["automaticas_ignoradas"] += 1
            else:
                pares.append((t, a))
    processadas = ls.processar(pares, origens, excluir=["desconhecido"])
    validas = [p for p in processadas if not any(x[0] == ls.ERRO for x in p["problemas"])]
    cont.update(humanas=len(processadas), humanas_invalidas=len(processadas)-len(validas),
                humanas_validas=len(validas))
    # Escolhe antes da conversao: caixas e ordem pertencem a mesma revisao humana.
    escolhidas = {}
    for p in validas:
        pid = p["page_id"]
        if pid not in escolhidas or (p["atualizada_em"] or "", p["anotacao_id"] or 0) > (
                escolhidas[pid]["atualizada_em"] or "", escolhidas[pid]["anotacao_id"] or 0):
            escolhidas[pid] = p
    ids = {p["anotacao_id"] for p in escolhidas.values()}
    selecionados = [(t, a) for t, a in pares if a.get("id") in ids]
    antigo = ls.carregar
    try:
        # A marca antecede a primeira anotacao derivada: queda durante conversao
        # nao faz o conversor confundi-la com uma anotacao humana protegida.
        destino = BASE / "convertido"
        if not (destino / "anotacoes.jsonl").exists():
            gravar(destino / ls.MARCA_SAIDA, {"export": str(EXPORT),
                   "criador": Path(__file__).name, "em_conversao": True})
        ls.carregar = lambda caminho: (selecionados, origens)
        ls.cmd_converter(SimpleNamespace(export=EXPORT, saida=destino,
                                         anotador=None, excluir=["desconhecido"]))
    finally:
        ls.carregar = antigo
    return dict(cont)


def particao(items, ws, H):
    return j.particao(items, ws, H, "geo")


def ordenar_exploratorio(items, ids, q, diag, depth=0):
    """Unica mudanca: no fallback, atomos votam com suas linhas, sem serem partidos."""
    if not ids:
        return []
    if depth > 60:
        return sorted(ids, key=lambda i: (items[i]["bbox"][1], items[i]["bbox"][0], i))
    h = q["h"]
    cortes = o.vales_locais(items, ids, h, CFG.vale) or o.vales(items, ids, h, CFG.vale)
    if not cortes and any(items[i]["tipo"] in ("table", "picture") for i in ids):
        sondas = []
        for i in ids:
            m = items[i]
            if m["tipo"] in ("table", "picture") and m["ks"]:
                sondas.extend({"bbox": L["bbox"]} for L in o.linhas(q["ws"], m["ks"]))
            else:
                sondas.append({"bbox": m["bbox"]})
        ii = list(range(len(sondas)))
        cortes = o.vales_locais(sondas, ii, h, CFG.vale) or o.vales(sondas, ii, h, CFG.vale)
        if cortes:
            diag["votos_internos"] += 1
    if not cortes:
        return o.xycut(ids, o.boxes(items))
    diag["max_colunas"] = max(diag["max_colunas"], len(cortes)+1)
    W = max(items[i]["bbox"][2] for i in ids)-min(items[i]["bbox"][0] for i in ids)
    largos = [i for i in ids if any(items[i]["bbox"][0] < c < items[i]["bbox"][2]
               and min(c-items[i]["bbox"][0], items[i]["bbox"][2]-c) >= .10*W for c in cortes)]
    if largos:
        largos.sort(key=lambda i: (items[i]["bbox"][1], items[i]["bbox"][0], i))
        diag["pontes"] += len(largos)
        ys = [(items[i]["bbox"][1]+items[i]["bbox"][3])/2 for i in largos]
        secs = [[] for _ in range(len(largos)+1)]
        for i in ids:
            if i not in largos:
                cy = (items[i]["bbox"][1]+items[i]["bbox"][3])/2
                secs[sum(y < cy for y in ys)].append(i)
        saida = []
        for z, sec in enumerate(secs):
            saida.extend(ordenar_exploratorio(items, sec, q, diag, depth+1))
            if z < len(largos):
                saida.append(largos[z])
        return saida
    gs = [[] for _ in range(len(cortes)+1)]
    for i in ids:
        cx = (items[i]["bbox"][0]+items[i]["bbox"][2])/2
        gs[sum(c < cx for c in cortes)].append(i)
    return [i for g in gs for i in ordenar_exploratorio(items, g, q, diag, depth+1)]


def prever(q, det, exploratorio=False):
    ats, livres = o.atomos(q["ws"], det, CFG.score)
    items = ats + o.linhas_partidas(q["ws"], livres, CFG.gap, q["h"])
    diag = {"max_colunas": 1, "pontes": 0, "votos_internos": 0,
            "n_atomos": len(ats), "atomos_sem_palavras": sum(not x["ks"] for x in ats)}
    ini, corpo, marcas, fim = particao(items, q["ws"], q["p"]["dimensions"]["height"])
    if exploratorio:
        ordem = ordenar_exploratorio(items, corpo, q, diag)
    else:
        ordem = o.ordenar_projecao(items, corpo, q["h"], CFG.vale, diag, local=True)
    chave = lambda i: (items[i]["bbox"][1], items[i]["bbox"][0], i)
    ordem = sorted(ini, key=chave)+ordem+sorted(marcas, key=chave)+sorted(fim, key=chave)
    if sorted(ordem) != list(range(len(items))):
        raise ValueError("Ordenador perdeu itens")
    items = [items[i] for i in ordem]
    seq = o.fluxo(items, q["ws"])
    if sorted(seq) != list(range(len(q["ws"]))):
        raise ValueError("Ordenador perdeu ou duplicou palavras")
    return seq, items, diag


def referencia(p, a, ws):
    # Conversor emite caixas na ordem humana; entrada geometrica canonica evita
    # usar essa ordem como desempate das heuristicas.
    p = dict(p, bounding_boxes=sorted(p["bounding_boxes"], key=lambda r: (
        r["bbox"][1], r["bbox"][0], str(r["id"]))))
    kws, livres, amb = o.donos(ws, p["bounding_boxes"])
    reg_words, gold_lines, gt_l = {}, [], []
    por_l = {}
    for r, ks in zip(p["bounding_boxes"], kws):
        reg_words[r["id"]], por_l[r["id"]] = ks, []
        for z, L in enumerate(o.linhas(ws, ks)):
            lid = f"{r['id']}:l{z}"
            gold_lines.append({"id": lid, "regiao": r["id"], "ks": L["ks"], "bbox": L["bbox"]})
            por_l[r["id"]].append(lid)
    for rid in a["ordem"]:
        gt_l.extend(por_l.get(rid, []))
    por_id = {L["id"]: L for L in gold_lines}
    return {"p": p, "ws": ws, "h": statistics.median(w[4]-w[2] for w in ws) if ws else 10.,
            "gt_r": a["ordem"], "gt_l": gt_l, "gold_lines": gold_lines, "reg_words": reg_words,
            "gt_w": [k for lid in gt_l for k in por_id[lid]["ks"]],
            "auditoria": {"palavras": len(ws), "fora_ouro": len(livres), "ambiguas": amb,
                          "regioes_vazias": sum(not ks for ks in kws), "pagina_vazia": int(not ws)}}


def avaliar(q, seq, ordem=None):
"""
Script de analise comparativa: PyMuPDF vs pdfplumber na extracao de palavras.

Avalia a viabilidade de substituir o pdfplumber pelo PyMuPDF (requisito de
velocidade do orientador) na etapa de extracao de palavras do extrator
(src/data/extrator.py).

Gera:
  - resultados/pymupdf_palavras_cache.json  (cache retomavel pagina a pagina)
  - resultados/pymupdf_palavras.md          (relatorio final com numeros, tabelas e analise)

Uso:
  venv\\Scripts\\python.exe orquestracao/analises/pymupdf_palavras.py
"""
from __future__ import annotations

import os
import sys
import json
import time
import math
import random
import unicodedata
import statistics
from collections import defaultdict, Counter
from typing import Dict, List, Tuple, Any, Optional

import numpy as np
import pdfplumber
import pymupdf

# Raiz do projeto
RAIZ = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, RAIZ)

from src.data.extrator import palavras_da_pagina, _juntar_letras_espacadas

DIR_BLOCOS = os.path.join(RAIZ, "data", "processed", "blocos")
DIR_RAW = os.path.join(RAIZ, "data", "raw")
DIR_RESULTADOS = os.path.join(RAIZ, "resultados")
ARQ_CACHE = os.path.join(DIR_RESULTADOS, "pymupdf_palavras_cache.json")
ARQ_RELATORIO = os.path.join(DIR_RESULTADOS, "pymupdf_palavras.md")

SEMENTE = 20261003
N_AMOSTRA = 60
VEICULO_PE = "official_diary_pe"
MIN_PAGINAS_PE = 5
MAX_POR_VEICULO = 3


def fmt(n: float, dec: int = 2) -> str:
    """Formata numero float com virgula decimal para o relatorio em portugues."""
    if math.isnan(n):
        return "-"
    return f"{n:.{dec}f}".replace(".", ",")


def p95(valores: List[float]) -> float:
    """Calcula o percentil 95 de uma lista de valores."""
    if not valores:
        return 0.0
    return float(np.percentile(valores, 95))


def mediana(valores: List[float]) -> float:
    """Calcula a mediana de uma lista de valores."""
    if not valores:
        return 0.0
    return float(statistics.median(valores))


def media(valores: List[float]) -> float:
    """Calcula a media de uma lista de valores."""
    if not valores:
        return 0.0
    return float(statistics.mean(valores))


def carregar_catalogo_paginas(dir_blocos: str) -> Dict[str, List[Dict[str, Any]]]:
    """Le as paginas disponiveis em data/processed/blocos agrupadas por veiculo."""
    por_uf: Dict[str, List[Dict[str, Any]]] = {}
    for nome in sorted(os.listdir(dir_blocos)):
        if not nome.endswith(".jsonl") or nome.startswith("_"):
            continue
        caminho = os.path.join(dir_blocos, nome)
        uf = nome[:-6]
        paginas_uf = []
        with open(caminho, "r", encoding="utf-8") as f:
            for linha in f:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    reg = json.loads(linha)
                    paginas_uf.append({
                        "page_id": reg["page_id"],
                        "uf": reg.get("uf", uf),
                        "arquivo": reg["arquivo"],
                        "pagina": reg["pagina"]
                    })
                except Exception:
                    continue
        if paginas_uf:
            paginas_uf.sort(key=lambda x: x["page_id"])
            por_uf[uf] = paginas_uf
    return por_uf


def sortear_amostra(por_uf: Dict[str, List[Dict[str, Any]]],
                    n_total: int = N_AMOSTRA,
                    semente: int = SEMENTE) -> List[Dict[str, Any]]:
    """Sorteia com semente fixa 60 paginas espalhadas por veiculo.
    
    Regras:
      - Pelo menos 5 de Pernambuco (official_diary_pe), se existir;
      - No maximo 3 por veiculo para os demais;
      - Balanceamento uniforme entre os veiculos disponiveis.
    """
    rng = random.Random(semente)
    amostra: List[Dict[str, Any]] = []

    # 1. Pernambuco
    ufs_disponiveis = sorted(por_uf.keys())
    pool_pe = por_uf.get(VEICULO_PE, [])
    n_pe = min(MIN_PAGINAS_PE, len(pool_pe))
    if n_pe > 0:
        escolhidas_pe = rng.sample(pool_pe, n_pe)
        amostra.extend(escolhidas_pe)

    # 2. Outros veiculos
    outros_ufs = [u for u in ufs_disponiveis if u != VEICULO_PE]
    pools = {u: list(por_uf[u]) for u in outros_ufs}
    for u in pools:
        rng.shuffle(pools[u])

    alocadas = {u: 0 for u in outros_ufs}
    if VEICULO_PE in por_uf:
        alocadas[VEICULO_PE] = n_pe

    ordem_ufs = list(outros_ufs)

    # Rodadas sucessivas de alocacao (1 por veiculo por rodada)
    for rodada in range(MAX_POR_VEICULO):
        rng.shuffle(ordem_ufs)
        for u in ordem_ufs:
            if len(amostra) >= n_total:
                break
            if pools[u] and alocadas[u] < MAX_POR_VEICULO:
                amostra.append(pools[u].pop())
                alocadas[u] += 1

    amostra.sort(key=lambda x: x["page_id"])
    return amostra


def resolver_envelope_pkcs7(caminho: str) -> Tuple[str, bool]:
    """Se o arquivo for um envelope PKCS#7 (comum em MG), extrai %PDF...%%EOF."""
    try:
        with open(caminho, "rb") as f:
            inicio = f.read(1024)
            if not inicio.startswith(b"%PDF"):
                f.seek(0)
                dados = f.read()
                idx_ini = dados.find(b"%PDF")
                if idx_ini != -1:
                    idx_fim = dados.rfind(b"%%EOF")
                    if idx_fim != -1:
                        tmp_path = os.path.join(DIR_RESULTADOS, f"_tmp_pkcs7_{os.path.basename(caminho)}")
                        with open(tmp_path, "wb") as f_out:
                            f_out.write(dados[idx_ini:idx_fim + 6])
                        return tmp_path, True
    except Exception:
        pass
    return caminho, False


def extrair_palavras_pymupdf(page: Any) -> List[Dict[str, Any]]:
    """Extrai palavras do PyMuPDF convertendo para o formato do extrator:
    
    Retorna lista de dicts: {"t", "x0", "x1", "top", "bottom", "s"}.
    Trata CropBox, origem e orientacao de forma defensiva.
    """
    W = float(page.rect.width)
    H = float(page.rect.height)

    # Coordenadas do rect (no PyMuPDF x0, y0 normalmente sao 0,0)
    rx0, ry0 = float(page.rect.x0), float(page.rect.y0)
    cb_x0, cb_y0 = float(page.cropbox.x0), float(page.cropbox.y0)

    raw_words = page.get_text("words")
    if not raw_words:
        return []

    # Detecta se get_text("words") veio no sistema de mediabox com offset de cropbox
    precisa_offset_cropbox = False
    if cb_x0 != 0.0 or cb_y0 != 0.0:
        amostra = raw_words[:min(20, len(raw_words))]
        if all(w[0] >= cb_x0 - 5.0 for w in amostra) and any(w[2] > W + 5.0 for w in amostra):
            precisa_offset_cropbox = True

    saida = []
    for i, w in enumerate(raw_words):
        # Formato tupla: (x0, y0, x1, y1, word, block_no, line_no, word_no)
        x0, y0, x1, y1, text = float(w[0]), float(w[1]), float(w[2]), float(w[3]), str(w[4])

        if rx0 != 0.0 or ry0 != 0.0:
            x0 -= rx0
            x1 -= rx0
            y0 -= ry0
            y1 -= ry0
        elif precisa_offset_cropbox:
            x0 -= cb_x0
            x1 -= cb_x0
            y0 -= cb_y0
            y1 -= cb_y0

        t = text.strip()
        if not t:
            continue

# -*- coding: utf-8 -*-
"""
Taxonomia de layout do PROJETO (guia de anotacao "Diarios Oficiais") e os mapeamentos entre ela,
as 9 classes do extrator atual e os rotulos crus do detector Docling.

Decisao (19/09/2026, quadro): o extrator passa a falar a taxonomia do guia, para (a) treinar no
dataset rotulado a mao do projeto (LabelStudio) e (b) ser comparavel ao projeto de pesquisa.
Ver COMUNICACAO_AGENTES.md e docs/GUIA_DIAMOND.md.

Este modulo NAO detecta nada; so define o vocabulario e as traducoes. As distincoes SEMANTICAS que
o extrator ainda nao faz (marcadas com # PRECISA LOGICA) exigem regras/ modelo:
  - act vs title      : "e ato normativo?" (DECRETO/PORTARIA/RESOLVE... vs titulo comum)
  - act section       : subtitulo/divisao interna de ato (Art., Paragrafo, CAPITULO)
  - id                : identificadores/protocolos/nº processo/campos chave-valor
  - caption           : legenda de tabela/figura/grafico
  - chart             : grafico de dados (vs figura)
  - signature vs heading : bloco de assinatura textual/digital vs rubrica MANUSCRITA
"""
from __future__ import annotations

# --- Taxonomia do guia (tabela da secao 11: label -> (atalho, funcao)) ---
# Ordem = ordem de decisao do guia (secao 10): normativo primeiro, depois recorrente, visual, id.
LABELS_GUIA = {
    "act":              ("t", "Titulo de ato normativo"),
    "act section":      ("a", "Subtitulo ou divisao interna de ato"),
    "paragraph":        ("5", "Texto corrente"),
    "signature":        ("q", "Bloco textual ou digital de assinatura"),
    "heading":          ("w", "Assinatura manuscrita ou rubrica"),
    "id":               ("0", "Identificadores, protocolos e codigos"),
