+    rng=np.random.default_rng(SEMENTE); ix=rng.integers(0,len(vs),size=(NBOOT,len(vs)))
+    boots=sums[ix].sum(axis=1)/ns[ix].sum(axis=1)
+    return dict(delta=float(np.mean(d)),ic=np.percentile(boots,[2.5,97.5]).tolist(),p=p,
