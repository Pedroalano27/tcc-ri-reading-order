+def tabela_tempo(rows):
+    out=["| Pipeline CPU | n | Média s/pág. | Mediana | p95 | pág./s |",
+         "|---|---:|---:|---:|---:|---:|"]
+    for k,label in (("docling","pdfplumber + renderização + Docling + ordem"),
+                    ("rapido","PyMuPDF conservador + ordem"),("rapido_text","PyMuPDF com text + ordem")):
