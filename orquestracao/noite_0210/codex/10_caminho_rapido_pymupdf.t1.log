+def tabela_ordem(rows, regua):
+    out=["| Método | τ ↑ (IC 95% por veículo) | Sucessor ↑ (IC 95%) | ARD norm. ↓ (IC 95%) | Regiões fragmentadas |",
+         "|---|---:|---:|---:|---:|"]
+    for nome in NOMES:
