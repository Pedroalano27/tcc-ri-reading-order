+    if len(qs) != 71 or len({q["p"]["page_id"] for q in qs}) != len(qs):
+        raise ValueError("Amostra nao corresponde a v4 + v3 fora de todas as tarefas v4")
+    return sorted(qs, key=lambda q: (q["coorte"], q["p"]["page_id"]))
