+def assinatura_numeros(R):
+    campos = {k: R[k] for k in ("resumos", "previa")}
+    campos["paginas"] = [{k: r[k] for k in r if k not in ("origem_ls3",)} for r in R["paginas"]]
+    return ac.digest(campos)
