+        lines += ["", "Origens reproduzidas (partida/fundida/interno/residual): " + "; ".join(m + " = " + "/".join(str(a["origens"][m].get(k,0)) for k in ORIGENS_P1[:4]) for m in ("P1","P1m")) + ".",
