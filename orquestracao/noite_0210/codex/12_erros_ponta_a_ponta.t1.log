+def automatico(q):
+    """Contrato de entrada: apenas palavras, blocos/detector automaticos e dimensoes."""
+    return {"ws": q["ws"], "h": q["h"], "d": {
+        "blocos_v3": q["d"]["blocos_v3"], "detector": q["d"]["detector"]},
+        "p": {k: q["p"][k] for k in ("page_id", "dimensions")}, "ls3": q["ls3"]}
+
