              and a.get("salvo_em") == p.get("diamond", {}).get("salvo_em")]
        if len(aa) != 1:
            raise ValueError(f"Revisão Diamond congelada ausente/ambígua: {p['page_id']}")
        q["diamond_ouro"] = aa[0].get("regioes", [])
        for r in q["diamond_ouro"]:
            if len(r.get("bbox", [])) != 4 or o.area(r["bbox"]) <= 0:
                raise ValueError(f"Caixa Diamond inválida: {p['page_id']} {r}")
        q["veiculo"] = p["page_id"].split("/", 1)[0]
        q["colunas"] = j.colunas(q)
    return qs


def carregar_md():
    if not MD.exists():
        return None
    t = MD.read_text(encoding="utf-8")
    m = re.search(r"<!-- " + MARCADOR + r"\n([A-Za-z0-9+/=]+)\n-->", t)
    if not m:
        return None
    try:
        return json.loads(zlib.decompress(base64.b64decode(m.group(1))))
    except (ValueError, zlib.error):
        return None


def salvar_md(R, texto):
    raw = json.dumps(R, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
    ck = base64.b64encode(zlib.compress(raw, 9)).decode("ascii")
    escrever(MD, texto + f"\n<!-- {MARCADOR}\n{ck}\n-->\n")


def carregar_pred(chave):
    rows = {}
    if PRED.exists():
        with PRED.open(encoding="utf-8") as f:
            for l in f:
                try:
                    a = json.loads(l)
                except (ValueError, json.JSONDecodeError):
                    continue
                if a.get("chave") == chave:
                    rows[a["page_id"]] = a
    return rows


def detectar(qs, H, R, do_zero, threads):
    """Prediz pixels da imagem original; converte e guarda sem arredondar."""
    from importlib.metadata import version
    versoes = {n: version(n) for n in ("ultralytics", "torch", "numpy", "scipy", "Pillow")}
    meta = {"peso_sha256": H[PESOS.relative_to(RAIZ).as_posix()], "imgsz": 1024,
            "device": "cpu", "conf": 0.25, "iou_nms": 0.7, "max_det": 300,
            "threads": threads, "versoes": versoes,
            "imagens": {k: v for k, v in H.items() if "/img/" in k},
            "golden_sha256": H["data/golden/golden_v4/tarefas.jsonl"]}
    chave = hashlib.sha256(json.dumps(meta, sort_keys=True).encode("utf-8")).hexdigest()
    if R.get("chave_pred") != chave:
        R["rows"] = []
    R["chave_pred"] = chave
    pred = {} if do_zero else carregar_pred(chave)
    pids = {q["p"]["page_id"] for q in qs}
    pred = {k: v for k, v in pred.items() if k in pids}
    # Reescrever limpa cauda truncada e duplicatas; somente esta saida e tocada.
    escrever(PRED, "".join(json.dumps(v, ensure_ascii=False, allow_nan=False) + "\n"
                          for k, v in sorted(pred.items())))
    modelo = None
    R["detector"] = meta
    for i, q in enumerate(qs):
        pid = q["p"]["page_id"]
        if pid in pred:
            q["ls3"] = pred[pid]["regioes"]
            continue
        if modelo is None:
            # Configuracao ja existente/valida; nao criar settings nem salvar imagens.
            os.environ["YOLO_CONFIG_DIR"] = str(RAIZ)
            os.environ["YOLO_OFFLINE"] = "true"
            os.environ["HF_HUB_OFFLINE"] = "1"
            os.environ["CUDA_VISIBLE_DEVICES"] = "-1"
            os.environ["OMP_NUM_THREADS"] = str(threads)
            os.environ["MKL_NUM_THREADS"] = str(threads)
            import torch
            torch.set_num_threads(threads)
            torch.set_num_interop_threads(1)
            from ultralytics import YOLO
            from ultralytics.utils import SETTINGS
            # dict.__setitem__ evita a persistencia automatica de JSONDict.
            dict.__setitem__(SETTINGS, "sync", False)
            modelo = YOLO(str(PESOS))
            modelo.to("cpu")
        p = q["p"]
        img = RAIZ / "data/golden/golden_v4/img" / p["imagem"]
        with Image.open(img) as im:
            wpx, hpx = im.size
        sx, sy = p["dimensions"]["width"] / wpx, p["dimensions"]["height"] / hpx
        t0 = time.perf_counter()
        res = modelo.predict(str(img), device="cpu", imgsz=1024, conf=0.25, iou=0.7,
                             max_det=300, verbose=False, save=False, save_txt=False)[0]
        if tuple(res.orig_shape) != (hpx, wpx):
            raise ValueError(f"Geometria inesperada da imagem: {pid}")
        rr = []
        for b in res.boxes:
            cls = str(res.names[int(b.cls.item())])
            if cls not in ("texto", "tabela", "imagem"):
                raise ValueError(f"Peso não é ls3: {cls}")
            px = [float(v) for v in b.xyxy[0].tolist()]
            rr.append({"id": f"d{len(rr)}", "classe": cls, "score": float(b.conf.item()),
                       "bbox_px": px, "bbox": [px[0]*sx, px[1]*sy, px[2]*sx, px[3]*sy]})
        rec = {"page_id": pid, "chave": chave, "modelo": meta, "imagem": img.relative_to(RAIZ).as_posix(),
               "dimensions": p["dimensions"], "imagem_px": [wpx, hpx], "escala_px_pt": [sx, sy],
               "tempo_ms": (time.perf_counter()-t0)*1000, "regioes": rr}
        with PRED.open("a", encoding="utf-8", newline="\n") as f:
            f.write(json.dumps(rec, ensure_ascii=False, allow_nan=False) + "\n")
            f.flush()
            os.fsync(f.fileno())
        pred[pid] = rec
        q["ls3"] = rr
        print(f"[CPU detector {i+1}/{len(qs)}] {len(rr)} caixas, {rec['tempo_ms']:.0f} ms: {pid}", flush=True)
        R["n_pred"] = len(pred)
        salvar_md(R, parcial(R))
    R["n_pred"] = len(pred)
    R["tempos_detector_ms"] = [pred[q["p"]["page_id"]]["tempo_ms"] for q in qs]
    if len(pred) != len(qs):
        raise ValueError("Cache de predições incompleto")
    return pred


def dets(q, fonte):
    if fonte == "docling":
        return q["d"].get("detector", {}).get("regioes", [])
    if fonte in ("ls3", "texto_ls3"):
        return [{"rotulo": "table" if r["classe"] == "tabela" else "picture",
                 "score": r["score"], "bbox": r["bbox"]}
                for r in q["ls3"] if r["classe"] in ("tabela", "imagem")]
    if fonte == "ouro":
        # Inclui tambem caixas sem palavras da revisao humana completa.
        return [{"rotulo": "table" if r["classe"] == "tabela" else "picture", "score": 1.0,
                 "bbox": r["bbox"]} for r in q["diamond_ouro"] if r["classe"] in ("tabela", "figura")]
    return []


def prever(q, c, fonte):
    ws, h = q["ws"], q["h"]
    ats, livres = o.atomos(ws, dets(q, fonte), c.score)
    textos = []
    fallback = len(livres)
    if fonte == "texto_ls3":
        textos = [{"tipo": "texto_ls3", "bbox": r["bbox"], "ks": [], "score": r["score"]}
                  for r in q["ls3"] if r["classe"] == "texto" and r["score"] >= c.score]
        restos = []
        for k in livres:
            cand = [m for m in textos if o.contem(m["bbox"], o.centro(ws[k]))]
            if cand:
                min(cand, key=lambda m: (o.area(m["bbox"]), -m["score"], m["bbox"]))["ks"].append(k)
            else:
                restos.append(k)
        livres = restos
        fallback = len(livres)
    items = ats + textos + o.linhas_partidas(ws, livres, c.gap, h)
    diag = {"max_colunas": 1, "pontes": 0, "n_atomos": len(ats),
            "atomos_sem_palavras": sum(not a["ks"] for a in ats), "caixas_texto": len(textos),
            "texto_sem_palavras": sum(not a["ks"] for a in textos), "fallback_palavras": fallback,
            "palavras_em_texto_ls3": sum(len(a["ks"]) for a in textos)}
    politica = "geo" if c.abordagem.endswith("margens") else None
    ini, corpo, marcas, fim = j.particao(items, ws, q["p"]["dimensions"]["height"], politica)
    diag.update(margem_topo=len(ini), margem_fim=len(fim), marcas=len(marcas))
    if c.abordagem.startswith("projecao"):
        ordem = o.ordenar_projecao(items, corpo, h, c.vale, diag, local="local" in c.abordagem)
    else:
        ordem = o.xycut(corpo, o.boxes(items))
    chave = lambda i: (items[i]["bbox"][1], items[i]["bbox"][0], i)
    ordem = sorted(ini, key=chave) + ordem + sorted(marcas, key=chave) + sorted(fim, key=chave)
    if sorted(ordem) != list(range(len(items))):
        raise ValueError("Ordenador perdeu ou repetiu itens")
    items = [items[i] for i in ordem]
    seq = o.fluxo(items, ws)
    if len(seq) != len(ws) or set(seq) != set(range(len(ws))):
        raise ValueError("Saída perdeu ou repetiu palavras")
    return seq, items, diag


def avaliar(q, seq, diag=None, ordem=None):
    a = j.avaliar(q, seq, ordem)
    if diag:
        a["diag"].update(diag)
    return a


def bases(q):
    ws = q["ws"]
    items = [{"id": r["id"], "tipo": r["classe"], "bbox": r["bbox"], "ks": q["reg_words"][r["id"]]}
             for r in q["p"]["bounding_boxes"]]
    out = {}
    for nome, pol in (("xy_ouro", None), ("xy_ouro_margens", "geo")):
        ini, corpo, marcas, fim = j.particao(items, ws, q["p"]["dimensions"]["height"], pol)
        chave = lambda i: (items[i]["bbox"][1], items[i]["bbox"][0], i)
        ids = sorted(ini, key=chave) + o.xycut(corpo, o.boxes(items)) + sorted(marcas, key=chave) + sorted(fim, key=chave)
        seq = o.fluxo([items[i] for i in ids], ws)
        seq += [k for k in range(len(ws)) if k not in set(q["gt_w"])]
        out[nome] = avaliar(q, seq, {"margem_topo": len(ini), "margem_fim": len(fim), "marcas": len(marcas)},
                            [items[i]["id"] for i in ids])
    return out


def iou(a, b):
"""Aplica uma politica explicita de margens a ordens de leitura de blocos.

Cabecalhos primeiro, marcas de diagramacao antes do rodape e rodapes por ultimo
evitam que campos laterais interrompam colunas. Os padroes reproduzem a regra
de ordem_sem_bbox_justo.py: centro < 7% e base < 10% no topo, centro > 95% no
rodape. A variante por classe substitui os dois testes por cabecalho/rodape;
nao usa geometria como fallback quando a classe falta.

Uso: aplicar_margens(p['bounding_boxes'], ids, p['dimensions']) devolve uma
lista nova, preservando exatamente a ordem relativa do corpo. xycut_margens(p)
separa as margens ANTES de calcular XY-cut no corpo, como na reanalise. Estas
operacoes nao sao equivalentes: remover caixas pode mudar os cortes do corpo.
As duas funcoes recebem apenas texto, caixas e, opcionalmente, classes; nunca
consultam p['ordens'], anotacoes ou modelos. Nao ha I/O nem alteracao da entrada.

IDs devem formar uma permutacao completa, sem repeticao. Entrada invalida gera
ValueError: reparar silenciosamente poderia esconder troca de segmentacao.
Caixas e dimensoes usam a mesma unidade e coordenadas [x0, top, x1, bottom].
"""
from __future__ import annotations

import math
import re
from collections.abc import Mapping, Sequence
from typing import Hashable

PADRAO_MARCACAO = r"^(?:<@[^>]+>|<#[^>]+>|contPageBreak.*)$"


def _separar(blocos, ordem, dimensoes, *, variante, limiar_topo,
             limite_base_topo, limiar_rodape, padrao_marcacao, campo_classe,
             classe_cabecalho, classe_rodape):
    """Valida e particiona, usando indice do bloco como desempate estavel."""
    if variante not in ("geometria", "classe"):
        raise ValueError("variante deve ser 'geometria' ou 'classe'")
    if not (0 <= limiar_topo <= limite_base_topo <= limiar_rodape <= 1):
        raise ValueError("limiares devem satisfazer 0 <= topo <= base <= rodape <= 1")
    try:
        largura, altura = float(dimensoes["width"]), float(dimensoes["height"])
        if not all(math.isfinite(v) and v > 0 for v in (largura, altura)):
            raise ValueError
        ids = [b["id"] for b in blocos]
        if len(set(ids)) != len(ids):
            raise ValueError
        if len(ordem) != len(ids) or len(set(ordem)) != len(ordem) or set(ordem) != set(ids):
            raise ValueError
    except (KeyError, TypeError, ValueError) as exc:
        raise ValueError("dimensoes invalidas, IDs repetidos ou ordem nao e permutacao completa") from exc
    regex = re.compile(padrao_marcacao) if padrao_marcacao is not None else None
    grupos = {k: [] for k in ("topo", "corpo", "marcas", "rodape")}
    chaves = {}
    for i, b in enumerate(blocos):
        try:
            x0, y0, x1, y1 = map(float, b["bbox"])
            if not all(math.isfinite(v) for v in (x0, y0, x1, y1)) or x1 < x0 or y1 < y0:
                raise ValueError
        except (KeyError, TypeError, ValueError) as exc:
            raise ValueError(f"bbox invalida no bloco {b.get('id')!r}") from exc
        chaves[b["id"]] = (y0, x0, i)
        tokens = (b.get("text") or "").split()
        centro = (y0 + y1) / 2
        # Marcas tem precedencia mesmo quando aparecem nas margens.
        if regex is not None and tokens and all(regex.match(t) for t in tokens):
            grupo = "marcas"
        elif (variante == "geometria" and centro < limiar_topo * altura and y1 < limite_base_topo * altura
              or variante == "classe" and b.get(campo_classe) == classe_cabecalho):
            grupo = "topo"
        elif (variante == "geometria" and centro > limiar_rodape * altura
              or variante == "classe" and b.get(campo_classe) == classe_rodape):
            grupo = "rodape"
        else:
            grupo = "corpo"
        grupos[grupo].append(b["id"])
    corpo = set(grupos["corpo"])
    grupos["corpo"] = [bid for bid in ordem if bid in corpo]
    for grupo in ("topo", "marcas", "rodape"):
        grupos[grupo].sort(key=chaves.__getitem__)
    return grupos


def aplicar_margens(
    blocos: Sequence[Mapping], ordem: Sequence[Hashable], dimensoes: Mapping, *,
    variante: str = "geometria", limiar_topo: float = 0.07,
    limite_base_topo: float = 0.10, limiar_rodape: float = 0.95,
    padrao_marcacao: str | None = PADRAO_MARCACAO, campo_classe: str = "classe",
    classe_cabecalho: str = "cabecalho", classe_rodape: str = "rodape",
) -> list[Hashable]:
    """Devolve topo + corpo original + marcas + rodape, sem mutar entradas.

    Margens/marcas usam (top, x0, indice na lista de blocos), sem tolerancia
    vertical. Um titulo no topo pode ser falso cabecalho na variante geometrica.
    Uma caixa inteira e deslocada; tabelas e caixas com texto misto nao se partem.
    padrao_marcacao=None desativa apenas a regra de marcas.
    """
    grupos = _separar(blocos, ordem, dimensoes, variante=variante, limiar_topo=limiar_topo,
                      limite_base_topo=limite_base_topo, limiar_rodape=limiar_rodape,
                      padrao_marcacao=padrao_marcacao, campo_classe=campo_classe,
                      classe_cabecalho=classe_cabecalho, classe_rodape=classe_rodape)
    return [bid for grupo in ("topo", "corpo", "marcas", "rodape") for bid in grupos[grupo]]


def xycut_margens(
    pagina: Mapping, *, variante: str = "geometria", limiar_topo: float = 0.07,
    limite_base_topo: float = 0.10, limiar_rodape: float = 0.95,
    padrao_marcacao: str | None = PADRAO_MARCACAO, campo_classe: str = "classe",
    classe_cabecalho: str = "cabecalho", classe_rodape: str = "rodape",
) -> list[Hashable]:
    """XY-cut no corpo apos separar margens; retorna IDs como as baselines.

    Usa a entrada embaralhada fixa do protocolo. So consulta bounding_boxes,
    dimensions e page_id; a ordem silver/humana nao faz parte da entrada.
    """
    from src.data.extrator import xycut
    from src.eval.baselines import caixas
    from src.eval.protocolo import ordem_entrada

    blocos = pagina["bounding_boxes"]
    ids = [b["id"] for b in blocos]
    entrada = ordem_entrada(pagina)
    grupos = _separar(blocos, [ids[i] for i in entrada], pagina["dimensions"],
                      variante=variante, limiar_topo=limiar_topo,
                      limite_base_topo=limite_base_topo, limiar_rodape=limiar_rodape,
                      padrao_marcacao=padrao_marcacao, campo_classe=campo_classe,
                      classe_cabecalho=classe_cabecalho, classe_rodape=classe_rodape)
    corpo = set(grupos["corpo"])
    grupos["corpo"] = [ids[i] for i in xycut([i for i in entrada if ids[i] in corpo], caixas(pagina))]
    return [bid for grupo in ("topo", "corpo", "marcas", "rodape") for bid in grupos[grupo]]
"""
Piloto de RI: a ordem de leitura muda o que a busca encontra? (Japeri, RJ)

Japeri e um dos veiculos em que o fluxo do PDF NAO e confiavel, e o acervo traz 421 atos dele
(json_atos_japeri) com o texto em ordem correta de leitura. Os atos viram a colecao de teste:
cada consulta sai de um ato, e sao relevantes as paginas que contem o conteudo da consulta.
A relevancia e decidida por sobreposicao de palavras, que independe da ordem; por isso e a
mesma para todos os metodos. So muda o texto que cada metodo de ordenacao produz.

Metodos: ordem do detector (piso), fluxo do PDF (o que um indexador comum extrai), ingenua,
XY-cut e LayoutLM (checkpoint treinado, rodado agora na GPU).

Medidas, por metodo:
  fidelidade   % de frases de 12 palavras dos atos que sobrevivem no texto da pagina
               (>= 10 das 12 palavras alinhadas)
  pagina       busca BM25 com a pagina inteira como documento. Controle: o saco de palavras
               e o mesmo em qualquer ordem, entao o resultado e identico para todos
  trechos      busca BM25 em janelas de 100 palavras (passo 50), como num RAG; a pagina vale
               o seu melhor trecho. MRR@10, Recall@1, Recall@5 por tipo de consulta:
                 frase    12 palavras seguidas do corpo do ato (as de maior IDF)
                 titulo   a primeira linha do ato (ex.: "Portaria no 0555/2024")
                 termos   os 8 termos mais raros do ato, sem ordem
  contexto     % das consultas-frase cujo 1o trecho devolvido contem a frase preservada
               (o que um RAG entregaria a LLM)

Uso:
    python src/ri/piloto_japeri.py
"""
from __future__ import annotations

