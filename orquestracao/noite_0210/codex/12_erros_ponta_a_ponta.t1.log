+    out["P2d"] = ls.prever(q, FIXA, "docling")
+    for name, (seq, _, _) in out.items():
+        if len(seq) != len(q["ws"]) or set(seq) != set(range(len(q["ws"]))):
+            raise ValueError(f"{name} perdeu/repetiu palavras")
+    return out
