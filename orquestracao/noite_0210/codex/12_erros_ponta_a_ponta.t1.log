+        lines += ["", f"### {label}", "", f"n={R['resumos'][coorte]['n']}; veículos={R['resumos'][coorte]['veiculos']}.", ""] + tabela(R["resumos"][coorte])
+    lines += ["", "## Contagens adicionais: total / média por página [IC 95%]", "",
