+def f(x, n=2):
+    return "—" if x is None else f"{x:.{n}f}".replace(".", ",")
+
+
+def pct(x):
+    return f(100*x, 1) + "%"
+
+
+def cel(x, percent=False, n=2):
+    fmt = (lambda v: pct(v)) if percent else (lambda v: f(v, n))
+    return f"{fmt(x['media'])} [{fmt(x['ic'][0])}; {fmt(x['ic'][1])}]" if x["media"] is not None else "—"
+
