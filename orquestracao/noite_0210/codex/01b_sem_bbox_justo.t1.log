+def checkpoint(R):
+    raw = json.dumps(R, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
+    return f"\n<!-- {MARCADOR}\n{base64.b64encode(zlib.compress(raw, 9)).decode('ascii')}\n-->\n"
