+def tabela(S, nomes, regua):
+    out = ["| Método | τ ↑ (IC 95% por veículo) | Sucessor ↑ | ARD normalizado ↓ |",
+           "|---|---:|---:|---:|"]
+    for nome in nomes:
+        r = S[nome][regua]
+        out.append(f"| {NOMES.get(nome, nome)} | {cel(r['tau'])} | {cel(r['sucessor'], True)} | {cel(r['ard'])} |")
+    return out
