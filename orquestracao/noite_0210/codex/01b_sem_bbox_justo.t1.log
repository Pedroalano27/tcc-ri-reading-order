+def cel(obj, percent=False):
+    escala, n = (100, 1) if percent else (1, 3)
+    a, b = obj["ic95"]
+    return f"{f(obj['media'] * escala, n)}{'%' if percent else ''} [{f(a * escala, n)}; {f(b * escala, n)}]" if obj["media"] is not None else "—"
