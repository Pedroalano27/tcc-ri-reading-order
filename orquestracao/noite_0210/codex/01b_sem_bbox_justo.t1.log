+        row = {"page_id": q["p"]["page_id"], "veiculo": q["p"]["page_id"].split("/", 1)[0],
+               "auditoria": q["auditoria"], "colunas": colunas(q), "bases": baselines(q), "variantes": {}}
+        for c in cs:
+            seq, _, diag = o.prever(q, c)
+            r = avaliar(q, seq)
