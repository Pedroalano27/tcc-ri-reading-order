+    perfeita = {m: [i for i in fragments[m] if metodos[m][i]["diag"]["mediana_perfeita_fragmentada"]]
+                for m in fragments}
+    ganho_original = delta("original_lopo", "xy_ouro", "regioes")
+    recuperado = delta("xy_ouro_geo", "xy_ouro", "regioes") / ganho_original
