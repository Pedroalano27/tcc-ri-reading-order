+                     "fracao_estrita": len(estritas) / nr if nr else None,
+                     "mediana_perfeita_fragmentada": bool(fragmentadas and list(pr) == q["gt_r"]),
+                     "regioes_sem_palavras": vazias, "palavras_avaliadas": len(pw),
+                     "palavras_fora_ouro": len(seq) - len(pw)}}
