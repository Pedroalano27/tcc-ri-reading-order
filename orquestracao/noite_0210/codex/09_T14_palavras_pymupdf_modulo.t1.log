+    fundidos = {j: sorted(is_) for j, is_ in para_a.items() if len(is_) > 1}
+    deltas = [max(abs(wa[i][k] - wb[j][k]) for k in ('x0', 'x1', 'top', 'bottom')) for i, j in pares]
+    exemplos = []
