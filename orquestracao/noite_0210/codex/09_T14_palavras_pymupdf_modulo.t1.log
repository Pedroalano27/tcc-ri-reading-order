+def gravar_json(path, valor):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(path.suffix + '.tmp')
+    with tmp.open('w', encoding='utf-8') as f:
+        json.dump(valor, f, ensure_ascii=False, allow_nan=False)
