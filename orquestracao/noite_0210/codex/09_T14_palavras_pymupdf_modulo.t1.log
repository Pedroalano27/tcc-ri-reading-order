+                                          'script_sha256': assinatura_codigo(Path(__file__)),
+                                          'codigo': codigo, 'iniciada': iniciada, 'do_zero': args.do_zero,
+                                          'comando': subprocess.list2cmdline(sys.argv)})
+    testes = rodar_testes(run_dir)
+    anterior = verificar_anterior()
+    regs = []
