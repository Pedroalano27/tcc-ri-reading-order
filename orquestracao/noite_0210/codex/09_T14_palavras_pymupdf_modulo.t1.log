+        vizinhos = sorted(enumerate(wb), key=lambda jv: abs(jv[1]['top'] - va['top'])
+                          + abs(jv[1]['x0'] - va['x0']))[:2]
+        exemplos.append({'pp': va, 'mu': [v for _, v in vizinhos], 'bloco_pp': donos_a.get(i)})
