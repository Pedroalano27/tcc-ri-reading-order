+                reg['erro'] = '; '.join(reg[m].get('erro', '') for m in caminhos if reg[m]['status'] != 'ok')
+        except Exception as exc:
+            reg['erro'] = f'{type(exc).__name__}: {exc}'
+            reutilizados = []
+        # O resumo por pagina nao duplica as listas grandes de palavras dos caches.
+        pequeno = {k: v for k, v in reg.items() if k not in ('pdfplumber', 'pymupdf')}
+        pequeno.update({m: {'tempos': reg[m]['tempos']} for m in ('pdfplumber', 'pymupdf')
+                        if reg.get(m, {}).get('status') == 'ok'})
+        gravar_json(run_dir / f'{digest}_comparacao.json', pequeno)
+        regs.append(pequeno)
+        r = escrever_relatorio(regs, modelos, run_dir, testes, anterior, args.do_zero, iniciada)
+        if reg['status'] == 'ok':
+            c = reg['comparacao']
+            print(f'[{num}/{len(modelos)}] {pid}: blocos {c["n_a"]}/{c["n_b"]}, '
+                  f'idênticos {c["identicos"]}, τ stream={fmt(c["tau"]["stream"], 6)}, '
+                  f'cache={all(reutilizados)}', flush=True)
+        else:
+            print(f'[{num}/{len(modelos)}] ERRO {pid}: {reg.get("erro")}', flush=True)
+    gravar_json(run_dir / 'paginas.json', regs)
+    print('RESUMO_JSON=' + json.dumps(r, ensure_ascii=False, allow_nan=False), flush=True)
+    print(f'RELATORIO={RELATORIO.relative_to(RAIZ)}', flush=True)
+    if r['erros'] or any(t['exit_code'] != 0 for t in testes):
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/src/data/palavras_pymupdf.py b/src/data/palavras_pymupdf.py
new file mode 100644
index 0000000000000000000000000000000000000000..aa4d2b00b2efd355231486d4644e0024c5b42257
--- /dev/null
+++ b/src/data/palavras_pymupdf.py
@@ -0,0 +1,224 @@
+"""
+Extracao opcional de palavras por PyMuPDF para o segmentador v3.
+
+Evita o parsing de pagina do pdfminer, mantendo o contrato de palavras_da_pagina:
+dicts com t, x0, x1, top, bottom e s, em pontos na MediaBox rotacionada, origem
+superior esquerda. O extrator original NAO recorta pela CropBox: este modulo
+tambem inclui texto fora dela quando o centro fica dentro das dimensoes da pagina.
+
+Usa get_texttrace(), nao get_text('words'): os caracteres seguem a sequencia de
+desenho (seqno), sem espacos sintetizados nem agrupamento geometrico do TextPage.
+Reconstrui tokens com x_tolerance=1.5 e y_tolerance=2, desduplica caracteres a
+1 ponto e aplica a mesma juncao de letras espacadas. A altura usa o /Descent do
+FontDescriptor e o tamanho da fonte, como o pdfminer; fontes PDF padrao usam
+as metricas AFM. Negrito e tamanho NAO sao campos do contrato do extrator: o
+segmentador infere mudanca de fonte pela altura da caixa. Negrito falso e
+removido por desduplicacao, inclusive texto simultaneamente preenchido/tracado.
+
+Limites: CMaps/ligaduras, largura de glifos, texto inclinado, fontes Type3,
+fontes com mesmo nome e descritores conflitantes e transformacoes anisotropicas
+podem divergir. Nao garante identidade da segmentacao nem da referencia silver;
+rode orquestracao/analises/extrator_pymupdf_paridade.py antes de adotar.
+Nao modifica a pagina, nao abre rede, nao usa modelos, GPU nem pdfplumber.
+
+Uso (da raiz):
+    import pymupdf
+    from src.data.palavras_pymupdf import palavras_da_pagina_pymupdf
+    from src.data.extrator import segmentar
+    with pymupdf.open('diario.pdf') as pdf:
+        blocos = segmentar(palavras_da_pagina_pymupdf(pdf[0]))
+
+diagnostico={} e opcional: recebe contagens de aproximacoes de fonte/orientacao.
+Licenca da dependencia PyMuPDF: AGPL ou licenca comercial da Artifex.
+"""
+from __future__ import annotations
+
+import itertools
+import math
+import re
+from collections import Counter, defaultdict
+
+import pymupdf
+
+from src.data.extrator import _juntar_letras_espacadas
+
+
+def _nome_fonte(nome):
+    return re.sub(r"^[A-Z]{6}\+", "", nome).replace(" ", "")
+
+
+def _descidas(page):
+    """Le metrica PDF; nao extrai nem carrega arquivos de fonte."""
+    doc = page.parent
+    saida = defaultdict(set)
+    for fonte in page.get_fonts(full=True):
+        xref, _, tipo, nome = fonte[:4]
+        nome = _nome_fonte(nome)
+        if tipo == "Type3":
+            continue
+        # Type0 pode guardar DescendantFonts em array ou em objeto indireto.
+        if tipo == "Type0":
+            kind, value = doc.xref_get_key(xref, "DescendantFonts")
+            if kind == "xref":
+                value = doc.xref_object(int(value.split()[0]))
+            refs = re.findall(r"(\d+)\s+\d+\s+R", value)
+            if refs:
+                xref = int(refs[0])
+        kind, value = doc.xref_get_key(xref, "FontDescriptor")
+        if kind == "xref":
+            kind, value = doc.xref_get_key(int(value.split()[0]), "Descent")
+        elif kind == "dict":
+            kind, value = doc.xref_get_key(xref, "FontDescriptor/Descent")
+        if kind in ("int", "real"):
+            saida[nome].add(-abs(float(value)) / 1000)
+        elif nome in ("Symbol", "ZapfDingbats"):
+            saida[nome].add(0.0)
+        elif nome.startswith(("Helvetica", "Arial")):
+            saida[nome].add(-0.207)
+        elif nome.startswith(("Courier", "CourierNew")):
+            saida[nome].add(-0.194)
+        elif nome.startswith(("Times-", "TimesNewRoman,")) or nome == "TimesNewRoman":
+            saida[nome].add(-0.217)
+    return saida
+
+
+def _matriz_pdfplumber(page):
+    """PDF -> MediaBox rotacionada, incluindo a origem nao nula do pdfplumber."""
+    x0, y0, x1, y1 = page.mediabox
+    w, h = x1 - x0, y1 - y0
+    rot = page.rotation % 360
+    if rot == 0:
+        saida = pymupdf.Matrix(1, 0, 0, -1, 0, h)
+    if rot == 90:
+        saida = pymupdf.Matrix(0, 1, 1, 0, 0, -2 * x0)
+    elif rot == 180:
+        saida = pymupdf.Matrix(-1, 0, 0, 1, x1 + x0, -2 * y0)
+    elif rot == 270:
+        saida = pymupdf.Matrix(0, -1, -1, 0, y1 + y0, w)
+    # transformation_matrix perde o deslocamento de CropBox em paginas giradas
+    # na versao 1.28.2. Construi a inversa sem alterar a pagina nem o documento.
+    cx, cy = page.cropbox_position
+    nativo_para_pdf = pymupdf.Matrix(1, 0, 0, -1, cx, y1 - cy)
+    return nativo_para_pdf * saida
+
+
+def _clusters(itens, campo, tolerancia=1.0):
+    """Clusters encadeados, como dedupe_chars; nao usa buckets arredondados."""
+    grupo, anterior = [], None
+    for item in sorted(itens, key=lambda c: c[campo]):
+        valor = item[campo]
+        if anterior is not None and valor > anterior + tolerancia:
+            yield grupo
+            grupo = []
+        grupo.append(item)
+        anterior = valor
+    if grupo:
+        yield grupo
+
+
+def _desduplicar(chars):
+    grupos = defaultdict(list)
+    for c in chars:
+        grupos[(c['upright'], c['t'], c['font'], c['size'])].append(c)
+    unicos = []
+    for grupo in grupos.values():
+        for ys in _clusters(grupo, 'top'):
+            for xs in _clusters(ys, 'x0'):
+                unicos.append(min(xs, key=lambda c: (c['top'], c['x0'], c['i'])))
+    return sorted(unicos, key=lambda c: c['i'])
+
+
+def palavras_da_pagina_pymupdf(page: pymupdf.Page, *, diagnostico=None):
+    """Devolve palavras no contrato do extrator; page deve ser uma pagina PDF aberta.
+
+    s e o ordinal da palavra antes do filtro de orientacao/centro, nao uma
+    coordenada nem uma promessa de igualdade com o indice do outro parser.
+    diagnostico, quando fornecido, e preenchido sem alterar o contrato de saida.
+    """
+    if not page.parent.is_pdf:
+        raise ValueError("A pagina deve pertencer a um documento PDF.")
+    diag = Counter()
+    descidas = _descidas(page)
+    matriz = _matriz_pdfplumber(page)
+    chars = []
+    rot = page.rotation % 360
+    w, h = page.mediabox.width, page.mediabox.height
+    if rot in (90, 270):
+        w, h = h, w
+    for span in sorted(page.get_texttrace(), key=lambda s: s['seqno']):
+        dx, dy = span['dir']
+        nome = _nome_fonte(span['font'])
+        valores = descidas.get(nome, set())
+        if len(valores) == 1:
+            desc = next(iter(valores))
+        else:
+            desc = -abs(float(span['descender']))
+            diag['fonte_ambigua' if valores else 'fonte_sem_descritor'] += len(span['chars'])
+        size = float(span['size'])
+        horizontal = abs(dy) < 1e-5 and abs(abs(dx) - 1) < 1e-5
+        vertical = abs(dx) < 1e-5 and abs(abs(dy) - 1) < 1e-5
+        if not (horizontal or vertical):
+            diag['orientacao_aproximada'] += len(span['chars'])
+        upright = (horizontal and rot in (0, 180)) or (vertical and rot in (90, 270))
+        for codigo, _, origem, bbox in span['chars']:
+            texto = chr(codigo) if 0 <= codigo <= 0x10ffff else '\ufffd'
+            ox, oy = origem
+            # Altura PDF: baseline + descent ate baseline + descent + size.
+            # As larguras continuam sendo as do MuPDF, sem estimativa por texto.
+            if horizontal:
+                a, b = oy - dx * (1 + desc) * size, oy - dx * desc * size
+                native = (bbox[0], min(a, b), bbox[2], max(a, b))
+            elif vertical:
+                a, b = ox + dy * (1 + desc) * size, ox + dy * desc * size
+                native = (min(a, b), bbox[1], max(a, b), bbox[3])
+            else:
+                native = bbox
+            caixa = pymupdf.Rect(native) * matriz
+            valores_caixa = (*caixa, size)
+            if not all(math.isfinite(v) for v in valores_caixa):
+                diag['caractere_nao_finito'] += 1
+                continue
+            chars.append({'t': texto, 'x0': float(caixa.x0), 'x1': float(caixa.x1),
+                          'top': float(caixa.y0), 'bottom': float(caixa.y1), 'upright': upright,
+                          'font': nome, 'size': size, 'i': len(chars)})
+    antes = len(chars)
+    chars = _desduplicar(chars)
+    diag['caracteres_desduplicados'] = antes - len(chars)
+    palavras = []
+    ordinal = 0
+
+    def fechar(atual):
+        nonlocal ordinal
+        if not atual:
+            return
+        palavra = {'t': ''.join(c['t'] for c in atual),
+                   'x0': min(c['x0'] for c in atual), 'x1': max(c['x1'] for c in atual),
+                   'top': min(c['top'] for c in atual), 'bottom': max(c['bottom'] for c in atual),
+                   's': ordinal}
+        ordinal += 1
+        palavra['t'] = palavra['t'].strip().translate(str.maketrans(
+            {'\ufb00': 'ff', '\ufb01': 'fi', '\ufb02': 'fl', '\ufb03': 'ffi',
+             '\ufb04': 'ffl', '\ufb05': 'st', '\ufb06': 'st'}))
+        cx = (palavra['x0'] + palavra['x1']) / 2
+        cy = (palavra['top'] + palavra['bottom']) / 2
+        if atual[0]['upright'] and palavra['t'] and 0 <= cx <= w and 0 <= cy <= h:
+            palavras.append(palavra)
+
+    for _, grupo in itertools.groupby(chars, key=lambda c: c['upright']):
+        atual = []
+        for c in grupo:
+            if c['t'].isspace():
+                fechar(atual)
+                atual = []
+                continue
+            if atual:
+                ant = atual[-1]
+                if (c['x0'] < ant['x0'] or c['x0'] > ant['x1'] + 1.5
+                        or abs(c['top'] - ant['top']) > 2):
+                    fechar(atual)
+                    atual = []
+            atual.append(c)
+        fechar(atual)
+    if diagnostico is not None:
+        diagnostico.update(diag)
+    return _juntar_letras_espacadas(palavras)
diff --git a/tests/test_palavras_pymupdf.py b/tests/test_palavras_pymupdf.py
new file mode 100644
index 0000000000000000000000000000000000000000..e94a2a591ec6ba97c9afdb7c6c8f662befa03716
--- /dev/null
+++ b/tests/test_palavras_pymupdf.py
@@ -0,0 +1,167 @@
+"""
+Testes do adaptador PyMuPDF com PDFs sinteticos gerados em memoria.
+
+Compara o contrato e a geometria com o caminho original, incluindo CropBox,
+rotacao, fluxo contrario a geometria, fontes e desduplicacao. Verifica tambem
+os blocos e as ordens em um exemplo multicoluna sem depender do acervo.
+
+Uso: venv/Scripts/python.exe -B -m unittest tests.test_palavras_pymupdf -v
+     venv/Scripts/python.exe -B -m unittest discover -s tests -v
+"""
+from __future__ import annotations
+
+import io
+import unittest
+
+import pdfplumber
+import pymupdf
+
+from src.data.extrator import palavras_da_pagina, segmentar, xycut
+from src.data.palavras_pymupdf import palavras_da_pagina_pymupdf
+
+
+class TestPalavrasPyMuPDF(unittest.TestCase):
+    def setUp(self):
+        self.doc = pymupdf.open()
+        self.page = self.doc.new_page(width=400, height=500)
+
+    def tearDown(self):
+        self.doc.close()
+
+    def comparar(self, tolerancia=0.003):
+        with pdfplumber.open(io.BytesIO(self.doc.tobytes())) as pdf:
+            original = palavras_da_pagina(pdf.pages[0])
+        novo = palavras_da_pagina_pymupdf(self.page)
+        self.assertEqual([w['t'] for w in original], [w['t'] for w in novo])
+        self.assertEqual([w['s'] for w in original], [w['s'] for w in novo])
+        for a, b in zip(original, novo):
+            self.assertEqual(set(b), {'t', 'x0', 'x1', 'top', 'bottom', 's'})
+            for k in ('x0', 'x1', 'top', 'bottom'):
+                self.assertAlmostEqual(a[k], b[k], delta=tolerancia, msg=f'{a["t"]}: {k}')
+        return original, novo
+
+    def test_pagina_vazia(self):
+        self.assertEqual(self.comparar(), ([], []))
+
+    def test_contrato_fontes_e_pontuacao(self):
+        for j, fonte in enumerate(('helv', 'hebo', 'heit', 'tiro', 'tibo', 'cour')):
+            self.page.insert_text((35, 55 + 35 * j), 'Art. 1: resolucao, 2026.',
+                                  fontname=fonte, fontsize=9 + j)
+        self.comparar()
+
+    def test_cropbox_deslocada_inclui_texto_fora_do_recorte(self):
+        self.page.insert_text((10, 20), 'FORA')
+        self.page.insert_text((100, 120), 'DENTRO')
+        self.page.set_cropbox(pymupdf.Rect(40, 50, 350, 450))
+        _, novo = self.comparar()
+        self.assertEqual([w['t'] for w in novo], ['FORA', 'DENTRO'])
+        self.assertEqual(novo[0]['x0'], 10)
+
+    def test_rotacao_da_pagina(self):
+        self.page.insert_text((100, 120), 'ABC texto')
+        for rotacao in (0, 90, 180, 270):
+            with self.subTest(rotacao=rotacao):
+                self.page.set_rotation(rotacao)
+                self.comparar()
+
+    def test_rotacao_com_cropbox(self):
+        self.page.insert_text((100, 120), 'ABC texto')
+        self.page.set_cropbox(pymupdf.Rect(40, 50, 350, 450))
+        for rotacao in (0, 90, 180, 270):
+            with self.subTest(rotacao=rotacao):
+                self.page.set_rotation(rotacao)
+                self.comparar()
+
+    def test_texto_vertical_descartado(self):
+        self.page.insert_text((100, 220), 'VERTICAL', rotate=90)
+        self.page.insert_text((80, 80), 'HORIZONTAL')
+        _, novo = self.comparar()
+        self.assertEqual([w['t'] for w in novo], ['HORIZONTAL'])
+
+    def test_texto_vertical_fica_horizontal_apos_rotacao(self):
+        self.page.insert_text((100, 220), 'VERTICAL', rotate=90)
+        self.page.set_rotation(90)
+        self.comparar()
+
+    def test_origem_mediabox_nao_nula(self):
+        self.doc.xref_set_key(self.page.xref, 'MediaBox', '[20 30 420 530]')
+        self.page = self.doc.reload_page(self.page)
+        self.page.insert_text((100, 120), 'Texto')
+        for rotacao in (0, 90, 180, 270):
+            with self.subTest(rotacao=rotacao):
+                self.page.set_rotation(rotacao)
+                self.comparar()
+
+    def test_fluxo_diferente_da_ordem_geometrica(self):
+        self.page.insert_text((240, 200), 'Primeiro')
+        self.page.insert_text((40, 60), 'Segundo')
+        _, novo = self.comparar()
+        self.assertEqual([w['t'] for w in novo], ['Primeiro', 'Segundo'])
+
+    def test_negrito_falso(self):
+        self.page.insert_text((50, 80), 'Texto duplicado')
+        self.page.insert_text((50.3, 80.3), 'Texto duplicado')
+        diag = {}
+        novo = palavras_da_pagina_pymupdf(self.page, diagnostico=diag)
+        self.assertEqual([w['t'] for w in novo], ['Texto', 'duplicado'])
+        self.assertGreater(diag['caracteres_desduplicados'], 0)
+        self.comparar()
+
+    def test_preenchimento_e_contorno(self):
+        self.page.insert_text((50, 80), 'Texto', render_mode=2)
+        _, novo = self.comparar()
+        self.assertEqual([w['t'] for w in novo], ['Texto'])
+
+    def test_mesmo_texto_em_posicoes_diferentes(self):
+        for x, y in ((40, 80), (200, 80), (40, 160)):
+            self.page.insert_text((x, y), 'Texto')
+        _, novo = self.comparar()
+        self.assertEqual(len(novo), 3)
+
+    def test_letras_espacadas(self):
+        self.page.insert_text((40, 80), 'R E S O L V E:', fontsize=12)
+        _, novo = self.comparar()
+        self.assertEqual([w['t'] for w in novo], ['RESOLVE:'])
+
+    def test_tokens_em_operadores_separados(self):
+        self.page.insert_text((40, 80), 'Texto', fontsize=12)
+        largura = pymupdf.get_text_length('Texto', fontsize=12)
+        self.page.insert_text((40 + largura + 1, 80), 'junto', fontsize=12)
+        _, novo = self.comparar()
+        self.assertEqual([w['t'] for w in novo], ['Textojunto'])
+
+    def test_fontdescriptor_embutido(self):
+        fonte = pymupdf.Font('cjk')
+        self.page.insert_font(fontname='embutida', fontbuffer=fonte.buffer)
+        self.page.insert_text((40, 80), 'Texto com fonte embutida', fontname='embutida')
+        # Fontes embutidas podem ter larguras PDF arredondadas a 1/1000 em.
+        self.comparar(tolerancia=0.02)
+
+    def test_nao_modifica_pagina(self):
+        self.page.insert_text((40, 80), 'Texto')
+        self.page.set_cropbox(pymupdf.Rect(20, 30, 380, 480))
+        antes = (tuple(self.page.cropbox), self.page.rotation,
+                 self.doc.xref_object(self.page.xref), self.page.read_contents())
+        palavras_da_pagina_pymupdf(self.page)
+        depois = (tuple(self.page.cropbox), self.page.rotation,
+                  self.doc.xref_object(self.page.xref), self.page.read_contents())
+        self.assertEqual(antes, depois)
+
+    def test_segmentacao_e_ordens_multicoluna(self):
+        for x in (220, 30):
+            for j in range(5):
+                self.page.insert_text((x, 70 + 13 * j), f'Linha {j} da coluna {x}', fontsize=10)
+        a, b = self.comparar()
+        tabelas = [[210, 55, 390, 130]]
+        for tab in (None, tabelas):
+            with self.subTest(tabelas=tab):
+                ba, bb = segmentar(a, tab), segmentar(b, tab)
+                self.assertEqual([v['texto'] for v in ba], [v['texto'] for v in bb])
+                for chave in ('s', 'top'):
+                    self.assertEqual(sorted(range(len(ba)), key=lambda i: ba[i][chave]),
+                                     sorted(range(len(bb)), key=lambda i: bb[i][chave]))
+                self.assertEqual(xycut(list(range(len(ba))), ba), xycut(list(range(len(bb))), bb))
+
+
+if __name__ == '__main__':
+    unittest.main()

