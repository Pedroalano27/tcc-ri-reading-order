+               'Palavras sem par PP/Mu | Desvio máx. pt | Intervenção G: idênticos/PP, n blocos |',
+               '|---|---:|---:|---:|---:|---:|---:|']
+    mudam = [v for v in regs if v['status'] == 'ok' and not v['comparacao']['mesma']]
+    for v in mudam:
