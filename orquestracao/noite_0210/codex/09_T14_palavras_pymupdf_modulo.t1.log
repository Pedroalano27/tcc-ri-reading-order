+    candidatos += [i for i, _ in sorted(pares, key=lambda ij: max(
+        abs(wa[ij[0]][k] - wb[ij[1]][k]) for k in ('x0', 'x1', 'top', 'bottom')), reverse=True)[:2]]
+    for i in candidatos[:3]:
