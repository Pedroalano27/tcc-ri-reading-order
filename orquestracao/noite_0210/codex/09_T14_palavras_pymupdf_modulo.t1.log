+def rodar_testes(run_dir):
+    """Subprocessos offline; logs e contagens reais entram no relatorio."""
+    env = {**os.environ, 'PYTHONDONTWRITEBYTECODE': '1', 'CUDA_VISIBLE_DEVICES': '',
