+    destino = run_dir / ('envelope_' + hashlib.sha256(str(path).encode()).hexdigest()[:16] + '.pdf')
+    if not destino.exists():
+        destino.write_bytes(dados[a:b + len(b'%%EOF')])
+    return destino, True
