+def compactar_blocos(blocos, ws):
+    indices = {id(w): i for i, w in enumerate(ws)}
+    return [{**{k: b[k] for k in ('texto', 'x0', 'x1', 'top', 'bottom', 's')},
+             'tabela': bool(b.get('tabela')),
+             'palavras': [indices[id(w)] for l in b['linhas'] for w in l['ws']]}
+            for b in blocos]
