+        pura = [ids[i] for i in xycut(ordem_entrada(p), caixas(p))]
+        self.assertEqual(aplicar_margens(bs, pura, DIMENSOES), ["l1", "r1", "l2", "r2", "m"])
+        self.assertEqual(xycut_margens(p), ["l1", "l2", "r1", "r2", "m"])
+
+
