+        keys = ("paginas", "resumo", "quedas", "sensibilidade", "auditoria")
+        if any(R[k] != anterior[k] for k in keys):
+            raise ValueError("Execucao do zero divergiu da anterior")
+        R["reproduziu"] = True
+    if hashes(paths) != H:
+        raise ValueError("Entradas/fontes mudaram durante a execucao")
+    gravar(R)
