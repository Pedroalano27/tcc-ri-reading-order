+            "| Conjunto | Topo | Rodapé | τ XY-cut pós | τ Ingênua pós | τ Sucessor pós | τ recorte | Sucessor recorte | ARD recorte |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|"]
+    for nome, grade in R.get("sensibilidade", {}).items():
