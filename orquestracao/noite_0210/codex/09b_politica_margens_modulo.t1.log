+        self.assertEqual(nova, ["z", "a", "c"])
+        self.assertEqual(aplicar_margens(bs, nova, DIMENSOES), nova)
+        self.assertEqual((bs, ordem, DIMENSOES), antes)
+        self.assertIsNot(nova, ordem)
