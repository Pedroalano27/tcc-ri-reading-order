+            "--- a/src/eval/baselines.py", "+++ b/src/eval/baselines.py",
+            "@@", "+from src.eval.politica_margens import xycut_margens",
+            "@@", '-    saidas = {"aleatoria": [], "naive": [], "xycut": []}',
