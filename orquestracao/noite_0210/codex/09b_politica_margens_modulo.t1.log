def salvar(fig, nome):
    os.makedirs(DIR_FIG, exist_ok=True)
    caminho = os.path.join(DIR_FIG, nome)
    fig.savefig(caminho, dpi=200, bbox_inches="tight")
    plt.close(fig)
    print(f"  [OK] {caminho}")


