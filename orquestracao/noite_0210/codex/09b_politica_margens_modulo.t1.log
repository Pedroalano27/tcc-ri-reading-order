+            '+            "ordem_pred": pred, "tempo_ms": (time.perf_counter() - t0) * 1000})',
+            "--- a/src/eval/comparar.py", "+++ b/src/eval/comparar.py", "@@",
+            '+    "xycut_margens": "XY-cut + margens (geométricas; recorte)",  # em NOMES',
+            "--- a/src/eval/figuras.py", "+++ b/src/eval/figuras.py", "@@",
+            '+    "xycut_margens": "XY-cut + margens",  # em ROTULO',
+            '+    "xycut_margens": "#eb6834",  # em COR, mesma família da XY-cut', "```", "",
+            "## Testes, reprodução e integridade", ""]
+    if not R.get("testes"):
+        out += ["Testes ainda não registrados; executar com `--testes`.", ""]
+    for t in R.get("testes", []):
+        out += [f"`{t['comando']}`: código {t['codigo']}, {t['n']} testes, "
+                f"{'OK' if t['codigo']==0 else 'FALHOU'}. Saída integral guardada no checkpoint.", ""]
+    out += ["```powershell", "venv/Scripts/python.exe -B orquestracao/analises/politica_margens_avaliacao.py --do-zero --testes",
+            "venv/Scripts/python.exe -B orquestracao/analises/politica_margens_avaliacao.py --conferir", "```", "",
+            "O checkpoint no comentário HTML abaixo contém hashes de entradas/fontes, ordens com/sem, "
+            "métricas por página, grade completa e saídas dos testes. Não há cache em data/ nem arquivos novos de predição/comparação. "
+            "Durante a execução, checkpoints são acrescentados sem apagar o anterior; a retomada ignora o último se estiver truncado. "
+            "Ao concluir, o relatório é compactado no mesmo arquivo, com sincronização antes de truncar o diário. "
+            "A execução padrão retoma somente hashes idênticos; `--do-zero` recalcula todas as páginas.", ""]
+    if R.get("reproduziu"):
+        out += ["**Execução final do zero:** reproduziu exatamente ordens, métricas, quedas, grade e resumos da execução anterior. "
+                "O relatório inteiro bate com a renderização do checkpoint; as métricas das ordens foram recalculadas na conferência.", ""]
+    return "\n".join(out)
+
+
+def ler_cache():
+    if not SAIDA.exists():
+        return None
+    texto = SAIDA.read_text(encoding="utf-8")
+    matches = list(re.finditer(rf"<!-- {MARCADOR}\n([A-Za-z0-9+/=]+)\n-->", texto))
+    for m in reversed(matches):
+        try:
+            return json.loads(zlib.decompress(base64.b64decode(m[1])))
+        except (ValueError, zlib.error, UnicodeError):
+            continue
+    if matches:
+        print("[AVISO] Checkpoints danificados; sera recalculado.", flush=True)
+    return None
+
+
+def checkpoint(R):
+    payload = json.dumps(R, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
+    cache = base64.b64encode(zlib.compress(payload.encode("utf-8"), 9)).decode("ascii")
+    return f"\n<!-- {MARCADOR}\n{cache}\n-->\n"
+
+
+def documento(R):
+    return renderizar(R) + checkpoint(R)
+
+
+def gravar(R, atualizar_texto=False):
+    # Um diario no proprio Markdown protege contra queda no meio da escrita.
+    if not R.get("completo"):
+        conteudo = documento(R) if atualizar_texto or not SAIDA.exists() else checkpoint(R)
+        with SAIDA.open("a", encoding="utf-8", newline="\n") as f:
+            f.write(conteudo)
+            f.flush()
+            os.fsync(f.fileno())
+        return
+    # Nao usar modo w: os checkpoints no fim sobrevivem a compactacao incompleta.
+    with SAIDA.open("r+" if SAIDA.exists() else "w+", encoding="utf-8", newline="\n") as f:
+        f.write(documento(R))
+        f.flush()
+        os.fsync(f.fileno())
+        f.truncate()
+        f.flush()
+        os.fsync(f.fileno())
+
+
+def executar_testes():
+    comandos = [("-m", "unittest", "tests.test_politica_margens", "-v"),
+                ("-m", "unittest", "discover", "-s", "tests", "-v")]
+    saidas = []
+    for args in comandos:
+        cmd = [str(RAIZ / "venv/Scripts/python.exe"), "-B", *args]
+        env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", PYTHONIOENCODING="utf-8", CUDA_VISIBLE_DEVICES="")
+        r = subprocess.run(cmd, cwd=RAIZ, env=env, capture_output=True, text=True, encoding="utf-8", errors="replace")
+        saida = r.stdout + r.stderr
+        n = re.search(r"Ran (\d+) tests?", saida)
+        saidas.append({"comando": "venv/Scripts/python.exe -B " + " ".join(args), "codigo": r.returncode,
+                       "n": int(n[1]) if n else None, "saida": saida})
+        print(f"[{'OK' if r.returncode == 0 else 'FALHA'}] {' '.join(args)}: "
+              f"{int(n[1]) if n else '?'} testes, codigo {r.returncode}.", flush=True)
+        if r.returncode:
+            print(saida, flush=True)
+    return saidas
+
+
+def conferir(R, conjuntos, H):
+    if not R or R["hashes"] != H or not R.get("completo"):
+        raise ValueError("Checkpoint incompleto ou hashes diferentes")
+    for r in R["paginas"]:
+        p, gt = conjuntos[r["conjunto"]][r["page_id"]]
+        if gt != r["gt"]:
+            raise ValueError("Referencia mudou")
+        for m, ordem in r["ordens"].items():
+            aplicar_margens(p["bounding_boxes"], ordem, p["dimensions"])
+            if avaliar(ordem, gt) != r["metricas"][m]:
+                raise ValueError(f"Metricas inconsistentes: {r['page_id']} / {m}")
+        for g in r["grade"]:
+            for m,d in g["metodos"].items():
+                if avaliar(d["ordem"],gt) != d["metricas"]:
+                    raise ValueError("Grade inconsistente")
+    anterior = {k: R[k] for k in ("resumo", "quedas", "sensibilidade", "resumo_fora_v4")}
+    agregar(R, conjuntos)
+    if anterior != {k: R[k] for k in anterior}:
+        raise ValueError("Agregacao nao reproduziu")
+    if SAIDA.read_text(encoding="utf-8") != documento(R):
+        raise ValueError("Relatorio diverge do checkpoint")
+    print("[OK] Hashes, ordens, metricas, grade, resumos e Markdown integral conferidos.")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--do-zero", action="store_true")
+    ap.add_argument("--conferir", action="store_true")
+    ap.add_argument("--testes", action="store_true")
+    ap.add_argument("--reamostras", type=int, default=2000)
+    ap.add_argument("--semente", type=int, default=7)
+    args = ap.parse_args()
+    if args.reamostras < 100:
+        ap.error("usar pelo menos 100 reamostras")
+    conjuntos, predicoes, auditoria, paths = carregar()
+    H = hashes(paths)
+    cache = ler_cache()
+    if args.conferir:
+        conferir(cache, conjuntos, H)
+        return
+    compativel = bool(cache and cache["hashes"] == H and cache["nboot"] == args.reamostras
+                      and cache["semente"] == args.semente)
+    anterior = cache if args.do_zero and compativel and cache.get("completo") else None
+    R = cache if compativel and not args.do_zero else {
+        "hashes": H, "nboot": args.reamostras, "semente": args.semente, "auditoria": auditoria,
+        "paginas": [], "testes": [], "completo": False}
+    feitos = {(r["conjunto"], r["page_id"]) for r in R["paginas"]}
+    for nome in CONJUNTOS:
+        for pid,(p,gt) in sorted(conjuntos[nome].items()):
+            if (nome,pid) in feitos:
+                continue
+            R["paginas"].append(medir_pagina(nome,pid,p,gt,predicoes[nome]))
+            # Publica numeros apos a primeira pagina e ao fechar cada conjunto.
+            if len(R["paginas"]) == 1:
+                agregar(R, conjuntos)
+            gravar(R, atualizar_texto=len(R["paginas"]) == 1)
+        agregar(R, conjuntos)
+        gravar(R, atualizar_texto=True)
+        print(f"[OK] {nome}: {len(conjuntos[nome])} paginas; relatorio atualizado.", flush=True)
+    if args.testes:
+        R["testes"] = executar_testes()
+    R["completo"] = True
+    if anterior:
+        keys = ("paginas", "resumo", "quedas", "sensibilidade", "auditoria", "resumo_fora_v4")
+        if any(R[k] != anterior[k] for k in keys):
+            raise ValueError("Execucao do zero divergiu da anterior")
+        R["reproduziu"] = True
+    if hashes(paths) != H:
+        raise ValueError("Entradas/fontes mudaram durante a execucao")
+    gravar(R)
+    conferir(R, conjuntos, H)
+    # Imprime exatamente a tabela do relatorio para conferencia humana.
+    t = renderizar(R).split("## Tabela principal: candidato com recorte geométrico\n\n",1)[1].split("\n\n##",1)[0]
+    print(t, flush=True)
+    print(f"[OK] {SAIDA.relative_to(RAIZ)}")
+    if any(t["codigo"] for t in R["testes"]):
+        raise SystemExit("Ha falhas na suite; ver relatorio/checkpoint.")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/eval/politica_margens.py b/src/eval/politica_margens.py
new file mode 100644
index 0000000000000000000000000000000000000000..d262389cc1672c280901bfd28588b7275da3690f
--- /dev/null
+++ b/src/eval/politica_margens.py
@@ -0,0 +1,127 @@
+"""Aplica uma politica explicita de margens a ordens de leitura de blocos.
+
+Cabecalhos primeiro, marcas de diagramacao antes do rodape e rodapes por ultimo
+evitam que campos laterais interrompam colunas. Os padroes reproduzem a regra
+de ordem_sem_bbox_justo.py: centro < 7% e base < 10% no topo, centro > 95% no
+rodape. A variante por classe substitui os dois testes por cabecalho/rodape;
+nao usa geometria como fallback quando a classe falta.
+
+Uso: aplicar_margens(p['bounding_boxes'], ids, p['dimensions']) devolve uma
+lista nova, preservando exatamente a ordem relativa do corpo. xycut_margens(p)
+separa as margens ANTES de calcular XY-cut no corpo, como na reanalise. Estas
+operacoes nao sao equivalentes: remover caixas pode mudar os cortes do corpo.
+As duas funcoes recebem apenas texto, caixas e, opcionalmente, classes; nunca
+consultam p['ordens'], anotacoes ou modelos. Nao ha I/O nem alteracao da entrada.
+
+IDs devem formar uma permutacao completa, sem repeticao. Entrada invalida gera
+ValueError: reparar silenciosamente poderia esconder troca de segmentacao.
+Caixas e dimensoes usam a mesma unidade e coordenadas [x0, top, x1, bottom].
+"""
+from __future__ import annotations
+
+import math
+import re
+from collections.abc import Mapping, Sequence
+from typing import Hashable
+
+PADRAO_MARCACAO = r"^(?:<@[^>]+>|<#[^>]+>|contPageBreak.*)$"
+
+
+def _separar(blocos, ordem, dimensoes, *, variante, limiar_topo,
+             limite_base_topo, limiar_rodape, padrao_marcacao, campo_classe,
+             classe_cabecalho, classe_rodape):
+    """Valida e particiona, usando indice do bloco como desempate estavel."""
+    if variante not in ("geometria", "classe"):
+        raise ValueError("variante deve ser 'geometria' ou 'classe'")
+    if not (0 <= limiar_topo <= limite_base_topo <= limiar_rodape <= 1):
+        raise ValueError("limiares devem satisfazer 0 <= topo <= base <= rodape <= 1")
+    try:
+        largura, altura = float(dimensoes["width"]), float(dimensoes["height"])
+        if not all(math.isfinite(v) and v > 0 for v in (largura, altura)):
+            raise ValueError
+        ids = [b["id"] for b in blocos]
+        if len(set(ids)) != len(ids):
+            raise ValueError
+        if len(ordem) != len(ids) or len(set(ordem)) != len(ordem) or set(ordem) != set(ids):
+            raise ValueError
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError("dimensoes invalidas, IDs repetidos ou ordem nao e permutacao completa") from exc
+    regex = re.compile(padrao_marcacao) if padrao_marcacao is not None else None
+    grupos = {k: [] for k in ("topo", "corpo", "marcas", "rodape")}
+    chaves = {}
+    for i, b in enumerate(blocos):
+        try:
+            x0, y0, x1, y1 = map(float, b["bbox"])
+            if not all(math.isfinite(v) for v in (x0, y0, x1, y1)) or x1 < x0 or y1 < y0:
+                raise ValueError
+        except (KeyError, TypeError, ValueError) as exc:
+            raise ValueError(f"bbox invalida no bloco {b.get('id')!r}") from exc
+        chaves[b["id"]] = (y0, x0, i)
+        tokens = (b.get("text") or "").split()
+        centro = (y0 + y1) / 2
+        # Marcas tem precedencia mesmo quando aparecem nas margens.
+        if regex is not None and tokens and all(regex.match(t) for t in tokens):
+            grupo = "marcas"
+        elif (variante == "geometria" and centro < limiar_topo * altura and y1 < limite_base_topo * altura
+              or variante == "classe" and b.get(campo_classe) == classe_cabecalho):
+            grupo = "topo"
+        elif (variante == "geometria" and centro > limiar_rodape * altura
+              or variante == "classe" and b.get(campo_classe) == classe_rodape):
+            grupo = "rodape"
+        else:
+            grupo = "corpo"
+        grupos[grupo].append(b["id"])
+    corpo = set(grupos["corpo"])
+    grupos["corpo"] = [bid for bid in ordem if bid in corpo]
+    for grupo in ("topo", "marcas", "rodape"):
+        grupos[grupo].sort(key=chaves.__getitem__)
+    return grupos
+
+
+def aplicar_margens(
+    blocos: Sequence[Mapping], ordem: Sequence[Hashable], dimensoes: Mapping, *,
+    variante: str = "geometria", limiar_topo: float = 0.07,
+    limite_base_topo: float = 0.10, limiar_rodape: float = 0.95,
+    padrao_marcacao: str | None = PADRAO_MARCACAO, campo_classe: str = "classe",
+    classe_cabecalho: str = "cabecalho", classe_rodape: str = "rodape",
+) -> list[Hashable]:
+    """Devolve topo + corpo original + marcas + rodape, sem mutar entradas.
+
+    Margens/marcas usam (top, x0, indice na lista de blocos), sem tolerancia
+    vertical. Um titulo no topo pode ser falso cabecalho na variante geometrica.
+    Uma caixa inteira e deslocada; tabelas e caixas com texto misto nao se partem.
+    padrao_marcacao=None desativa apenas a regra de marcas.
+    """
+    grupos = _separar(blocos, ordem, dimensoes, variante=variante, limiar_topo=limiar_topo,
+                      limite_base_topo=limite_base_topo, limiar_rodape=limiar_rodape,
+                      padrao_marcacao=padrao_marcacao, campo_classe=campo_classe,
+                      classe_cabecalho=classe_cabecalho, classe_rodape=classe_rodape)
+    return [bid for grupo in ("topo", "corpo", "marcas", "rodape") for bid in grupos[grupo]]
+
+
+def xycut_margens(
+    pagina: Mapping, *, variante: str = "geometria", limiar_topo: float = 0.07,
+    limite_base_topo: float = 0.10, limiar_rodape: float = 0.95,
+    padrao_marcacao: str | None = PADRAO_MARCACAO, campo_classe: str = "classe",
+    classe_cabecalho: str = "cabecalho", classe_rodape: str = "rodape",
+) -> list[Hashable]:
+    """XY-cut no corpo apos separar margens; retorna IDs como as baselines.
+
+    Usa a entrada embaralhada fixa do protocolo. So consulta bounding_boxes,
+    dimensions e page_id; a ordem silver/humana nao faz parte da entrada.
+    """
+    from src.data.extrator import xycut
+    from src.eval.baselines import caixas
+    from src.eval.protocolo import ordem_entrada
+
+    blocos = pagina["bounding_boxes"]
+    ids = [b["id"] for b in blocos]
+    entrada = ordem_entrada(pagina)
+    grupos = _separar(blocos, [ids[i] for i in entrada], pagina["dimensions"],
+                      variante=variante, limiar_topo=limiar_topo,
+                      limite_base_topo=limite_base_topo, limiar_rodape=limiar_rodape,
+                      padrao_marcacao=padrao_marcacao, campo_classe=campo_classe,
+                      classe_cabecalho=classe_cabecalho, classe_rodape=classe_rodape)
+    corpo = set(grupos["corpo"])
+    grupos["corpo"] = [ids[i] for i in xycut([i for i in entrada if ids[i] in corpo], caixas(pagina))]
+    return [bid for grupo in ("topo", "corpo", "marcas", "rodape") for bid in grupos[grupo]]
diff --git a/tests/test_politica_margens.py b/tests/test_politica_margens.py
new file mode 100644
index 0000000000000000000000000000000000000000..a66a62a0826edd321205629eae227ea651bc8ed0
--- /dev/null
+++ b/tests/test_politica_margens.py
@@ -0,0 +1,175 @@
+"""Testa contrato, margens e cortes do corpo sem PDF, modelo ou arquivos de dados.
+
+Uso: venv/Scripts/python.exe -B -m unittest tests.test_politica_margens -v
+"""
+from __future__ import annotations
+
+import copy
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from src.eval.politica_margens import aplicar_margens, xycut_margens
+
+DIMENSOES = {"width": 600, "height": 1000}
+
+
+def bloco(bid, x0=10, y0=200, x1=200, y1=300, texto="Conteudo", classe=None):
+    b = {"id": bid, "bbox": [x0, y0, x1, y1], "text": texto}
+    if classe is not None:
+        b["classe"] = classe
+    return b
+
+
+class TestPoliticaMargens(unittest.TestCase):
+    def test_pagina_sem_cabecalho_preserva_corpo_arbitrario(self):
+        bs = [bloco("a"), bloco("b", y0=400, y1=500), bloco("c", x0=350, x1=550)]
+        self.assertEqual(aplicar_margens(bs, ["b", "c", "a"], DIMENSOES), ["b", "c", "a"])
+
+    def test_cabecalho_dois_campos_lado_a_lado(self):
+        bs = [bloco("direita", x0=400, x1=550, y0=20, y1=35),
+              bloco("corpo"), bloco("esquerda", y0=20, y1=35)]
+        self.assertEqual(aplicar_margens(bs, ["corpo", "direita", "esquerda"], DIMENSOES),
+                         ["esquerda", "direita", "corpo"])
+
+    def test_rodape_multilinha_e_marcas_antes_dele(self):
+        bs = [bloco("r2", y0=980, y1=995), bloco("corpo"),
+              bloco("r1", y0=955, y1=975), bloco("m", y0=998, y1=999, texto="<@fim> contPageBreak2")]
+        self.assertEqual(aplicar_margens(bs, ["r2", "r1", "m", "corpo"], DIMENSOES),
+                         ["corpo", "m", "r1", "r2"])
+
+    def test_pagina_so_com_tabela_nao_parte_caixa(self):
+        bs = [bloco("t", y0=10, y1=995, classe="tabela")]
+        p = {"page_id": "tabela#p0", "bounding_boxes": bs, "dimensions": DIMENSOES}
+        self.assertEqual(aplicar_margens(bs, ["t"], DIMENSOES), ["t"])
+        self.assertEqual(xycut_margens(p), ["t"])
+
+    def test_ordem_invalida_rejeitada(self):
+        bs = [bloco("a"), bloco("b")]
+        for ordem in (["a"], ["a", "a"], ["a", "desconhecido"], ["a", "b", "extra"]):
+            with self.subTest(ordem=ordem), self.assertRaises(ValueError):
+                aplicar_margens(bs, ordem, DIMENSOES)
+        with self.assertRaises(ValueError):
+            aplicar_margens([bloco("a"), bloco("a")], ["a", "a"], DIMENSOES)
+
+    def test_classes_substituem_geometria_sem_fallback(self):
+        bs = [bloco("titulo", y0=10, y1=25, classe="titulo"),
+              bloco("c", y0=150, y1=170, classe="cabecalho"),
+              bloco("r", y0=500, y1=600, classe="rodape"), bloco("sem", y0=970, y1=990)]
+        self.assertEqual(aplicar_margens(bs, ["r", "sem", "titulo", "c"], DIMENSOES, variante="classe"),
+                         ["c", "sem", "titulo", "r"])
+
+    def test_limites_estritos_e_base_do_topo(self):
+        bs = [bloco("centro70", y0=50, y1=90), bloco("base100", y0=0, y1=100),
+              bloco("centro950", y0=940, y1=960), bloco("dentro", y0=20, y1=30)]
+        self.assertEqual(aplicar_margens(bs, ["centro950", "base100", "centro70", "dentro"], DIMENSOES),
+                         ["dentro", "centro950", "base100", "centro70"])
+
+    def test_marca_mista_e_texto_ausente_nao_sao_marcas(self):
+        bs = [bloco("misto", texto="<@inicio> texto"), bloco("vazio", texto=None), bloco("m", texto="<#fim>")]
+        self.assertEqual(aplicar_margens(bs, ["m", "misto", "vazio"], DIMENSOES), ["misto", "vazio", "m"])
+        self.assertEqual(aplicar_margens(bs, ["m", "misto", "vazio"], DIMENSOES, padrao_marcacao=None),
+                         ["m", "misto", "vazio"])
+
+    def test_idempotencia_pureza_e_desempate_indice(self):
+        bs = [bloco("z", y0=10, y1=20), bloco("a", y0=10, y1=20), bloco("c")]
+        ordem = ["c", "a", "z"]
+        antes = copy.deepcopy((bs, ordem, DIMENSOES))
+        nova = aplicar_margens(bs, ordem, DIMENSOES)
+        self.assertEqual(nova, ["z", "a", "c"])
+        self.assertEqual(aplicar_margens(bs, nova, DIMENSOES), nova)
+        self.assertEqual((bs, ordem, DIMENSOES), antes)
+        self.assertIsNot(nova, ordem)
+
+    def test_dimensoes_caixas_e_parametros_invalidos(self):
+        for dim in ({"width": 0, "height": 1000}, {"width": 600, "height": float("nan")}, {}):
+            with self.subTest(dim=dim), self.assertRaises(ValueError):
+                aplicar_margens([bloco("a")], ["a"], dim)
