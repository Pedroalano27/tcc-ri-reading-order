+        diagnosticos[nome] = diagnosticar(ctx, preds)
+        print("DIAGNÓSTICO: "+nome, flush=True)
+    exemplos_imagens(ctx, preds_cv, diagnosticos["v4_cv"])
+    r["diagnosticos"] = diagnosticos
