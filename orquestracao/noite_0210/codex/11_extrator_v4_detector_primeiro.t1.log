+            assert all(not box["texto"] for p in preds for box in p["caixas"])
+    r["pareados"] = {nome+"/"+regua: pareado(cv_rs, dados[nome], ctx, regua, B)
+                     for nome in ("extrator", "ls3", "puro_cv") for regua in ("loc50", "c3_50")}
+    diagnosticos = {}
