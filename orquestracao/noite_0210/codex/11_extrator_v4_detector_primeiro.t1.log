+            js = [min(js, key=lambda j: (macroclasse(caixas[j]["classe"]) == "imagem",
+                                        area(caixas[j]["bbox"]), -score_caixa(caixas[j]), j))]
+        for j in js:
+            grupos[j].append(i)
+    return grupos
