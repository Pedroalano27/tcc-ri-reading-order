+    folga: float = .5  # Alturas medianas de palavra, em pontos do PDF.
+    contencao: float = .98
+    par_classe: float = .5
+    detector: bool = True
+    ajuste: bool = True
+    orfas: bool = True
+    conflitos: bool = True
