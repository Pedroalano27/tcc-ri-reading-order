+ABLACOES = {"sem_a_detector": "detector", "sem_b_ajuste": "ajuste",
+            "sem_c_orfas": "orfas", "sem_d_conflitos": "conflitos",
+            "sem_e_texto": "texto", "sem_f_sem_texto": "sem_texto"}
