+                boxes = [{**b, "bbox": list(b["bbox"])} for b in c["dados"][base]["caixas"] if b.get("score",1) >= score]
+                ws_px = [{**w, "x0": w["x0"]*c["sx"], "x1": w["x1"]*c["sx"],
