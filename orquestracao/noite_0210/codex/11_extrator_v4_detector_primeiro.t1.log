+REGUAS = {"loc50": (None, .5), "loc75": (None, .75),
+          "c3_50": (3, .5), "c3_75": (3, .75),
+          "c16_50": (16, .5), "c16_75": (16, .75)}
+SEMENTE = 20261003
+
+
+@dataclass(frozen=True)
+class Config:
+    base: str = "uniao"
+    score: float = .25
+    folga: float = .5  # Alturas medianas de palavra, em pontos do PDF.
+    contencao: float = .98
+    par_classe: float = .5
+    detector: bool = True
+    ajuste: bool = True
+    orfas: bool = True
+    conflitos: bool = True
+    texto: bool = True
+    sem_texto: bool = True
