+def escrever_relatorio(r):
+    s = r["sistemas"]
+    principal = "v4_cv" if "v4_cv" in s else "v4_padrao"
+    f = lambda nome, regua="loc50": s[nome]["metricas"][regua]["f1"]
+    ganho, vs_puro = f(principal)-f("extrator"), f(principal)-f("ls3")
