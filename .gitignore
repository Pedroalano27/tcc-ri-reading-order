# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.env

# Modelos e Dados Grandes
data/raw/*
!data/raw/.gitkeep
models/*
!models/.gitkeep
*.pt
*.pth
*.bin
data/diagnostico_acervo.json

# Dados processados e artefatos de experimento (regeneraveis)
data/processed/
resultados/*.jsonl
resultados/**/*.jsonl
# predicoes de LLM rodadas no Kaggle custam horas de GPU: ficam versionadas
!resultados/kaggle/**/*.jsonl

# Golden Dataset: tarefas e anotacoes sao versionadas; as imagens se regeneram dos PDFs
data/golden/*/img/

# Pacotes gerados para upload no Kaggle
dist/

# Configuracao local do Claude Code (servidor de pre-visualizacao)
.claude/launch.json

# Logs dos despachos de agentes por linha de comando (saidas completas, regeneraveis)
orquestracao/logs/
